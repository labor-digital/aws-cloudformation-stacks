                  "sed -i 's/^upgrade_type = .*/upgrade_type = security/' /etc/dnf/automatic.conf\n",
                  "sed -i 's/^apply_updates = .*/apply_updates = yes/' /etc/dnf/automatic.conf\n",
                  "systemctl enable --now dnf-automatic.timer\n"
                ]
              ]
            }
          }
        }
