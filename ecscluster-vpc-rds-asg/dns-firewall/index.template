{
  "Parameters": {
    "ClusterStackName": {
      "Type": "String",
      "Description": "Name of the ECS cluster stack to attach the DNS Firewall to. Used to import the VPC ID via cross-stack reference.",
      "MinLength": "1"
    },
    "WhitelistDomains": {
      "Type": "CommaDelimitedList",
      "Description": "Comma-separated list of domains to allow through the DNS Firewall (e.g. *.eu-west-3.amazonaws.com,*.ec2.internal,api.doppler.com). Note: wildcards (*) only match a single subdomain level — *.example.com matches foo.example.com but NOT foo.bar.example.com. List must not be empty and must not contain trailing commas.",
      "Default": "*.in-addr.arpa"
    }
  },
  "Resources": {
    "DnsQueryLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Join": [
            "-",
            [
              {
                "Ref": "AWS::StackName"
              },
              "DnsFirewallLogs"
            ]
          ]
        },
        "RetentionInDays": 14
      }
    },
    "DnsFirewallWhitelistDomainList": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Name": {
          "Fn::Join": [
            "-",
            [
              {
                "Ref": "AWS::StackName"
              },
              "whitelist"
            ]
          ]
        },
        "Domains": {
          "Ref": "WhitelistDomains"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Join": [
                "-",
                [
                  {
                    "Ref": "AWS::StackName"
                  },
                  "dns-whitelist"
                ]
              ]
            }
          },
          {
            "Key": "security-owner",
            "Value": "network-sec"
          }
        ]
      }
    },
    "DnsFirewallCatchAllDomainList": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Name": {
          "Fn::Join": [
            "-",
            [
              {
                "Ref": "AWS::StackName"
              },
              "catch-all"
            ]
          ]
        },
        "Domains": [
          "*"
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Join": [
                "-",
                [
                  {
                    "Ref": "AWS::StackName"
                  },
                  "dns-catch-all"
                ]
              ]
            }
          },
          {
            "Key": "security-owner",
            "Value": "network-sec"
          }
        ]
      }
    },
    "DnsFirewallRuleGroup": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroup",
      "Properties": {
        "Name": {
          "Fn::Join": [
            "-",
            [
              {
                "Ref": "AWS::StackName"
              },
              "egress-control"
            ]
          ]
        },
        "FirewallRules": [
          {
            "Priority": 100,
            "FirewallDomainListId": {
              "Ref": "DnsFirewallWhitelistDomainList"
            },
            "Action": "ALLOW"
          },
          {
            "Priority": 200,
            "FirewallDomainListId": {
              "Ref": "DnsFirewallCatchAllDomainList"
            },
            "Action": "ALERT"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Join": [
                "-",
                [
                  {
                    "Ref": "AWS::StackName"
                  },
                  "egress-control"
                ]
              ]
            }
          },
          {
            "Key": "security-owner",
            "Value": "network-sec"
          }
        ]
      }
    },
    "DnsFirewallRuleGroupAssociation": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroupAssociation",
      "Properties": {
        "FirewallRuleGroupId": {
          "Ref": "DnsFirewallRuleGroup"
        },
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${ClusterStackName}-Vpc"
          }
        },
        "Priority": 200,
        "MutationProtection": "DISABLED",
        "Name": {
          "Fn::Join": [
            "-",
            [
              {
                "Ref": "AWS::StackName"
              },
              "vpc-association"
            ]
          ]
        },
        "Tags": [
          {
            "Key": "security-owner",
            "Value": "network-sec"
          }
        ]
      }
    },
    "DnsQueryLoggingConfig": {
      "Type": "AWS::Route53Resolver::ResolverQueryLoggingConfig",
      "Properties": {
        "Name": {
          "Fn::Join": [
            "-",
            [
              {
                "Ref": "AWS::StackName"
              },
              "dns-query-logging"
            ]
          ]
        },
        "DestinationArn": {
          "Fn::GetAtt": [
            "DnsQueryLogGroup",
            "Arn"
          ]
        }
      }
    },
    "DnsQueryLoggingConfigAssociation": {
      "Type": "AWS::Route53Resolver::ResolverQueryLoggingConfigAssociation",
      "Properties": {
        "ResolverQueryLogConfigId": {
          "Ref": "DnsQueryLoggingConfig"
        },
        "ResourceId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${ClusterStackName}-Vpc"
          }
        }
      }
    },
    "DnsFirewallAlertMetricFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "DependsOn": "DnsQueryLogGroup",
      "Properties": {
        "LogGroupName": {
          "Ref": "DnsQueryLogGroup"
        },
        "FilterPattern": "{ $.firewall_rule_action = \"ALERT\" }",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Join": [
                "/",
                [
                  {
                    "Ref": "AWS::StackName"
                  },
                  "DnsFirewall"
                ]
              ]
            },
            "MetricName": "AlertedQueries",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "DnsFirewallAlertAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {
          "Fn::Join": [
            "-",
            [
              {
                "Ref": "AWS::StackName"
              },
              "dns-firewall-alert-surge"
            ]
          ]
        },
        "AlarmDescription": "Unusual spike in DNS Firewall ALERT events - review DnsFirewallLogs for unexpected external service access",
        "Namespace": {
          "Fn::Join": [
            "/",
            [
              {
                "Ref": "AWS::StackName"
              },
              "DnsFirewall"
            ]
          ]
        },
        "MetricName": "AlertedQueries",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 100,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    }
  },
  "Outputs": {
    "DnsFirewallWhitelistId": {
      "Value": {
        "Ref": "DnsFirewallWhitelistDomainList"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-DnsFirewallWhitelistId"
        }
      }
    },
    "DnsFirewallRuleGroupId": {
      "Value": {
        "Ref": "DnsFirewallRuleGroup"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-DnsFirewallRuleGroupId"
        }
      }
    }
  }
}
