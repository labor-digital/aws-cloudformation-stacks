{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Shared ALB access logs bucket. One stack per cluster. Bucket is retained on stack deletion.",
  "Parameters": {
    "ClusterName": {
      "Type": "String",
      "MinLength": "4",
      "MaxLength": "64",
      "AllowedPattern": "[a-zA-Z0-9-]+",
      "ConstraintDescription": "Must contain only alphanumeric characters and hyphens.",
      "Description": "Name of the cluster stack this bucket belongs to (e.g. labc-eu-w3). The bucket will be named <ClusterName>-alb-logs. E.g.: labc-eu-w3-alb-logs"
    },
    "RetentionDays": {
      "Type": "Number",
      "Default": 14,
      "Description": "Days before log objects are permanently deleted. Set to match your DSGVO retention policy."
    }
  },
  "Resources": {
    "AlbLogsBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${ClusterName}-alb-logs"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteMultipartUploads",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              },
              "Status": "Enabled"
            },
            {
              "Id": "DeleteLogs",
              "ExpirationInDays": {
                "Ref": "RetentionDays"
              },
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 1
              },
              "Status": "Enabled"
            },
            {
              "Id": "CleanupDeleteMarkers",
              "ExpiredObjectDeleteMarker": true,
              "Status": "Enabled"
            }
          ]
        }
      }
    },
    "AlbLogsBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "AlbLogsBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "logdelivery.elasticloadbalancing.amazonaws.com"
              },
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${AlbLogsBucket.Arn}/*/AWSLogs/${AWS::AccountId}/*"
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Value": {
        "Ref": "AlbLogsBucket"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-BucketName"
        }
      }
    },
    "BucketArn": {
      "Value": {
        "Fn::GetAtt": [
          "AlbLogsBucket",
          "Arn"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-BucketArn"
        }
      }
    }
  }
}
