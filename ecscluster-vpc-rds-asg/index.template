    "AlertTopic": {
      "Type": "AWS::SNS::Topic",
      "Metadata": {
        "Note": "Single notification path for this cluster and every ecsservice stack, via the AlertTopicArn export. Alarms reference an ARN, never an address, so adding Slack or Opsgenie touches no alarm.\n\nDeliberately not KMS-encrypted: payloads carry metric names, thresholds and stack names only. If that changes, the key policy must also grant kms:GenerateDataKey* and kms:Decrypt to cloudwatch.amazonaws.com and events.amazonaws.com, or delivery stops silently."
      },
      "Properties": {
        "TopicName": {
          "Fn::Sub": "${AWS::StackName}-alerts"
        },
        "DisplayName": {
          "Fn::Sub": "${AWS::StackName} alerts"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Join": [
                "-",
                [
                  {
                    "Ref": "AWS::StackName"
                  },
                  "AlertTopic"
                ]
              ]
            }
          }
        ]
      }
    },
    "AlertEmailSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Condition": "AlertEmailProvided",
      "Metadata": {
        "Note": "A separate resource rather than an inline Subscription, so changing a recipient never touches the topic.\n\nStays PendingConfirmation until the recipient clicks the link; CloudFormation reports success either way."
      },
      "Properties": {
        "TopicArn": {
          "Ref": "AlertTopic"
        },
        "Protocol": "email",
        "Endpoint": {
          "Ref": "AlertEmail"
        }
      }
    },
    "AlertTopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Metadata": {
        "Note": "Replaces the default topic policy, so the owner statement has to be restated here.\n\nevents.amazonaws.com and cloudwatch.amazonaws.com cannot publish without their statements - the console adds them implicitly, CloudFormation does not, and the rule reports as configured while delivering nothing."
      },
      "Properties": {
        "Topics": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowOwnerAccountFullTopicAccess",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "AWS::AccountId"
                }
              },
              "Action": [
                "SNS:GetTopicAttributes",
                "SNS:SetTopicAttributes",
                "SNS:AddPermission",
                "SNS:RemovePermission",
                "SNS:DeleteTopic",
                "SNS:Subscribe",
                "SNS:ListSubscriptionsByTopic",
                "SNS:Publish"
              ],
              "Resource": {
                "Ref": "AlertTopic"
              }
            },
            {
              "Sid": "AllowCloudWatchAndEventBridgeToPublish",
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "cloudwatch.amazonaws.com",
                  "events.amazonaws.com"
                ]
              },
              "Action": "SNS:Publish",
              "Resource": {
                "Ref": "AlertTopic"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "DnsFirewallAlertMetricFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "DnsQueryLogGroup"
        },
        "FilterPattern": "{ $.firewall_rule_action = \"ALERT\" }",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "${AWS::StackName}/DnsFirewall"
            },
            "MetricName": "AlertedQueries",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "DnsFirewallBlockMetricFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Metadata": {
        "Note": "Counterpart to DnsFirewallAlertMetricFilter. The firewall writes ALERT while auditing, BLOCK once it enforces.\n\nA single filter on ALERT would stop counting at the moment enforcement begins, taking its alarm and the saved query silently to zero. Two metrics keep the distinction visible: ALERT means something resolved that the whitelist does not cover, BLOCK means it was refused."
      },
      "Properties": {
        "LogGroupName": {
          "Ref": "DnsQueryLogGroup"
        },
        "FilterPattern": "{ $.firewall_rule_action = \"BLOCK\" }",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "${AWS::StackName}/DnsFirewall"
            },
            "MetricName": "BlockedQueries",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "DnsFirewallWhitelistCandidatesQuery": {
      "Type": "AWS::Logs::QueryDefinition",
      "DependsOn": "DnsQueryLogGroup",
      "Properties": {
        "Name": "DnsFireWallLogsSummary",
        "QueryString": {
          "Fn::Sub": "SOURCE logGroups(logGroupName: \"${AWS::StackName}-DnsFirewallLogs\") START=-1209600s END=0s\n| fields query_name, query_type, srcaddr, firewall_rule_action\n| filter firewall_rule_action in [\"ALERT\", \"BLOCK\"]\n| filter query_type not in [\"PTR\"]\n| stats count(*) as requests by query_name, query_type, firewall_rule_action\n| sort requests desc\n| limit 500"
        }
      }
    },
    "DnsFirewallAlertAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "DnsFirewallAlarmEnabled",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-dns-firewall-alert-surge"
        },
        "ActionsEnabled": {
          "Fn::If": [
            "DnsFirewallAlarmAlerts",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "AlarmDescription": "Unusual VOLUME of DNS Firewall ALERT events on the catch-all rule - something is resolving far more uncovered domains than usual. This is a surge alarm, not a novelty detector: at the default of 100 per 5 minutes against measured traffic of about four alerts per hour, a single new domain appearing will never move it. Reviewing which names are new is a job for the DnsFireWallLogsSummary query. Once the catch-all is BLOCK, DnsFirewallBlockAlarm is the one that matters.",
        "Namespace": {
          "Fn::Sub": "${AWS::StackName}/DnsFirewall"
        },
        "MetricName": "AlertedQueries",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": {
          "Ref": "DnsFirewallAlarmThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "DnsFirewallBlockAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "DnsFirewallBlockAlarmEnabled",
      "Metadata": {
        "Note": "Period 300. Exists only while the catch-all blocks, so it can default to alert without changing a normal deploy. It closes a gap the surge alarm cannot: that one is dimensioned for volume and sits still while a single missing whitelist entry breaks image pulls.\n\nA blocked resolution does not disturb a running container, it breaks the next task placement - without this the failure surfaces only at the next deployment."
      },
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-dns-firewall-blocked"
        },
        "ActionsEnabled": {
          "Fn::If": [
            "DnsFirewallBlockAlarmAlerts",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "AlarmDescription": "A DNS query was refused by the DNS Firewall catch-all rule. Either something was stopped that should have been, or the whitelist is missing an entry - check DnsFirewallLogs for the query_name and the source address. Rolling back is a parameter update of DnsFirewallCatchAllAction to ALERT.",
        "Namespace": {
          "Fn::Sub": "${AWS::StackName}/DnsFirewall"
        },
        "MetricName": "BlockedQueries",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": {
          "Ref": "DnsFirewallBlockAlarmThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "VpcFlowLogsRejectedMetricFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "VpcFlowLogGroup"
        },
        "FilterPattern": "[version, account_id, interface_id, srcaddr, dstaddr, srcport, dstport, protocol, packets, bytes, start, end, action=REJECT, log_status, pkt_srcaddr, pkt_dstaddr, flow_direction]",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "${AWS::StackName}/VpcFlowLogs"
            },
            "MetricName": "RejectedConnections",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "VpcEgressBlockedMetricFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Condition": "EgressBlockedAlarmEnabled",
      "Metadata": {
        "Note": "Destinations inside the public subnets are excluded on purpose, since 2026-10-09. Those are not outbound attempts but replies to the load balancer whose connection tracking entry had expired - the closing FIN or RST then counts as a new outbound connection and is dropped by SgVpcLoadbalancerports.\n\nMeasured over four days: the class produces isolated events of two to six flows per hour, plus bursts of 150 to 180 whenever the autoscaling group replaces an instance. Six alarm mails in one night for a routine instance swap. A rate threshold cannot separate it: a burst caused by a healthy swap and one caused by an overloaded instance look the same, they differ only in the state of the instance - which this alarm does not measure. Instance health belongs in a CPU or agent alarm, not here.\n\nThe flow logs still contain the class; only the metric ignores it. Read it with the saved query and a destination filter: dstaddr like /^10\\.1\\.[12]\\./ for this class, not like /^10\\./ for real egress."
      },
      "Properties": {
        "LogGroupName": {
          "Ref": "VpcFlowLogGroup"
        },
        "FilterPattern": "[version, account_id, interface_id, srcaddr, dstaddr != 10.1.1.* && dstaddr != 10.1.2.*, srcport, dstport, protocol, packets, bytes, start, end, action=REJECT, log_status, pkt_srcaddr, pkt_dstaddr, flow_direction=egress]",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "${AWS::StackName}/VpcFlowLogs"
            },
            "MetricName": "EgressBlockedConnections",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "VpcFlowLogsRejectedAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "VpcFlowLogsAlarmEnabled",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-vpc-rejected-surge"
        },
        "ActionsEnabled": {
          "Fn::If": [
            "VpcFlowLogsAlarmAlerts",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "AlarmDescription": "Unusual spike in rejected VPC connections - potential port scan or misconfigured service. Review VpcFlowLogsRejectedTraffic Logs Insights query. Requires the threshold to be exceeded for 15 minutes straight (3 periods of 300s, DatapointsToAlarm 3): what distinguishes a real event from internet background scanning is not the height of the spike but how long it lasts. Measured in Frankfurt over three weeks in 2026-09: 34 firings on 15 days at EvaluationPeriods 1, nearly all lasting a single datapoint, against a baseline of 125-165 rejects per period. The two episodes worth knowing about ran 70 and 90 minutes.",
        "Namespace": {
          "Fn::Sub": "${AWS::StackName}/VpcFlowLogs"
        },
        "MetricName": "RejectedConnections",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 3,
        "DatapointsToAlarm": 3,
        "Threshold": {
          "Ref": "VpcFlowLogsAlarmThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "VpcEgressBlockedAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "EgressBlockedAlarmEnabled",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-egress-blocked"
        },
        "ActionsEnabled": {
          "Fn::If": [
            "EgressBlockedAlarmAlerts",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "AlarmDescription": "An outbound connection to a destination outside the public subnets was blocked by SgEgress. Replies to the load balancer are excluded from the metric - see the note on VpcEgressBlockedMetricFilter. Period is 60s and not 300s like the other alarms: at threshold 0 there is nothing to smooth out and every minute of delay is a minute a service is failing silently. Expect two to three minutes to the mail, most of it log delivery. To find out what was blocked, run the saved query VpcEgressBlockedTraffic - it groups by pkt_srcaddr, dstaddr and dstport, so it names the instance, the destination and the port in one go. Then decide: add the port to EgressExtraRules, or fix the caller.",
        "Namespace": {
          "Fn::Sub": "${AWS::StackName}/VpcFlowLogs"
        },
        "MetricName": "EgressBlockedConnections",
        "Statistic": "Sum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "DatapointsToAlarm": 1,
        "Threshold": {
          "Ref": "EgressBlockedAlarmThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "VpcFlowLogsRejectedTrafficQuery": {
      "Type": "AWS::Logs::QueryDefinition",
      "DependsOn": "VpcFlowLogGroup",
      "Properties": {
        "Name": "VpcFlowLogsRejectedTraffic",
        "QueryString": {
          "Fn::Sub": "SOURCE logGroups(logGroupName: \"${VpcFlowLogGroup}\") START=-3600s END=0s\n| fields @timestamp, @message\n| parse @message \"* * * * * * * * * * * * * * * * *\" as version, account, eni, srcaddr, dstaddr, srcport, dstport, protocol, packets, bytes, startTime, endTime, action, status, pkt_srcaddr, pkt_dstaddr, direction\n| filter action = \"REJECT\"\n| stats count(*) as rejects by pkt_srcaddr, dstaddr, dstport\n| sort rejects desc\n| limit 50"
        }
      }
    },
    "VpcEgressBlockedTrafficQuery": {
      "Type": "AWS::Logs::QueryDefinition",
      "Condition": "EgressBlockedAlarmEnabled",
      "Properties": {
        "Name": "VpcEgressBlockedTraffic",
        "QueryString": {
          "Fn::Sub": "SOURCE logGroups(logGroupName: \"${VpcFlowLogGroup}\") START=-3600s END=0s\n| fields @timestamp, @message\n| parse @message \"* * * * * * * * * * * * * * * * *\" as version, account, eni, srcaddr, dstaddr, srcport, dstport, protocol, packets, bytes, startTime, endTime, action, status, pkt_srcaddr, pkt_dstaddr, direction\n| filter action = \"REJECT\" and direction = \"egress\"\n| filter dstaddr not like /^10\\.1\\.[12]\\./\n| stats count(*) as blocked by pkt_srcaddr, dstaddr, dstport\n| sort blocked desc\n| limit 50"
        }
      }
    },
