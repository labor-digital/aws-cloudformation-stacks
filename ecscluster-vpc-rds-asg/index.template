      "Metadata": {
        "Note": "Ref on a LoadBalancer returns its ARN, so no import is needed now that the WebACL lives here.\n\nAn ALB carries only one WebACL - if one was attached by hand, this collides. Check with aws wafv2 get-web-acl-for-resource."
      }
    },
    "WafLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Metadata": {
        "Note": "The name must start with aws-waf-logs- or WAF refuses the logging configuration."
      },
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "aws-waf-logs-${AWS::StackName}-waf"
        },
        "RetentionInDays": 14
      }
    },
    "WafLogDeliveryPolicy": {
      "Type": "AWS::Logs::ResourcePolicy",
      "Metadata": {
        "Note": "WAF logging fails, or delivers nothing, unless the log group grants delivery.logs.amazonaws.com logs:CreateLogStream and logs:PutLogEvents. The console adds this implicitly, CloudFormation does not.\n\nScoped to the WAF log group of this stack with SourceAccount and SourceArn conditions, against the confused-deputy case. CloudWatch Logs resource policies are account-wide per region and capped at ten."
      },
      "DependsOn": [
        "WafLogGroup"
      ],
      "Properties": {
        "PolicyName": {
          "Fn::Sub": "${AWS::StackName}-waf-log-delivery"
        },
        "PolicyDocument": {
          "Fn::Sub": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"AWSLogDeliveryWrite\",\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"delivery.logs.amazonaws.com\"},\"Action\":[\"logs:CreateLogStream\",\"logs:PutLogEvents\"],\"Resource\":\"arn:aws:logs:${AWS::Region}:${AWS::AccountId}:log-group:aws-waf-logs-${AWS::StackName}-waf:log-stream:*\",\"Condition\":{\"StringEquals\":{\"aws:SourceAccount\":\"${AWS::AccountId}\"},\"ArnLike\":{\"aws:SourceArn\":\"arn:aws:logs:${AWS::Region}:${AWS::AccountId}:*\"}}}]}"
        }
      }
    },
    "WafLoggingConfiguration": {
      "Type": "AWS::WAFv2::LoggingConfiguration",
      "Metadata": {
        "Note": "LogDestinationConfigs takes the log group ARN WITHOUT the trailing :* that Fn::GetAtt returns, hence the constructed ARN.\n\nAuthorization headers and cookies are redacted: WAF logs the full request."
      },
      "DependsOn": [
        "WafLogGroup",
        "WafLogDeliveryPolicy"
      ],
      "Properties": {
        "ResourceArn": {
          "Fn::GetAtt": [
            "WafWebAcl",
            "Arn"
          ]
        },
        "LogDestinationConfigs": [
          {
            "Fn::Sub": "arn:aws:logs:${AWS::Region}:${AWS::AccountId}:log-group:aws-waf-logs-${AWS::StackName}-waf"
          }
        ],
        "RedactedFields": [
          {
            "SingleHeader": {
              "Name": "authorization"
            }
          },
          {
            "SingleHeader": {
              "Name": "cookie"
            }
          }
        ]
      }
    }
