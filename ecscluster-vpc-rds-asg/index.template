    "AlertTopic": {
      "Type": "AWS::SNS::Topic",
      "Metadata": {
        "Note": "Single notification path for the whole cluster: the four alarms below, every ecsservice stack's alarms (via the AlertTopicArn export), the GuardDuty findings rule and the Phase 3 Step D quarantine Lambda. Alarms reference an ARN, never an address, so delivery stays a subscription-level concern - adding Slack (AWS Chatbot) or Opsgenie later touches no alarm. Deliberately not KMS-encrypted: alarm payloads contain metric names, thresholds and stack names only, no personal data. If that ever changes, the key policy must also grant kms:GenerateDataKey*/kms:Decrypt to cloudwatch.amazonaws.com and events.amazonaws.com, otherwise delivery fails silently."
      },
      "Properties": {
        "TopicName": {
          "Fn::Sub": "${AWS::StackName}-alerts"
        },
        "DisplayName": {
          "Fn::Sub": "${AWS::StackName} alerts"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Join": [
                "-",
                [
                  {
                    "Ref": "AWS::StackName"
                  },
                  "AlertTopic"
                ]
              ]
            }
          }
        ]
      }
    },
    "AlertEmailSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Condition": "AlertEmailProvided",
      "Metadata": {
        "Note": "A separate resource rather than an inline Subscription on the topic, so adding or removing a recipient never touches the topic itself. Stays PendingConfirmation until the recipient clicks the link in the AWS e-mail; CloudFormation reports success either way."
      },
      "Properties": {
        "TopicArn": {
          "Ref": "AlertTopic"
        },
        "Protocol": "email",
        "Endpoint": {
          "Ref": "AlertEmail"
        }
      }
    },
    "AlertTopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Metadata": {
        "Note": "This resource replaces the default topic policy, so the owner statement has to be restated here. EventBridge (GuardDuty findings rule) cannot publish without the service statement - the console adds it implicitly, CloudFormation does not, and the rule then reports as configured while delivering nothing. cloudwatch.amazonaws.com is listed for the same reason."
      },
      "Properties": {
        "Topics": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowOwnerAccountFullTopicAccess",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "AWS::AccountId"
                }
              },
              "Action": [
                "SNS:GetTopicAttributes",
                "SNS:SetTopicAttributes",
                "SNS:AddPermission",
                "SNS:RemovePermission",
                "SNS:DeleteTopic",
                "SNS:Subscribe",
                "SNS:ListSubscriptionsByTopic",
                "SNS:Publish"
              ],
              "Resource": {
                "Ref": "AlertTopic"
              }
            },
            {
              "Sid": "AllowCloudWatchAndEventBridgeToPublish",
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "cloudwatch.amazonaws.com",
                  "events.amazonaws.com"
                ]
              },
              "Action": "SNS:Publish",
              "Resource": {
                "Ref": "AlertTopic"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "DnsFirewallAlertMetricFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "DnsQueryLogGroup"
        },
        "FilterPattern": "{ $.firewall_rule_action = \"ALERT\" }",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "${AWS::StackName}/DnsFirewall"
            },
            "MetricName": "AlertedQueries",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "DnsFirewallBlockMetricFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Metadata": {
        "Note": "Counterpart to DnsFirewallAlertMetricFilter. The firewall writes a different action into the log depending on the catch-all rule - ALERT while auditing, BLOCK once it enforces - so a single filter on ALERT stops counting at the exact moment enforcement begins, taking its alarm and the saved query silently to zero. Two metrics rather than one keeps the distinction visible: ALERT means something resolved that the whitelist does not cover, BLOCK means it was refused."
      },
      "Properties": {
        "LogGroupName": {
          "Ref": "DnsQueryLogGroup"
        },
        "FilterPattern": "{ $.firewall_rule_action = \"BLOCK\" }",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "${AWS::StackName}/DnsFirewall"
            },
            "MetricName": "BlockedQueries",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "DnsFirewallWhitelistCandidatesQuery": {
      "Type": "AWS::Logs::QueryDefinition",
      "DependsOn": "DnsQueryLogGroup",
      "Properties": {
        "Name": "DnsFireWallLogsSummary",
        "QueryString": {
          "Fn::Sub": "SOURCE logGroups(logGroupName: \"${AWS::StackName}-DnsFirewallLogs\") START=-1209600s END=0s\n| fields query_name, query_type, srcaddr, firewall_rule_action\n| filter firewall_rule_action in [\"ALERT\", \"BLOCK\"]\n| filter query_type not in [\"PTR\"]\n| stats count(*) as requests by query_name, query_type, firewall_rule_action\n| sort requests desc\n| limit 500"
        }
      }
    },
    "DnsFirewallAlertAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "DnsFirewallAlarmEnabled",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-dns-firewall-alert-surge"
        },
        "ActionsEnabled": {
          "Fn::If": [
            "DnsFirewallAlarmAlerts",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "AlarmDescription": "Unusual VOLUME of DNS Firewall ALERT events on the catch-all rule - something is resolving far more uncovered domains than usual. This is a surge alarm, not a novelty detector: at the default of 100 per 5 minutes against measured traffic of about four alerts per hour, a single new domain appearing will never move it. Reviewing which names are new is a job for the DnsFireWallLogsSummary query. Once the catch-all is BLOCK, DnsFirewallBlockAlarm is the one that matters.",
        "Namespace": {
          "Fn::Sub": "${AWS::StackName}/DnsFirewall"
        },
        "MetricName": "AlertedQueries",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": {
          "Ref": "DnsFirewallAlarmThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "DnsFirewallBlockAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "DnsFirewallBlockAlarmEnabled",
      "Metadata": {
        "Note": "Exists only while the catch-all blocks, which is why it can default to alert without changing anything on a normal deploy. It closes a gap the surge alarm cannot: that one is dimensioned for volume and would sit still while a single missing whitelist entry breaks image pulls. A blocked resolution does not disturb a running container, it breaks the next task placement - so without this the failure surfaces at the next deployment rather than when it starts."
      },
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-dns-firewall-blocked"
        },
        "ActionsEnabled": {
          "Fn::If": [
            "DnsFirewallBlockAlarmAlerts",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "AlarmDescription": "A DNS query was refused by the DNS Firewall catch-all rule. Either something was stopped that should have been, or the whitelist is missing an entry - check DnsFirewallLogs for the query_name and the source address. Rolling back is a parameter update of DnsFirewallCatchAllAction to ALERT.",
        "Namespace": {
          "Fn::Sub": "${AWS::StackName}/DnsFirewall"
        },
        "MetricName": "BlockedQueries",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": {
          "Ref": "DnsFirewallBlockAlarmThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "VpcFlowLogsRejectedMetricFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "VpcFlowLogGroup"
        },
        "FilterPattern": "[version, account_id, interface_id, srcaddr, dstaddr, srcport, dstport, protocol, packets, bytes, start, end, action=REJECT, log_status]",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "${AWS::StackName}/VpcFlowLogs"
            },
            "MetricName": "RejectedConnections",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "VpcFlowLogsRejectedAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "VpcFlowLogsAlarmEnabled",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-vpc-rejected-surge"
        },
        "ActionsEnabled": {
          "Fn::If": [
            "VpcFlowLogsAlarmAlerts",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "AlarmDescription": "Unusual spike in rejected VPC connections - potential port scan or misconfigured service. Review VpcFlowLogsRejectedTraffic Logs Insights query. Requires the threshold to be exceeded for 15 minutes straight (3 periods of 300s, DatapointsToAlarm 3): what distinguishes a real event from internet background scanning is not the height of the spike but how long it lasts. Measured in Frankfurt over three weeks in 2026-09: 34 firings on 15 days at EvaluationPeriods 1, nearly all lasting a single datapoint, against a baseline of 125-165 rejects per period. The two episodes worth knowing about ran 70 and 90 minutes.",
        "Namespace": {
          "Fn::Sub": "${AWS::StackName}/VpcFlowLogs"
        },
        "MetricName": "RejectedConnections",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 3,
        "DatapointsToAlarm": 3,
        "Threshold": {
          "Ref": "VpcFlowLogsAlarmThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "VpcFlowLogsRejectedTrafficQuery": {
      "Type": "AWS::Logs::QueryDefinition",
      "DependsOn": "VpcFlowLogGroup",
      "Properties": {
        "Name": "VpcFlowLogsRejectedTraffic",
        "QueryString": {
          "Fn::Sub": "SOURCE logGroups(logGroupName: \"${VpcFlowLogGroup}\") START=-3600s END=0s\n| fields @timestamp, @message\n| parse @message \"* * * * * * * * * * * * * *\" as version, account, eni, srcaddr, dstaddr, srcport, dstport, protocol, packets, bytes, startTime, endTime, action, status\n| filter action = \"REJECT\"\n| stats count(*) as rejects by srcaddr, dstport\n| sort rejects desc\n| limit 50"
        }
      }
    },
