    "ImageRegressionGuardLogGroup" : {
      "Type" : "AWS::Logs::LogGroup",
      "Condition" : "EnableImageRegressionGuard",
      "Properties" : {
        "LogGroupName" : { "Fn::Join" : [ "", [ "/aws/lambda/", { "Ref" : "AWS::StackName" }, "-ImageRegressionGuard" ] ] },
        "RetentionInDays" : 14
      }
    },
    "ImageRegressionGuardFunction" : {
      "Type" : "AWS::Lambda::Function",
      "Condition" : "EnableImageRegressionGuard",
      "Metadata" : {
        "Note" : "Detective control for image regressions. EventBridge invokes it on every ECS deployment start (SERVICE_DEPLOYMENT_IN_PROGRESS). It reads the currently rolling-out image (PRIMARY deployment) and the one it is replacing (ACTIVE deployment), looks up each image's ECR push time, and publishes to the cluster AlertTopic when the incoming image is OLDER than the outgoing one - catching both a CloudFormation parameter update that reverted the task image and an accidental redeploy of an old build. Deploying the same or a newer image is silent. Detective, not preventive: it fires as the rollout begins, so it complements the deployment circuit breaker rather than replacing it."
      },
      "Properties" : {
        "FunctionName" : { "Fn::Join" : [ "-", [ { "Ref" : "AWS::StackName" }, "ImageRegressionGuard" ] ] },
        "Runtime" : "python3.12",
        "Handler" : "index.handler",
        "Role" : { "Fn::GetAtt" : [ "ImageRegressionGuardRole", "Arn" ] },
        "Timeout" : 30,
        "MemorySize" : 256,
        "Environment" : {
          "Variables" : {
            "CLUSTER" : { "Fn::ImportValue" : { "Fn::Sub" : "${ClusterStackName}-Ecscluster" } },
            "SERVICE" : { "Fn::Join" : [ "-", [ { "Ref" : "AWS::StackName" }, "Service" ] ] },
            "TOPIC_ARN" : { "Fn::ImportValue" : { "Fn::Sub" : "${ClusterStackName}-AlertTopicArn" } }
          }
        },
        "Code" : {
          "ZipFile" : "import os, boto3\n\n_clients = {}\n\ndef parse_ref(image):\n    \"\"\"Zerlegt eine Image-Referenz in Registry-Host, Repository, Tag und Digest.\"\"\"\n    ref = image\n    digest = None\n    tag = None\n    host = None\n    if '@' in ref:\n        ref, digest = ref.split('@', 1)\n    path = ref\n    if '/' in path:\n        h, rest = path.split('/', 1)\n        if '.' in h or ':' in h:\n            host = h\n            path = rest\n    if digest is None and ':' in path:\n        path, tag = path.rsplit(':', 1)\n    return host, path, tag, digest\n\ndef ecr_for(host):\n    \"\"\"ECR-Client fuer die Region des Registry-Hosts. Die Lambda laeuft in der Cluster-Region,\n    die Repositories koennen in einer anderen liegen - <acct>.dkr.ecr.<region>.amazonaws.com.\n    Nicht-ECR-Referenzen (z.B. Docker Hub) liefern None und werden uebersprungen.\"\"\"\n    if not host or '.dkr.ecr.' not in host:\n        return None, None\n    parts = host.split('.')\n    region, registry = parts[3], parts[0]\n    if region not in _clients:\n        _clients[region] = boto3.client('ecr', region_name=region)\n    return _clients[region], registry\n\ndef pushed_at(image):\n    host, repo, tag, digest = parse_ref(image)\n    ecr, registry = ecr_for(host)\n    if ecr is None:\n        return None\n    image_id = {}\n    if digest:\n        image_id['imageDigest'] = digest\n    elif tag:\n        image_id['imageTag'] = tag\n    else:\n        return None\n    resp = ecr.describe_images(registryId=registry, repositoryName=repo, imageIds=[image_id])\n    details = resp.get('imageDetails', [])\n    return details[0]['imagePushedAt'] if details else None\n\ndef image_of(ecs, arn):\n    td = ecs.describe_task_definition(taskDefinition=arn)\n    return td['taskDefinition']['containerDefinitions'][0]['image']\n\ndef handler(event, context):\n    cluster = os.environ['CLUSTER']\n    service = os.environ['SERVICE']\n    topic = os.environ['TOPIC_ARN']\n    ecs = boto3.client('ecs')\n    svc = ecs.describe_services(cluster=cluster, services=[service])\n    if not svc['services']:\n        print('Service ' + service + ' not found in cluster ' + cluster)\n        return\n    deployments = svc['services'][0].get('deployments', [])\n    primary = next((d for d in deployments if d.get('status') == 'PRIMARY'), None)\n    active = next((d for d in deployments if d.get('status') == 'ACTIVE'), None)\n    if not primary or not active:\n        print('No previous deployment to compare against; skipping.')\n        return\n    new_image = image_of(ecs, primary['taskDefinition'])\n    prev_image = image_of(ecs, active['taskDefinition'])\n    if new_image == prev_image:\n        print('Same image redeployed; no regression.')\n        return\n    try:\n        new_pushed = pushed_at(new_image)\n        prev_pushed = pushed_at(prev_image)\n    except Exception as e:\n        print('Could not resolve ECR push times: ' + str(e) + '; skipping.')\n        return\n    if new_pushed is None or prev_pushed is None:\n        print('Push time unavailable for one image (non-ECR registry or missing tag); skipping.')\n        return\n    if new_pushed >= prev_pushed:\n        print('Incoming image is same-age or newer; no regression.')\n        return\n    msg = 'Image regression on ECS service ' + service + ' (cluster ' + cluster + ').\\n\\n'\n    msg += 'The rolling deployment uses an image OLDER than the one it replaces.\\n\\n'\n    msg += 'Incoming image: ' + new_image + ' (pushed ' + new_pushed.isoformat() + ')\\n'\n    msg += 'Previous image: ' + prev_image + ' (pushed ' + prev_pushed.isoformat() + ')\\n\\n'\n    msg += 'Likely a stale deploy: a CloudFormation parameter update that reverted the task image, or an accidental redeploy of an old build. Investigate before the rollout completes.'\n    boto3.client('sns').publish(TopicArn=topic, Subject=('ECS image regression: ' + service)[:100], Message=msg)\n    print('Regression alarm published.')\n"
        }
      }
    },
