    "Launchtemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateData": {
          "NetworkInterfaces": [
            {
              "DeviceIndex": 0,
              "AssociatePublicIpAddress": false,
              "Groups": [
                {
                  "Ref": "SgVpcMysqlAccess"
                },
                {
                  "Ref": "SgVpcLoadbalancerports"
                },
                {
                  "Ref": "SgVpcEfsAccess"
                },
                {
