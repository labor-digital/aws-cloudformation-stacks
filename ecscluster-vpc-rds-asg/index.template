    "VpcEgressPortsQuery": {
      "Type": "AWS::Logs::QueryDefinition",
      "Condition": "EgressAnalysisEnabled",
      "DependsOn": "VpcAcceptFlowLogGroup",
      "Properties": {
        "Name": "VpcEgressPortsAnalysis",
        "QueryString": {
          "Fn::Sub": "SOURCE logGroups(logGroupName: \"${VpcAcceptFlowLogGroup}\") START=-604800s END=0s\n| fields @timestamp, @message\n| parse @message \"* * * * * * * * * * * * * *\" as version, account, eni, srcaddr, dstaddr, srcport, dstport, protocol, packets, bytes, startTime, endTime, action, status\n| filter action = \"ACCEPT\"\n| filter srcaddr like /^10\\.1\\.[34]\\./\n| filter dstaddr not like /^10\\./\n| filter srcport != 443 and srcport != 80\n| stats count(*) as connections, sum(bytes) as totalBytes by dstport, protocol\n| sort connections desc\n| limit 500"
        }
      }
    },
