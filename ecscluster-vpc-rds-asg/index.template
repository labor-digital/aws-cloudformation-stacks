        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-AlarmWafBlockedSurge"
        },
        "AlarmDescription": "Surge in requests blocked by the ALB WebACL - either an attack in progress or a rule producing false positives. Compare the per-rule metrics to tell them apart.",
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
