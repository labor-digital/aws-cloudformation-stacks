                    "Ref": "AWS::StackName"
                  },
                  "Rdscl"
                ]
              ]
            }
          }
        ],
        "StorageEncrypted": true,
        "VpcSecurityGroupIds": [
          {
            "Ref": "SgVpcMysql"
          },
          {
            "Ref": "SgLaborMysql"
          }
        ]
      },
      "DependsOn": [
        "RdsclParameterGroup",
        "RdsclSubnetgroup",
        "SgVpcMysql"
      ]
    },
