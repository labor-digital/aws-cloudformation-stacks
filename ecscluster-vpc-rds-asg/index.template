                "Ref": "AWS::StackName"
              },
              "Loadbalancer"
            ]
          ]
        },
        "Scheme": "internet-facing",
        "SecurityGroups": [
          {
            "Ref": "SgVpcLoadbalancerportsAccess"
          },
          {
            "Ref": "SgPublicHttpHttps"
          }
        ],
        "Subnets": [
          {
            "Ref": "Subnet1"
          },
          {
            "Ref": "Subnet2"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Join": [
