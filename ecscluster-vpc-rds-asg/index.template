                  "Ref": "LogsBucketName"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "AccessLogsEnabled",
              {
                "Key": "access_logs.s3.prefix",
                "Value": {
                  "Ref": "AWS::StackName"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Key": "routing.http2.enabled",
            "Value": "true"
          }
        ],
        "Name": {
          "Fn::Join": [
            "-",
            [
