    "WafWebAclAssociation": {
      "Type": "AWS::WAFv2::WebACLAssociation",
      "Properties": {
        "ResourceArn": {
          "Ref": "Loadbalancer"
        },
        "WebACLArn": {
          "Fn::GetAtt": [
            "WafWebAcl",
            "Arn"
