    "WafWebAcl": {
      "Type": "AWS::WAFv2::WebACL",
      "Metadata": {
        "Note": "Scope REGIONAL, so this is created in the cluster's own region and attaches directly to the ALB - unlike the CLOUDFRONT-scoped WebACL in cloudfront-alb-distribution, which only exists in us-east-1 and only inspects traffic that actually travels through CloudFront. Rule order is deliberate: IP reputation first (cheapest rejection), then generic managed groups, then application-specific rules, then rate limiting last so that legitimate-looking floods are still classified by the groups above. Every rule carries its own off/count/block parameter: a single global switch would force promoting all rules at once, which defeats the point of a counting period. Rule set deliberately trimmed 2026-08-20: the PHP group (overlaps Common and WordPress), the IP reputation group (always evaluates the source IP, so it sees only Cloudflare for proxied sites and Cloudflare does reputation itself), the admin-path IP restriction (clients edit their own content, and it cannot serve a mixed proxied/direct estate) and the two CVE-specific WordPress rules were all removed - see TASKS.md. What is left is generic: broad signatures, virtual patching, SQLi, WordPress, and rate limiting. Where a CDN fronts the ALB, set WafClientIpHeader (Cloudflare: cf-connecting-ip); without it proxied requests all aggregate onto the proxy's addresses and blocking on rate would take the proxy out for every site behind it."
      },
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-waf"
        },
        "Scope": "REGIONAL",
        "DefaultAction": {
          "Allow": {}
        },
        "Description": {
          "Fn::Sub": "WAF for the ${AWS::StackName} ALB"
        },
        "VisibilityConfig": {
          "SampledRequestsEnabled": true,
          "CloudWatchMetricsEnabled": true,
          "MetricName": "AlbWebAcl"
        },
        "Rules": [
          {
            "Fn::If": [
              "CommonRuleSetActionEnabled",
              {
                "Name": "AWSManagedRulesCommonRuleSet",
                "Priority": 20,
                "OverrideAction": {
                  "Fn::If": [
                    "CommonRuleSetActionCounts",
                    {
                      "Count": {}
                    },
                    {
                      "None": {}
                    }
                  ]
                },
                "Statement": {
                  "ManagedRuleGroupStatement": {
                    "VendorName": "AWS",
                    "Name": "AWSManagedRulesCommonRuleSet"
                  }
                },
                "VisibilityConfig": {
                  "SampledRequestsEnabled": true,
                  "CloudWatchMetricsEnabled": true,
                  "MetricName": "AWSManagedRulesCommonRuleSet"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "KnownBadInputsActionEnabled",
              {
                "Name": "AWSManagedRulesKnownBadInputsRuleSet",
                "Priority": 30,
                "OverrideAction": {
                  "Fn::If": [
                    "KnownBadInputsActionCounts",
                    {
                      "Count": {}
                    },
                    {
                      "None": {}
                    }
                  ]
                },
                "Statement": {
                  "ManagedRuleGroupStatement": {
                    "VendorName": "AWS",
                    "Name": "AWSManagedRulesKnownBadInputsRuleSet"
                  }
                },
                "VisibilityConfig": {
                  "SampledRequestsEnabled": true,
                  "CloudWatchMetricsEnabled": true,
                  "MetricName": "AWSManagedRulesKnownBadInputsRuleSet"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "SqliRuleSetActionEnabled",
              {
                "Name": "AWSManagedRulesSQLiRuleSet",
                "Priority": 40,
                "OverrideAction": {
                  "Fn::If": [
                    "SqliRuleSetActionCounts",
                    {
                      "Count": {}
                    },
                    {
                      "None": {}
                    }
                  ]
                },
                "Statement": {
                  "ManagedRuleGroupStatement": {
                    "VendorName": "AWS",
                    "Name": "AWSManagedRulesSQLiRuleSet"
                  }
                },
                "VisibilityConfig": {
                  "SampledRequestsEnabled": true,
                  "CloudWatchMetricsEnabled": true,
                  "MetricName": "AWSManagedRulesSQLiRuleSet"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "WordPressRulesActionEnabled",
              {
                "Name": "AWSManagedRulesWordPressRuleSet",
                "Priority": 50,
                "OverrideAction": {
                  "Fn::If": [
                    "WordPressRulesActionCounts",
                    {
                      "Count": {}
                    },
                    {
                      "None": {}
                    }
                  ]
                },
                "Statement": {
                  "ManagedRuleGroupStatement": {
                    "VendorName": "AWS",
                    "Name": "AWSManagedRulesWordPressRuleSet"
                  }
                },
                "VisibilityConfig": {
                  "SampledRequestsEnabled": true,
                  "CloudWatchMetricsEnabled": true,
                  "MetricName": "AWSManagedRulesWordPressRuleSet"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "RateLimitActionEnabledAndForwardedIp",
              {
                "Name": "RateLimitForwardedIp",
                "Priority": 90,
                "Action": {
                  "Fn::If": [
                    "RateLimitActionCounts",
                    {
                      "Count": {}
                    },
                    {
                      "Block": {}
                    }
                  ]
                },
                "Statement": {
                  "RateBasedStatement": {
                    "Limit": {
                      "Ref": "WafRateLimitRequests"
                    },
                    "AggregateKeyType": "FORWARDED_IP",
                    "ForwardedIPConfig": {
                      "HeaderName": {
                        "Ref": "WafClientIpHeader"
                      },
                      "FallbackBehavior": "NO_MATCH"
                    },
                    "ScopeDownStatement": {
                      "SizeConstraintStatement": {
                        "FieldToMatch": {
                          "SingleHeader": {
                            "Name": {
                              "Ref": "WafClientIpHeader"
                            }
                          }
                        },
                        "ComparisonOperator": "GT",
                        "Size": 0,
                        "TextTransformations": [
                          {
                            "Priority": 0,
                            "Type": "NONE"
                          }
                        ]
                      }
                    }
                  }
                },
                "VisibilityConfig": {
                  "SampledRequestsEnabled": true,
                  "CloudWatchMetricsEnabled": true,
                  "MetricName": "RateLimitForwardedIp"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "RateLimitActionEnabled",
              {
                "Name": "RateLimitSourceIp",
                "Priority": 91,
                "Action": {
                  "Fn::If": [
                    "RateLimitActionCounts",
                    {
                      "Count": {}
                    },
                    {
                      "Block": {}
                    }
                  ]
                },
                "Statement": {
                  "RateBasedStatement": {
                    "Limit": {
                      "Ref": "WafRateLimitRequests"
                    },
                    "AggregateKeyType": "IP",
                    "ScopeDownStatement": {
                      "Fn::If": [
                        "WafForwardedIpInUse",
                        {
                          "NotStatement": {
                            "Statement": {
                              "SizeConstraintStatement": {
                                "FieldToMatch": {
                                  "SingleHeader": {
                                    "Name": {
                                      "Ref": "WafClientIpHeader"
                                    }
                                  }
                                },
                                "ComparisonOperator": "GT",
                                "Size": 0,
                                "TextTransformations": [
                                  {
                                    "Priority": 0,
                                    "Type": "NONE"
                                  }
                                ]
                              }
                            }
                          }
                        },
                        {
                          "Ref": "AWS::NoValue"
                        }
                      ]
                    }
                  }
                },
                "VisibilityConfig": {
                  "SampledRequestsEnabled": true,
                  "CloudWatchMetricsEnabled": true,
                  "MetricName": "RateLimitSourceIp"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        ]
      }
    },
    "WafWebAclAssociation": {
      "Type": "AWS::WAFv2::WebACLAssociation",
      "Properties": {
        "ResourceArn": {
          "Ref": "Loadbalancer"
        },
        "WebACLArn": {
          "Fn::GetAtt": [
            "WafWebAcl",
            "Arn"
          ]
        }
      },
      "Metadata": {
        "Note": "Ref on an AWS::ElasticLoadBalancingV2::LoadBalancer returns its ARN, so no import is needed now that the WebACL lives in the cluster template. An ALB can carry only one WebACL - if one was ever attached by hand, this association collides; check with aws wafv2 get-web-acl-for-resource."
      }
    },
    "WafLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Metadata": {
        "Note": "The name must start with aws-waf-logs- or WAF refuses the logging configuration."
      },
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "aws-waf-logs-${AWS::StackName}-waf"
        },
        "RetentionInDays": {
          "Ref": "WafLogRetentionDays"
        }
      }
    },
    "WafLogDeliveryPolicy": {
      "Type": "AWS::Logs::ResourcePolicy",
      "Metadata": {
        "Note": "Required for WAF logging and easy to miss: PutLoggingConfiguration fails, or delivers nothing, unless the log group grants delivery.logs.amazonaws.com logs:CreateLogStream and logs:PutLogEvents. The console adds this policy implicitly; CloudFormation does not. Scoped to this stack's WAF log group only, with SourceAccount/SourceArn conditions against the confused-deputy case. Note CloudWatch Logs resource policies are account-wide per region and capped (10 per region), so one per cluster is fine but do not fan these out casually."
      },
      "DependsOn": [
        "WafLogGroup"
      ],
      "Properties": {
        "PolicyName": {
          "Fn::Sub": "${AWS::StackName}-waf-log-delivery"
        },
        "PolicyDocument": {
          "Fn::Sub": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"AWSLogDeliveryWrite\",\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"delivery.logs.amazonaws.com\"},\"Action\":[\"logs:CreateLogStream\",\"logs:PutLogEvents\"],\"Resource\":\"arn:aws:logs:${AWS::Region}:${AWS::AccountId}:log-group:aws-waf-logs-${AWS::StackName}-waf:log-stream:*\",\"Condition\":{\"StringEquals\":{\"aws:SourceAccount\":\"${AWS::AccountId}\"},\"ArnLike\":{\"aws:SourceArn\":\"arn:aws:logs:${AWS::Region}:${AWS::AccountId}:*\"}}}]}"
        }
      }
    },
    "WafLoggingConfiguration": {
      "Type": "AWS::WAFv2::LoggingConfiguration",
      "Metadata": {
        "Note": "LogDestinationConfigs takes the log group ARN WITHOUT the trailing :* that Fn::GetAtt returns, hence the constructed ARN. Authorization headers and cookies are redacted: WAF logs the full request, and those carry session tokens and credentials."
      },
      "DependsOn": [
        "WafLogGroup",
        "WafLogDeliveryPolicy"
      ],
      "Properties": {
        "ResourceArn": {
          "Fn::GetAtt": [
            "WafWebAcl",
            "Arn"
          ]
        },
        "LogDestinationConfigs": [
          {
            "Fn::Sub": "arn:aws:logs:${AWS::Region}:${AWS::AccountId}:log-group:aws-waf-logs-${AWS::StackName}-waf"
          }
        ],
        "RedactedFields": [
          {
            "SingleHeader": {
              "Name": "authorization"
            }
          },
          {
            "SingleHeader": {
              "Name": "cookie"
            }
          }
        ]
      }
    },
    "WafBlockedRequestAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "WafBlockedRequestAlarmEnabled",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-AlarmWafBlockedSurge"
        },
        "AlarmDescription": "Surge in requests blocked by the ALB WebACL - either an attack in progress or a rule producing false positives. Compare the per-rule metrics to tell them apart.",
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "Namespace": "AWS/WAFV2",
        "MetricName": "BlockedRequests",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": {
          "Ref": "WafBlockedRequestAlarmThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "WebACL",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-waf"
            }
          },
          {
            "Name": "Region",
            "Value": {
              "Ref": "AWS::Region"
            }
          },
          {
            "Name": "Rule",
            "Value": "ALL"
          }
        ],
        "TreatMissingData": "notBreaching"
      }
    }
  },
