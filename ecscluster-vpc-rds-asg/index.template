    "InternalLoadbalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Metadata": {
        "Note": "Private entry point for service-to-service traffic that has no business on the public ALB - Solr first. Lives here rather than in its own stack because it is cluster-level singleton infrastructure, the sibling of Loadbalancer, and because SgInternalAlb can only reference SgVpcLoadbalancerports from inside this stack. HTTP only: the backends behind it speak plain HTTP, so terminating TLS inside the VPC would add nothing. deletion_protection is deliberately NOT enabled - it would block a CloudFormation rollback while this is new. Turn it on once the internal path is proven."
      },
      "Properties": {
        "LoadBalancerAttributes": [
          {
            "Key": "idle_timeout.timeout_seconds",
            "Value": "60"
          },
          {
            "Key": "routing.http2.enabled",
            "Value": "true"
          }
        ],
        "Name": {
          "Fn::Join": [
            "-",
            [
              {
                "Ref": "AWS::StackName"
              },
              "InternalLb"
            ]
          ]
        },
        "Scheme": "internal",
        "SecurityGroups": [
          {
            "Ref": "SgInternalAlb"
          },
          {
            "Ref": "SgVpcLoadbalancerportsAccess"
          }
        ],
        "Subnets": [
          {
            "Ref": "SubnetPrivate1"
          },
          {
            "Ref": "SubnetPrivate2"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Join": [
                "-",
                [
                  {
                    "Ref": "AWS::StackName"
                  },
                  "InternalLb"
                ]
              ]
            }
          }
        ],
        "Type": "application",
        "IpAddressType": "ipv4"
      },
      "DependsOn": [
        "SgInternalAlb",
        "SgVpcLoadbalancerportsAccess",
        "SubnetPrivate1",
        "SubnetPrivate2"
      ]
    },
    "InternalHttplistener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Metadata": {
        "Note": "Default action is a fixed 404, not a forward to a catch-all target group: a request that matches no service rule must not reach anything. Services attach to this listener by passing its ARN as ListenerArnOverride in ecsservice."
      },
      "Properties": {
        "DefaultActions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "404",
              "ContentType": "text/plain",
              "MessageBody": "No internal route matched."
            }
          }
        ],
        "LoadBalancerArn": {
          "Ref": "InternalLoadbalancer"
        },
        "Port": 80,
