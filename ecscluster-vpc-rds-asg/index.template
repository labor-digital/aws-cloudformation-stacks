    "WafAdminIpSet": {
      "Type": "AWS::WAFv2::IPSet",
      "Condition": "WafAdminCidrsProvided",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-waf-admin-allow"
        },
        "Scope": "REGIONAL",
