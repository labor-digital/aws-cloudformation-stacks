        },
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "RdsConnectionsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "RdsConnectionsAlarmEnabled",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-rds-connections"
        },
        "ActionsEnabled": {
          "Fn::If": [
            "RdsConnectionsAlarmAlerts",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "AlarmDescription": {
          "Fn::Sub": "More than ${RdsConnectionsAlarmThreshold} open database connections in a 5-minute window. The whole cluster shares one max_connections budget, so this is an estate-wide warning: once it is exhausted every service returns 500 at once. Correlate with DatabaseConnections per minute and with the service logs of whichever stack is holding them."
        },
        "Namespace": "AWS/RDS",
        "MetricName": "DatabaseConnections",
        "Dimensions": [
          {
            "Name": "DBInstanceIdentifier",
            "Value": {
              "Fn::Join": [
                "-",
                [
                  {
                    "Ref": "AWS::StackName"
                  },
                  "Rdsinstance1"
                ]
              ]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": {
          "Ref": "RdsConnectionsAlarmThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      },
      "Metadata": {
        "Note": "Statistic is Maximum, not Sum. DatabaseConnections is a gauge - the count of connections open at that moment - so summing the datapoints of a period produces a meaningless multiple of the real figure. Dimensioned on the writer instance, because that is where max_connections applies and where exhaustion surfaces. AWS/RDS is the AWS-published namespace, unlike the RdsError and RdsSlowQuery alarms above, which read metric filters this stack creates over the exported logs."
      }
    },
    "ElbHttp5xxAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "ElbHttp5xxAlarmEnabled",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-elb-5xx"
        },
        "ActionsEnabled": {
          "Fn::If": [
            "ElbHttp5xxAlarmAlerts",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "AlarmDescription": {
          "Fn::Sub": "More than ${ElbHttp5xxAlarmThreshold} load-balancer-generated 5xx in 5 minutes: 503 no healthy target, 502 malformed or aborted response, 504 target timeout. This is what a visitor sees when a service stops answering, and it is invisible to the per-service target-5xx alarms. Cluster-wide - correlate with HTTPCode_Target_5XX_Count and UnHealthyHostCount per target group to find the service."
        },
        "Namespace": "AWS/ApplicationELB",
        "MetricName": "HTTPCode_ELB_5XX_Count",
        "Dimensions": [
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::Select": [
                1,
                {
                  "Fn::Split": [
                    "loadbalancer/",
                    {
                      "Ref": "Loadbalancer"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": {
          "Ref": "ElbHttp5xxAlarmThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      },
      "Metadata": {
        "Note": "HTTPCode_ELB_5XX_Count is emitted with the LoadBalancer and AvailabilityZone dimensions only - there is no TargetGroup dimension, which is why this cannot live in ecsservice next to AlarmHttp5xxTarget. Verify with: aws cloudwatch list-metrics --namespace AWS/ApplicationELB --metric-name HTTPCode_ELB_5XX_Count. Counts 502, 503 and 504 the balancer produced itself; a 5xx the container returned is HTTPCode_Target_5XX_Count and belongs to the service stack."
      }
    },
    "RdsSlowQuerySummaryQuery": {
      "Type": "AWS::Logs::QueryDefinition",
      "DependsOn": "RdsSlowQueryLogGroup",
      "Properties": {
        "Name": "RdsSlowQuerySummary",
        "QueryString": {
          "Fn::Sub": "SOURCE logGroups(logGroupName: \"${RdsSlowQueryLogGroup}\") START=-86400s END=0s\n| fields @timestamp, @message\n| filter @message like /# Query_time/\n| parse @message \"# Query_time: * Lock_time: * Rows_sent: * Rows_examined: *\" as query_time, lock_time, rows_sent, rows_examined\n| sort query_time desc\n| limit 50"
        }
      }
    },
    "ClusterDashboard": {
      "Type": "AWS::CloudWatch::Dashboard",
      "Properties": {
        "DashboardName": {
          "Fn::Sub": "${AWS::StackName}-Overview"
        },
        "DashboardBody": {
          "Fn::Sub": "{\"start\":\"-PT3H\",\"widgets\":[{\"type\":\"metric\",\"x\":0,\"y\":0,\"width\":12,\"height\":6,\"properties\":{\"title\":\"ECS CPU by Service\",\"view\":\"timeSeries\",\"stacked\":false,\"metrics\":[[{\"expression\":\"SEARCH('{AWS/ECS,ClusterName,ServiceName} ClusterName=\\\"${AWS::StackName}-Ecscluster\\\" MetricName=\\\"CPUUtilization\\\"','Average',300)\",\"label\":\"${!LABEL}\",\"id\":\"cpu\"}]],\"period\":300,\"stat\":\"Average\",\"region\":\"${AWS::Region}\",\"yAxis\":{\"left\":{\"min\":0,\"max\":100}}}},{\"type\":\"metric\",\"x\":12,\"y\":0,\"width\":12,\"height\":6,\"properties\":{\"title\":\"ECS Memory by Service\",\"view\":\"timeSeries\",\"stacked\":false,\"metrics\":[[{\"expression\":\"SEARCH('{AWS/ECS,ClusterName,ServiceName} ClusterName=\\\"${AWS::StackName}-Ecscluster\\\" MetricName=\\\"MemoryUtilization\\\"','Average',300)\",\"label\":\"${!LABEL}\",\"id\":\"mem\"}]],\"period\":300,\"stat\":\"Average\",\"region\":\"${AWS::Region}\",\"yAxis\":{\"left\":{\"min\":0,\"max\":100}}}},{\"type\":\"metric\",\"x\":0,\"y\":6,\"width\":12,\"height\":6,\"properties\":{\"title\":\"RDS CPU & Connections\",\"view\":\"timeSeries\",\"stacked\":false,\"metrics\":[[\"AWS/RDS\",\"CPUUtilization\",\"DBClusterIdentifier\",\"${Rdscl}\",{\"stat\":\"Average\",\"label\":\"CPU %\"}],[\"AWS/RDS\",\"DatabaseConnections\",\"DBClusterIdentifier\",\"${Rdscl}\",{\"stat\":\"Average\",\"label\":\"Connections\",\"yAxis\":\"right\"}]],\"period\":300,\"region\":\"${AWS::Region}\",\"yAxis\":{\"left\":{\"min\":0,\"max\":100,\"label\":\"CPU %\"},\"right\":{\"min\":0,\"label\":\"Connections\"}},\"annotations\":{\"horizontal\":[{\"label\":\"rds-connections alarm\",\"value\":60,\"yAxis\":\"right\"}]}}},{\"type\":\"metric\",\"x\":12,\"y\":6,\"width\":12,\"height\":6,\"properties\":{\"title\":\"VPC Rejected Connections\",\"view\":\"timeSeries\",\"stacked\":false,\"metrics\":[[\"${AWS::StackName}/VpcFlowLogs\",\"RejectedConnections\",{\"stat\":\"Sum\",\"label\":\"Rejected/5min\"}]],\"period\":300,\"region\":\"${AWS::Region}\",\"annotations\":{\"horizontal\":[{\"label\":\"Alarm threshold\",\"value\":500}]}}},{\"type\":\"alarm\",\"x\":0,\"y\":12,\"width\":24,\"height\":7,\"properties\":{\"title\":\"Cluster alarms - red = firing, grey = not created (action set to off)\",\"alarms\":[\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-AlarmWafCommonRuleSet\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-AlarmWafKnownBadInputs\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-AlarmWafSQLi\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-AlarmWafWordPress\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-AlarmWafRateLimitSourceIp\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-AlarmWafRateLimitForwardedIp\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-dns-firewall-alert-surge\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-dns-firewall-blocked\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-vpc-rejected-surge\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-rds-error\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-rds-slow-queries\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-rds-connections\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-elb-5xx\"],\"sortBy\":\"stateUpdatedTimestamp\",\"states\":[\"ALARM\",\"INSUFFICIENT_DATA\",\"OK\"]}},{\"type\":\"log\",\"x\":0,\"y\":19,\"width\":8,\"height\":7,\"properties\":{\"title\":\"DNS Firewall - what the whitelist does not cover (14d)\",\"region\":\"${AWS::Region}\",\"view\":\"table\",\"query\":\"SOURCE '${AWS::StackName}-DnsFirewallLogs' | filter firewall_rule_action in [\\\"ALERT\\\",\\\"BLOCK\\\"] | filter query_type not in [\\\"PTR\\\"] | stats count(*) as requests by query_name, firewall_rule_action | sort requests desc | limit 20\"}},{\"type\":\"log\",\"x\":8,\"y\":19,\"width\":8,\"height\":7,\"properties\":{\"title\":\"Rejected outbound connections - signal once egress is restricted\",\"region\":\"${AWS::Region}\",\"view\":\"table\",\"query\":\"SOURCE '${AWS::StackName}-VpcFlowLogs' | stats count(*) as flows by dstAddr, dstPort, srcAddr | sort flows desc | limit 20\"}},{\"type\":\"log\",\"x\":16,\"y\":19,\"width\":8,\"height\":7,\"properties\":{\"title\":\"Slow queries (long_query_time)\",\"region\":\"${AWS::Region}\",\"view\":\"table\",\"query\":\"SOURCE '/aws/rds/cluster/${Rdscl}/slowquery' | parse @message /Query_time: (?<qt>[0-9.]+)/ | filter ispresent(qt) | sort qt desc | limit 20\"}}]}"
        }
      },
      "Metadata": {
        "Note": "The alarm widget lists alarms by constructed ARN rather than by Ref, because most are conditional on their *AlarmAction parameter and a conditional Ref cannot be woven into a JSON string without making this body unreadable. Consequence: an alarm set to off does not exist and shows as unavailable rather than disappearing. Note what 'dashboard' as an alarm action does NOT mean - it does not place the alarm here, it sets ActionsEnabled false. This widget is what makes the name approximately true."
      }
    },
    "WafWebAcl": {
      "Type": "AWS::WAFv2::WebACL",
      "Metadata": {
        "Note": "Scope REGIONAL, so this is created in the cluster's own region and attaches directly to the ALB - unlike the CLOUDFRONT-scoped WebACL in cloudfront-alb-distribution, which lives in us-east-1 and only inspects traffic that travels through CloudFront. Rule order is deliberate: generic managed groups first, then application-specific rules, then rate limiting last so that legitimate-looking floods are still classified by the groups above. Every rule carries its own off/count/block parameter - a single global switch would force promoting all rules at once, which defeats the point of a counting period. The rule set is deliberately generic: broad signatures, virtual patching, SQLi, WordPress, rate limiting; groups that overlapped or that cannot serve a mixed proxied and direct estate were removed, see TASKS.md. Where a CDN fronts the ALB, set WafClientIpHeader - without it proxied requests all aggregate onto the proxy's addresses and blocking on rate would take the proxy out for every site behind it."
      },
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-waf"
        },
        "Scope": "REGIONAL",
        "DefaultAction": {
          "Allow": {}
        },
        "Description": {
          "Fn::Sub": "WAF for the ${AWS::StackName} ALB"
        },
        "VisibilityConfig": {
          "SampledRequestsEnabled": true,
          "CloudWatchMetricsEnabled": true,
          "MetricName": "AlbWebAcl"
        },
        "Rules": [
          {
            "Fn::If": [
              "CommonRuleSetActionEnabled",
              {
                "Name": "AWSManagedRulesCommonRuleSet",
                "Priority": 20,
                "OverrideAction": {
                  "Fn::If": [
                    "CommonRuleSetActionCounts",
                    {
                      "Count": {}
                    },
                    {
                      "None": {}
                    }
                  ]
                },
                "Statement": {
                  "ManagedRuleGroupStatement": {
                    "VendorName": "AWS",
                    "Name": "AWSManagedRulesCommonRuleSet"
                  }
                },
                "VisibilityConfig": {
                  "SampledRequestsEnabled": true,
                  "CloudWatchMetricsEnabled": true,
                  "MetricName": "AWSManagedRulesCommonRuleSet"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "KnownBadInputsActionEnabled",
              {
                "Name": "AWSManagedRulesKnownBadInputsRuleSet",
                "Priority": 30,
                "OverrideAction": {
                  "Fn::If": [
                    "KnownBadInputsActionCounts",
                    {
                      "Count": {}
                    },
                    {
                      "None": {}
                    }
                  ]
                },
                "Statement": {
                  "ManagedRuleGroupStatement": {
                    "VendorName": "AWS",
                    "Name": "AWSManagedRulesKnownBadInputsRuleSet"
                  }
                },
                "VisibilityConfig": {
                  "SampledRequestsEnabled": true,
                  "CloudWatchMetricsEnabled": true,
                  "MetricName": "AWSManagedRulesKnownBadInputsRuleSet"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "SqliRuleSetActionEnabled",
              {
                "Name": "AWSManagedRulesSQLiRuleSet",
                "Priority": 40,
                "OverrideAction": {
                  "Fn::If": [
                    "SqliRuleSetActionCounts",
                    {
                      "Count": {}
                    },
                    {
                      "None": {}
                    }
                  ]
                },
                "Statement": {
                  "ManagedRuleGroupStatement": {
                    "VendorName": "AWS",
                    "Name": "AWSManagedRulesSQLiRuleSet"
                  }
                },
                "VisibilityConfig": {
                  "SampledRequestsEnabled": true,
                  "CloudWatchMetricsEnabled": true,
                  "MetricName": "AWSManagedRulesSQLiRuleSet"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "WordPressRulesActionEnabled",
              {
                "Name": "AWSManagedRulesWordPressRuleSet",
                "Priority": 50,
                "OverrideAction": {
                  "Fn::If": [
                    "WordPressRulesActionCounts",
                    {
                      "Count": {}
                    },
                    {
                      "None": {}
                    }
                  ]
                },
                "Statement": {
                  "ManagedRuleGroupStatement": {
                    "VendorName": "AWS",
                    "Name": "AWSManagedRulesWordPressRuleSet"
                  }
                },
                "VisibilityConfig": {
                  "SampledRequestsEnabled": true,
                  "CloudWatchMetricsEnabled": true,
                  "MetricName": "AWSManagedRulesWordPressRuleSet"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "RateLimitActionEnabledAndForwardedIp",
              {
                "Name": "RateLimitForwardedIp",
                "Priority": 90,
                "Action": {
                  "Fn::If": [
                    "RateLimitActionCounts",
                    {
                      "Count": {}
                    },
                    {
                      "Block": {}
                    }
                  ]
                },
                "Statement": {
                  "RateBasedStatement": {
                    "Limit": {
                      "Ref": "WafRateLimitRequests"
                    },
                    "AggregateKeyType": "FORWARDED_IP",
                    "ForwardedIPConfig": {
                      "HeaderName": {
                        "Ref": "WafClientIpHeader"
                      },
                      "FallbackBehavior": "NO_MATCH"
                    },
                    "ScopeDownStatement": {
                      "SizeConstraintStatement": {
                        "FieldToMatch": {
                          "SingleHeader": {
                            "Name": {
                              "Ref": "WafClientIpHeader"
                            }
                          }
                        },
                        "ComparisonOperator": "GT",
                        "Size": 0,
                        "TextTransformations": [
                          {
                            "Priority": 0,
                            "Type": "NONE"
                          }
                        ]
                      }
                    }
                  }
                },
                "VisibilityConfig": {
                  "SampledRequestsEnabled": true,
                  "CloudWatchMetricsEnabled": true,
                  "MetricName": "RateLimitForwardedIp"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "RateLimitActionEnabled",
              {
                "Name": "RateLimitSourceIp",
                "Priority": 91,
                "Action": {
                  "Fn::If": [
                    "RateLimitActionCounts",
                    {
                      "Count": {}
                    },
                    {
                      "Block": {}
                    }
                  ]
                },
                "Statement": {
                  "RateBasedStatement": {
                    "Limit": {
                      "Ref": "WafRateLimitRequests"
                    },
                    "AggregateKeyType": "IP",
                    "ScopeDownStatement": {
                      "Fn::If": [
                        "WafForwardedIpInUse",
                        {
                          "NotStatement": {
                            "Statement": {
                              "SizeConstraintStatement": {
                                "FieldToMatch": {
                                  "SingleHeader": {
                                    "Name": {
                                      "Ref": "WafClientIpHeader"
                                    }
                                  }
                                },
                                "ComparisonOperator": "GT",
                                "Size": 0,
                                "TextTransformations": [
                                  {
                                    "Priority": 0,
                                    "Type": "NONE"
                                  }
                                ]
                              }
                            }
                          }
                        },
                        {
                          "Ref": "AWS::NoValue"
                        }
                      ]
                    }
                  }
                },
                "VisibilityConfig": {
                  "SampledRequestsEnabled": true,
                  "CloudWatchMetricsEnabled": true,
                  "MetricName": "RateLimitSourceIp"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        ]
      }
    },
    "WafWebAclAssociation": {
      "Type": "AWS::WAFv2::WebACLAssociation",
      "Properties": {
        "ResourceArn": {
          "Ref": "Loadbalancer"
        },
        "WebACLArn": {
          "Fn::GetAtt": [
            "WafWebAcl",
            "Arn"
          ]
        }
      },
      "Metadata": {
        "Note": "Ref on an AWS::ElasticLoadBalancingV2::LoadBalancer returns its ARN, so no import is needed now that the WebACL lives in the cluster template. An ALB can carry only one WebACL - if one was ever attached by hand, this association collides; check with aws wafv2 get-web-acl-for-resource."
      }
    },
    "WafLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Metadata": {
        "Note": "The name must start with aws-waf-logs- or WAF refuses the logging configuration."
      },
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "aws-waf-logs-${AWS::StackName}-waf"
        },
        "RetentionInDays": 14
      }
    },
    "WafLogDeliveryPolicy": {
      "Type": "AWS::Logs::ResourcePolicy",
      "Metadata": {
        "Note": "Required for WAF logging and easy to miss: PutLoggingConfiguration fails, or delivers nothing, unless the log group grants delivery.logs.amazonaws.com logs:CreateLogStream and logs:PutLogEvents. The console adds this policy implicitly; CloudFormation does not. Scoped to this stack's WAF log group only, with SourceAccount/SourceArn conditions against the confused-deputy case. Note CloudWatch Logs resource policies are account-wide per region and capped (10 per region), so one per cluster is fine but do not fan these out casually."
      },
      "DependsOn": [
        "WafLogGroup"
      ],
      "Properties": {
        "PolicyName": {
          "Fn::Sub": "${AWS::StackName}-waf-log-delivery"
        },
        "PolicyDocument": {
          "Fn::Sub": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"AWSLogDeliveryWrite\",\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"delivery.logs.amazonaws.com\"},\"Action\":[\"logs:CreateLogStream\",\"logs:PutLogEvents\"],\"Resource\":\"arn:aws:logs:${AWS::Region}:${AWS::AccountId}:log-group:aws-waf-logs-${AWS::StackName}-waf:log-stream:*\",\"Condition\":{\"StringEquals\":{\"aws:SourceAccount\":\"${AWS::AccountId}\"},\"ArnLike\":{\"aws:SourceArn\":\"arn:aws:logs:${AWS::Region}:${AWS::AccountId}:*\"}}}]}"
        }
      }
    },
    "WafLoggingConfiguration": {
      "Type": "AWS::WAFv2::LoggingConfiguration",
      "Metadata": {
        "Note": "LogDestinationConfigs takes the log group ARN WITHOUT the trailing :* that Fn::GetAtt returns, hence the constructed ARN. Authorization headers and cookies are redacted: WAF logs the full request, and those carry session tokens and credentials."
      },
      "DependsOn": [
        "WafLogGroup",
        "WafLogDeliveryPolicy"
      ],
      "Properties": {
        "ResourceArn": {
          "Fn::GetAtt": [
            "WafWebAcl",
            "Arn"
          ]
        },
        "LogDestinationConfigs": [
          {
            "Fn::Sub": "arn:aws:logs:${AWS::Region}:${AWS::AccountId}:log-group:aws-waf-logs-${AWS::StackName}-waf"
          }
        ],
        "RedactedFields": [
          {
            "SingleHeader": {
              "Name": "authorization"
            }
          },
          {
            "SingleHeader": {
              "Name": "cookie"
            }
          }
        ]
      }
    }
  },
