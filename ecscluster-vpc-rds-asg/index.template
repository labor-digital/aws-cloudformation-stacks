        "Note": "Per-rule WAF surge alarm, Period 300, threshold from its own parameter. MetricName follows SecretPathsActionCounts: CountedRequests while counting, BlockedRequests once blocking - so one threshold holds through the counting weeks and after promotion.\n\nDimensioned on Rule=SecretPaths, so the mail names it. That is what tells an attack apart from a rule misfiring; a Rule=ALL alarm cannot."
      },
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-AlarmWafSecretPaths"
        },
        "AlarmDescription": "Surge in WAF matches for the SecretPaths rule on the ALB WebACL - requests for credential files such as /.env, /.git/config or /private.pem. Watches CountedRequests while the rule counts and BlockedRequests once it blocks.",
        "ActionsEnabled": {
          "Fn::If": [
            "SecretPathsAlarmAlerts",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "Namespace": "AWS/WAFV2",
        "MetricName": {
          "Fn::If": [
            "SecretPathsActionCounts",
            "CountedRequests",
            "BlockedRequests"
          ]
        },
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": {
          "Ref": "SecretPathsAlarmThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "WebACL",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-waf"
            }
          },
          {
            "Name": "Region",
            "Value": {
              "Ref": "AWS::Region"
            }
          },
          {
            "Name": "Rule",
            "Value": "SecretPaths"
          }
        ],
        "TreatMissingData": "notBreaching"
      }
    },
