      "DependsOn": [ "BaselineHttp4xxTarget" ],
      "Metadata": {
        "Note": "Deviation from this service's own 4xx baseline - a scan wave, a bot hammering login, or a deployment that broke every asset path. Cannot distinguish which 4xx code or which URL, so it is a tripwire, not a diagnosis: follow up in the ALB access logs. Only the upper band is alarmed; a drop in 4xx is not interesting. Needs roughly two weeks of traffic before the band means anything, which is why the parameter defaults to false. Note that scanners hitting the load balancer without a matching listener rule land in the cluster-level HTTPCode_ELB_4XX_Count instead and are not covered here."
      },
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-AlarmHttp4xxTargetAnomaly"
        },
        "AlarmDescription": "Unusual volume of HTTP 4xx responses from the container, measured against a CloudWatch anomaly detection band. Investigate in the ALB access logs.",
        "AlarmActions": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${ClusterStackName}-AlertTopicArn"
            }
          }
        ],
        "ComparisonOperator": "GreaterThanUpperThreshold",
        "EvaluationPeriods": 2,
        "DatapointsToAlarm": 2,
        "ThresholdMetricId": "ad1",
        "Metrics": [
          {
            "Id": "m1",
            "ReturnData": true,
            "MetricStat": {
              "Metric": {
                "Namespace": "AWS/ApplicationELB",
                "MetricName": "HTTPCode_Target_4XX_Count",
                "Dimensions": [
                  {
                    "Name": "TargetGroup",
                    "Value": {
                      "Fn::GetAtt": [ "Target", "TargetGroupFullName" ]
                    }
                  },
                  {
                    "Name": "LoadBalancer",
                    "Value": {
                      "Fn::Select": [ 1, {
                        "Fn::Split": [ "loadbalancer/", { "Fn::ImportValue": { "Fn::Sub": "${ClusterStackName}-LoadbalancerArn" } } ]
                      } ]
                    }
                  }
                ]
              },
              "Period": 300,
              "Stat": "Sum"
            }
          },
          {
            "Id": "ad1",
            "Expression": {
              "Fn::Sub": "ANOMALY_DETECTION_BAND(m1, ${ServiceHttp4xxAnomalyBand})"
            },
            "Label": "HTTPCode_Target_4XX_Count (expected)"
          }
        ],
        "TreatMissingData": "notBreaching"
      }
    },
    "ServiceHighCpuAlarm": {
