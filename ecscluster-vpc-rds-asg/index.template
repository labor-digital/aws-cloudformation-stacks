                    "VendorName": "AWS",
                    "Name": "AWSManagedRulesSQLiRuleSet",
                    "ScopeDownStatement": {
                      "Fn::If": [
                        "SqliHasPathExclusions",
                        {
                          "NotStatement": {
                            "Statement": {
                              "RegexPatternSetReferenceStatement": {
                                "Arn": {
                                  "Fn::GetAtt": [
                                    "WafSqliExcludedPaths",
                                    "Arn"
                                  ]
                                },
                                "FieldToMatch": {
                                  "UriPath": {}
                                },
                                "TextTransformations": [
                                  {
                                    "Priority": 0,
                                    "Type": "LOWERCASE"
                                  }
                                ]
                              }
                            }
                          }
                        },
                        {
                          "Ref": "AWS::NoValue"
                        }
                      ]
                    }
