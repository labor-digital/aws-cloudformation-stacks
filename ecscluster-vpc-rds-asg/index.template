    "VpcAcceptFlowLog": {
      "Type": "AWS::EC2::FlowLog",
      "Condition": "EgressAnalysisEnabled",
      "Properties": {
        "ResourceId": {
          "Ref": "Vpc"
        },
        "ResourceType": "VPC",
        "TrafficType": "ACCEPT",
        "LogDestinationType": "cloud-watch-logs",
        "LogGroupName": {
          "Ref": "VpcAcceptFlowLogGroup"
        },
        "DeliverLogsPermissionArn": {
          "Fn::GetAtt": [
            "VpcAcceptFlowLogRole",
            "Arn"
          ]
        },
        "LogFormat": "${version} ${account-id} ${interface-id} ${srcaddr} ${dstaddr} ${srcport} ${dstport} ${protocol} ${packets} ${bytes} ${start} ${end} ${action} ${log-status} ${pkt-srcaddr} ${pkt-dstaddr} ${flow-direction}"
      },
      "Metadata": {
        "Note": "Custom LogFormat, 17 fields instead of the 14-field default, ending pkt-srcaddr pkt-dstaddr flow-direction. Without the pkt fields every record behind the NAT gateway shows only the gateway; flow-direction names ingress or egress in one field, which the default format leaves to guesswork over source ports.\n\nLogFormat is create-only - changing it replaces the flow log and leaves a gap in delivery."
      }
    },
    "VpcEgressPortsQuery": {
      "Type": "AWS::Logs::QueryDefinition",
      "Condition": "EgressAnalysisEnabled",
      "DependsOn": "VpcAcceptFlowLogGroup",
      "Properties": {
        "Name": "VpcEgressPortsAnalysis",
        "QueryString": {
          "Fn::Sub": "SOURCE logGroups(logGroupName: \"${VpcAcceptFlowLogGroup}\") START=-604800s END=0s\n| fields @timestamp, @message\n| parse @message \"* * * * * * * * * * * * * *\" as version, account, eni, srcaddr, dstaddr, srcport, dstport, protocol, packets, bytes, startTime, endTime, action, status\n| filter action = \"ACCEPT\"\n| filter srcaddr like /^10\\.1\\.[34]\\./\n| filter dstaddr not like /^10\\./\n| filter srcport != 443 and srcport != 80\n| stats count(*) as connections, sum(bytes) as totalBytes by dstport, protocol\n| sort connections desc\n| limit 500"
        }
      }
    },
