{
  "Parameters": {
    "KeypairName": {
      "Description": "Name of an EC2 KeyPair to enable SSH access to the instance. Add using EC2 -> Keypairs",
      "Type": "AWS::EC2::KeyPair::KeyName",
      "ConstraintDescription": "must be the name of an existing EC2 KeyPair."
    },
    "LogsBucketName": {
      "Description": "Name of the shared ALB access logs S3 bucket (alb-logs-bucket stack). Leave empty to disable access logging.",
      "Type": "String",
      "Default": ""
    },
    "AlertEmail": {
      "Description": "E-mail address that receives every alarm notification of this cluster and of all its services. Leave empty to create the topic without a subscription (alarms still publish, nothing is delivered). An e-mail subscription must be confirmed via the link AWS sends: CloudFormation reports CREATE_COMPLETE while the subscription is still PendingConfirmation, so verify with 'aws sns list-subscriptions-by-topic'.",
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "ConstraintDescription": "must be a valid e-mail address, or empty to skip the subscription."
    },
    "RdsMasterUsername": {
      "Description": "MasterUsername which is applied to RDS cluster/instances.",
      "Type": "String",
      "MinLength": "4"
    },
    "RdsMasterPassword": {
      "Description": "MasterPassword which is applied to RDS cluster/instances.",
      "Type": "String",
      "MinLength": "32",
      "NoEcho": true
    },
    "HttpsdefaultlistenerCertificate": {
      "Description": "The certificate-arn which is used for the default listener of the loadbalancer. Add using Certificate Manage (4096-bit keys are not supported!)",
      "Type": "String",
      "MinLength": "1"
    },
    "AscalegroupMinSize": {
      "Type": "Number",
      "Description": "The min count of EC2-Instances (for Autoscaling). Set to 0 to let ECS Managed Scaling handle capacity \u2014 instances will only start when ECS tasks are deployed.",
      "Default": "0",
      "MinValue": "0",
      "MaxValue": "10"
    },
    "AscalegroupMaxSize": {
      "Type": "Number",
      "Description": "The max count of EC2-Instances (for Autoscaling).",
      "Default": "3",
      "MinValue": "1",
      "MaxValue": "30"
    },
    "AscalegroupDesSize": {
      "Type": "Number",
      "Description": "The desired count of EC2-Instances (for Autoscaling). Set to 0 initially \u2014 ECS Managed Scaling will scale up automatically when tasks are deployed.",
      "Default": "0",
      "MinValue": "0",
      "MaxValue": "15"
    },
    "EC2InstanceType": {
      "Description": "Instance type which you want to use for the EC2 machines in the cluster.",
      "Default": "t3.small",
      "Type": "String",
      "AllowedValues": [
        "t3.small",
        "t3.micro"
      ]
    },
    "RdsInstanceType": {
      "Description": "Instance type which you want to use for the RDS DB.",
      "Default": "db.t3.medium",
      "Type": "String",
      "AllowedValues": [
        "db.t3.medium"
      ]
    },
    "BackupCopyDestinationRegion": {
      "Type": "String",
      "Default": "eu-north-1",
      "Description": "Destination region for backup copy (leave empty to disable copy)"
    },
    "DnsFirewallWhitelistDomains": {
      "Type": "CommaDelimitedList",
      "Description": "Comma-separated list of domains to allow through the DNS Firewall (e.g. *.eu-west-3.amazonaws.com,*.ec2.internal,api.doppler.com). Note: wildcards (*) only match a single subdomain level \u2014 *.example.com matches foo.example.com but NOT foo.bar.example.com. List must not be empty and must not contain trailing commas.",
      "Default": "*.in-addr.arpa"
    },
    "EnableEgressAnalysis": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "Enable ACCEPT-mode VPC Flow Logs for egress port baseline analysis. Temporary \u2014 disable after 7-14 days once sufficient data is collected for Security Group hardening (LII26-95)."
    },
    "IpReputationAction": {
      "Type": "String",
      "Default": "count",
      "AllowedValues": [
        "off",
        "count",
        "block"
      ],
      "Description": "AWS threat intelligence on known malicious and botnet source IPs; usually the safest group to enforce first. off = the rule is not created at all; count = matches are counted and nothing is blocked; block = the rule enforces. Promote one rule at a time: deploy everything as count, read its CountedRequests metric for about a week, and switch it to block only once it counts near zero against normal traffic. A group that counts steadily needs a scope-down statement or rule exclusions before it can ever be enforced."
    },
    "CommonRuleSetAction": {
      "Type": "String",
      "Default": "count",
      "AllowedValues": [
        "off",
        "count",
        "block"
      ],
      "Description": "Broad OWASP-style signatures: XSS, path traversal, malformed requests, bad user agents. The most likely source of false positives on TYPO3 and Matomo. off = the rule is not created at all; count = matches are counted and nothing is blocked; block = the rule enforces. Promote one rule at a time: deploy everything as count, read its CountedRequests metric for about a week, and switch it to block only once it counts near zero against normal traffic. A group that counts steadily needs a scope-down statement or rule exclusions before it can ever be enforced."
    },
    "KnownBadInputsAction": {
      "Type": "String",
      "Default": "count",
      "AllowedValues": [
        "off",
        "count",
        "block"
      ],
      "Description": "Payload signatures for widely exploited CVEs (Log4Shell JNDI strings, Java deserialization). This is the virtual-patching layer between a CVE being published and a patched image being deployed. off = the rule is not created at all; count = matches are counted and nothing is blocked; block = the rule enforces. Promote one rule at a time: deploy everything as count, read its CountedRequests metric for about a week, and switch it to block only once it counts near zero against normal traffic. A group that counts steadily needs a scope-down statement or rule exclusions before it can ever be enforced."
    },
    "SqliRuleSetAction": {
      "Type": "String",
      "Default": "count",
      "AllowedValues": [
        "off",
        "count",
        "block"
      ],
      "Description": "Dedicated SQL injection signatures, including UNION-based injection in query arguments. off = the rule is not created at all; count = matches are counted and nothing is blocked; block = the rule enforces. Promote one rule at a time: deploy everything as count, read its CountedRequests metric for about a week, and switch it to block only once it counts near zero against normal traffic. A group that counts steadily needs a scope-down statement or rule exclusions before it can ever be enforced."
    },
    "WordPressRulesAction": {
      "Type": "String",
      "Default": "count",
      "AllowedValues": [
        "off",
        "count",
        "block"
      ],
      "Description": "The WordPress and PHP managed rule groups together. Harmless on non-WordPress services behind the same ALB. off = the rule is not created at all; count = matches are counted and nothing is blocked; block = the rule enforces. Promote one rule at a time: deploy everything as count, read its CountedRequests metric for about a week, and switch it to block only once it counts near zero against normal traffic. A group that counts steadily needs a scope-down statement or rule exclusions before it can ever be enforced."
    },
    "WpCustomRulesAction": {
      "Type": "String",
      "Default": "count",
      "AllowedValues": [
        "off",
        "count",
        "block"
      ],
      "Description": "Custom WordPress rules: the batch/v1 REST route, and unauthenticated POST to /wp/v2/users which is how a forged administrator gets created. off = the rule is not created at all; count = matches are counted and nothing is blocked; block = the rule enforces. Promote one rule at a time: deploy everything as count, read its CountedRequests metric for about a week, and switch it to block only once it counts near zero against normal traffic. A group that counts steadily needs a scope-down statement or rule exclusions before it can ever be enforced."
    },
    "AdminRestrictionAction": {
      "Type": "String",
      "Default": "count",
      "AllowedValues": [
        "off",
        "count",
        "block"
      ],
      "Description": "Restricts /wp-admin, /wp-login.php and /typo3/ to AdminAllowedCidrs. Has no effect unless AdminAllowedCidrs is set - the rule is then not created. The strongest control in this template: an admin surface reachable only from the office cannot be brute-forced from the internet. off = the rule is not created at all; count = matches are counted and nothing is blocked; block = the rule enforces. Promote one rule at a time: deploy everything as count, read its CountedRequests metric for about a week, and switch it to block only once it counts near zero against normal traffic. A group that counts steadily needs a scope-down statement or rule exclusions before it can ever be enforced."
    },
    "RateLimitAction": {
      "Type": "String",
      "Default": "count",
      "AllowedValues": [
        "off",
        "count",
        "block"
      ],
      "Description": "Rate-based rule using RateLimitRequests as the per-IP limit. off = the rule is not created at all; count = matches are counted and nothing is blocked; block = the rule enforces. Promote one rule at a time: deploy everything as count, read its CountedRequests metric for about a week, and switch it to block only once it counts near zero against normal traffic. A group that counts steadily needs a scope-down statement or rule exclusions before it can ever be enforced."
    },
    "WafRateLimitRequests": {
      "Type": "Number",
      "Default": 2000,
      "MinValue": 100,
      "MaxValue": 2000000000,
      "Description": "Requests per 5 minutes from a single IP before the rate-based rule applies. WAF enforces a minimum of 100. Set RateLimitAction to off to disable the rule instead."
    },
    "WafAdminAllowedCidrs": {
      "Type": "CommaDelimitedList",
      "Default": "",
      "Description": "Comma-separated CIDRs allowed to reach admin paths. Leave empty to skip the RestrictAdminPaths rule entirely, regardless of AdminRestrictionAction."
    },
    "WafLogRetentionDays": {
      "Type": "Number",
      "Default": 14,
      "Description": "Retention for the WAF log group. 14 days matches the DSGVO retention used for ALB, VPC flow and DNS logs - WAF logs contain client IP addresses on the same basis."
    },
    "WafBlockedRequestAlarmThreshold": {
      "Type": "Number",
      "Default": 0,
      "MinValue": 0,
      "Description": "Blocked requests per 5 minutes that raise an alarm on the cluster alert topic. 0 disables the alarm. Leave at 0 while every rule is still counting, since nothing is blocked then."
    }
  },
  "Resources": {
