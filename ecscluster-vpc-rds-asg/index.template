    "CommonRuleSetSurgeAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "CommonRuleSetAlarmEnabled",
      "Metadata": {
        "Note": "Per-rule WAF surge alarm, Period 300, threshold from its own parameter. MetricName follows CommonRuleSetActionCounts: CountedRequests while counting, BlockedRequests once blocking - so one threshold holds through the counting weeks and after promotion.\n\nDimensioned on Rule=AWSManagedRulesCommonRuleSet, so the mail names it. That is what tells an attack apart from a rule misfiring; a Rule=ALL alarm cannot."
      },
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-AlarmWafCommonRuleSet"
        },
        "AlarmDescription": "Surge in WAF matches for rule AWSManagedRulesCommonRuleSet on the ALB WebACL. Watches CountedRequests while the rule counts and BlockedRequests once it blocks.",
        "ActionsEnabled": {
          "Fn::If": [
            "CommonRuleSetAlarmAlerts",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "Namespace": "AWS/WAFV2",
        "MetricName": {
          "Fn::If": [
            "CommonRuleSetActionCounts",
            "CountedRequests",
            "BlockedRequests"
          ]
        },
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": {
          "Ref": "CommonRuleSetAlarmThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "WebACL",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-waf"
            }
          },
          {
            "Name": "Region",
            "Value": {
              "Ref": "AWS::Region"
            }
          },
          {
            "Name": "Rule",
            "Value": "AWSManagedRulesCommonRuleSet"
          }
        ],
        "TreatMissingData": "notBreaching"
      }
    },
