  "Parameters": {
    "KeypairName": {
      "Description": "Name of an EC2 KeyPair to enable SSH access to the instance. Add using EC2 -> Keypairs",
      "Type": "AWS::EC2::KeyPair::KeyName",
      "ConstraintDescription": "must be the name of an existing EC2 KeyPair."
    },
    "LogsBucketName": {
      "Description": "Name of the shared ALB access logs S3 bucket (alb-logs-bucket stack). Leave empty to disable access logging.",
      "Type": "String",
      "Default": ""
    },
    "ElbHttp5xxAlarmAction": {
      "Type": "String",
      "Default": "dashboard",
      "AllowedValues": [
        "off",
        "dashboard",
        "alert"
      ],
      "Description": "5xx generated by the load balancer itself: 503 no healthy target, 502 malformed or aborted response, 504 target timeout. It lives in the cluster rather than in ecsservice because HTTPCode_ELB_5XX_Count carries no TargetGroup dimension and therefore cannot be measured per service. off = not created. dashboard = exists, state and history only, nothing is sent. alert = also notifies the cluster AlertTopic."
    },
    "ElbHttp5xxAlarmThreshold": {
      "Type": "Number",
      "Default": 10,
      "MinValue": 0,
      "Description": "Load-balancer-generated 5xx responses per 5 minutes before ElbHttp5xxAlarmAction fires. Cluster-wide across every service on this ALB, because the metric has no TargetGroup dimension. Deploys contribute legitimately: with ecsservice MinimumHealthyPercent 50 a single-task service briefly has no healthy target and the ALB answers 503, which is why the default is 10 rather than 0."
    },
    "AlertEmail": {
      "Description": "E-mail address that receives every alarm notification of this cluster and of all its services. Leave empty to create the topic without a subscription (alarms still publish, nothing is delivered). An e-mail subscription must be confirmed via the link AWS sends: CloudFormation reports CREATE_COMPLETE while the subscription is still PendingConfirmation, so verify with 'aws sns list-subscriptions-by-topic'.",
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "ConstraintDescription": "must be a valid e-mail address, or empty to skip the subscription."
    },
    "RdsMasterUsername": {
      "Description": "MasterUsername which is applied to RDS cluster/instances.",
      "Type": "String",
      "MinLength": "4"
    },
    "RdsMasterPassword": {
      "Description": "MasterPassword which is applied to RDS cluster/instances.",
      "Type": "String",
      "MinLength": "32",
      "NoEcho": true
    },
    "HttpsdefaultlistenerCertificate": {
      "Description": "The certificate-arn which is used for the default listener of the loadbalancer. Add using Certificate Manage (4096-bit keys are not supported!)",
      "Type": "String",
      "MinLength": "1"
    },
    "AscalegroupMinSize": {
      "Type": "Number",
      "Description": "The min count of EC2-Instances (for Autoscaling). Set to 0 to let ECS Managed Scaling handle capacity - instances will only start when ECS tasks are deployed.",
      "Default": "0",
      "MinValue": "0",
      "MaxValue": "10"
    },
    "AscalegroupMaxSize": {
      "Type": "Number",
      "Description": "The max count of EC2-Instances (for Autoscaling).",
      "Default": "3",
      "MinValue": "1",
      "MaxValue": "30"
    },
    "AscalegroupDesSize": {
      "Type": "Number",
      "Description": "The desired count of EC2-Instances (for Autoscaling). Set to 0 initially - ECS Managed Scaling will scale up automatically when tasks are deployed. Capped at 30 to match AscalegroupMaxSize: ECS managed scaling moves the real DesiredCapacity, and a cap below the ASG's MaxSize makes it impossible to realign the parameter with the live value before a stack update - which then resets the size and terminates instances.",
      "Default": "0",
      "MinValue": "0",
      "MaxValue": "30"
    },
    "EC2InstanceType": {
      "Description": "Instance type which you want to use for the EC2 machines in the cluster.",
      "Default": "t3.small",
      "Type": "String",
      "AllowedValues": [
        "t3.small",
        "t3.micro"
      ]
    },
    "RdsInstanceType": {
      "Description": "Instance type which you want to use for the RDS DB.",
      "Default": "db.t3.medium",
      "Type": "String",
      "AllowedValues": [
        "db.t3.medium"
      ]
    },
    "BackupCopyDestinationRegion": {
      "Type": "String",
      "Default": "eu-north-1",
      "Description": "Destination region for backup copy (leave empty to disable copy)"
    },
    "DnsFirewallWhitelistDomains": {
      "Type": "CommaDelimitedList",
      "Description": "Comma-separated domains to allow through the DNS Firewall. Must not be empty and must not contain trailing commas. A wildcard replaces the leftmost label entirely and covers any depth beneath it - *.example.com matches foo.example.com and a.b.example.com, but *prod.example.com is invalid. It does not cover the apex, so list example.com separately from *.example.com where both are queried. Note that an entry here covers the queried name only if the whole redirection chain is trusted - see DnsFirewallRedirectionAction.",
      "Default": "*.in-addr.arpa"
    },
    "DnsFirewallRedirectionAction": {
      "Type": "String",
      "Default": "TRUST_REDIRECTION_DOMAIN",
      "AllowedValues": [
        "TRUST_REDIRECTION_DOMAIN",
        "INSPECT_REDIRECTION_DOMAIN"
      ],
      "Description": "How the ALLOW rule treats a CNAME or DNAME chain. TRUST: once the queried name is on the whitelist, the rest of the chain is trusted. INSPECT (the AWS default) evaluates every link, so each redirection target must also be listed or the catch-all fires - and the alert is logged under the ORIGINAL query name, which makes it read as a broken whitelist entry. TRUST is the default here because INSPECT is stricter in name only: passing a CDN-served domain under it means allowing the whole CDN namespace, which is a far wider grant than trusting one vendor's own chain. What TRUST gives up is an attacker controlling a whitelisted domain's DNS; the realistic version of that lands on a cloud provider this list already allows, so INSPECT would not catch it either."
    },
    "DnsFirewallCatchAllAction": {
      "Type": "String",
      "Default": "ALERT",
      "AllowedValues": [
        "ALERT",
        "BLOCK"
      ],
      "Description": "Action of the catch-all rule, i.e. what happens to every domain the whitelist does not cover. ALERT logs the query and resolves it anyway - audit mode, and the safe default. BLOCK refuses the resolution and answers with DnsFirewallBlockResponse. Do not flip to BLOCK before the whitelist is complete: run DnsFireWallLogsSummary until nothing legitimate still alerts. The failure mode is delayed and easy to miss - a blocked resolution does not disturb a running container, it breaks the image pull at the next task placement, so an application test passes while nothing can restart or scale. Rollback is a parameter update to ALERT."
    },
    "DnsFirewallBlockResponse": {
      "Type": "String",
      "Default": "NXDOMAIN",
      "AllowedValues": [
        "NXDOMAIN",
        "NODATA"
      ],
      "Description": "How a blocked query is answered. Only evaluated when DnsFirewallCatchAllAction is BLOCK - Route 53 rejects the property on an ALERT rule, so the template omits it entirely otherwise. NXDOMAIN reports the domain as non-existent, which clients surface at once as a clean lookup failure. NODATA reports the name as existing without a record of the requested type, which some clients retry against other types before giving up. Prefer NXDOMAIN: a fast unambiguous failure is easier to trace than a timeout."
    },
    "EnableEgressAnalysis": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "Enable ACCEPT-mode VPC Flow Logs. For temporary testing only: they exist to record which outbound ports are actually in use, so that a baseline can be derived and the security groups tightened against it."
    },
    "EgressPolicy": {
      "Type": "String",
      "Default": "open",
      "AllowedValues": [
        "open",
        "restricted"
      ],
      "Description": "Outbound policy of the EC2 instances. open = one allow-all rule, identical to the AWS default. restricted = 443/TCP to anywhere, 53/UDP+TCP to the VPC CIDR, plus whatever EgressExtraRules lists. Ships as open, so deploying this version changes nothing."
    },
    "EgressExtraRules": {
      "Type": "String",
      "Default": "0:0.0.0.0/0",
      "AllowedPattern": "^([0-9]{1,5}:[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2})(,[0-9]{1,5}:[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}){0,3}$",
      "ConstraintDescription": "1-4 port:cidr pairs separated by commas, e.g. 587:203.0.113.10/32 - or 0:0.0.0.0/0 for none",
      "Description": "Additional outbound TCP rules under EgressPolicy=restricted, as port:cidr pairs separated by commas, e.g. 587:203.0.113.10/32,4318:198.51.100.7/32. Up to four; write 0:0.0.0.0/0 for none, and use 0.0.0.0/0 as the cidr to allow a port to any destination. The default is 0:0.0.0.0/0, i.e. no extra rules - real addresses are deliberately not shipped in this template because the repository is public. Pass this parameter explicitly on every deployment, in every region, exactly like the *AlarmAction parameters; do not rely on the previous value. Two destinations are known to need a rule because they do not run on 443: the SMTP relay on 587 and the page builder's OTLP collector on 4318. The addresses live in the local runbook, not here."
    },
    "CommonRuleSetAction": {
      "Type": "String",
      "Default": "count",
      "AllowedValues": [
        "off",
        "count",
        "block"
      ],
      "Description": "Broad OWASP-style signatures: XSS, path traversal, malformed requests, bad user agents. The most likely source of false positives on TYPO3 and Matomo. off = the rule is not created at all; count = matches are counted and nothing is blocked; block = the rule enforces."
    },
    "KnownBadInputsAction": {
      "Type": "String",
      "Default": "count",
      "AllowedValues": [
        "off",
        "count",
        "block"
      ],
      "Description": "Payload signatures for widely exploited CVEs (Log4Shell JNDI strings, Java deserialization). This is the virtual-patching layer between a CVE being published and a patched image being deployed. off = the rule is not created at all; count = matches are counted and nothing is blocked; block = the rule enforces."
    },
    "SqliRuleSetAction": {
      "Type": "String",
      "Default": "count",
      "AllowedValues": [
        "off",
        "count",
        "block"
      ],
      "Description": "Dedicated SQL injection signatures, including UNION-based injection in query arguments. off = the rule is not created at all; count = matches are counted and nothing is blocked; block = the rule enforces."
    },
    "WordPressRulesAction": {
      "Type": "String",
      "Default": "count",
      "AllowedValues": [
        "off",
        "count",
        "block"
      ],
      "Description": "Gates the AWS WordPress managed rule group. Harmless on the non-WordPress services behind the same ALB. off = the rule is not created at all; count = matches are counted and nothing is blocked; block = the rule enforces."
    },
    "RateLimitAction": {
      "Type": "String",
      "Default": "count",
      "AllowedValues": [
        "off",
        "count",
        "block"
      ],
      "Description": "Rate-based rule using RateLimitRequests as the per-IP limit. off = the rule is not created at all; count = matches are counted and nothing is blocked; block = the rule enforces. Promote one rule at a time: deploy everything as count, read its CountedRequests metric for about a week, and switch it to block only once it counts near zero against normal traffic. A group that counts steadily needs a scope-down statement or rule exclusions before it can ever be enforced."
    },
    "WafClientIpHeader": {
      "Type": "String",
      "Default": "",
      "Description": "HTTP header carrying the real client IP where a CDN or proxy fronts the ALB. MUST be lowercase - 'cf-connecting-ip' for Cloudflare, 'x-forwarded-for' generically - because the header match is case-sensitive. Optional while RateLimitAction is 'off' or 'count', but REQUIRED before setting RateLimitAction to 'block' (enforced by the Rules section): this estate is mixed, and with the header unset every proxied request aggregates onto the proxy's own few addresses, so blocking on rate would take the proxy out for all sites behind it. When set, two rate rules exist: RateLimitForwardedIp keys on this header for requests that carry it, RateLimitSourceIp keys on the source IP for those that do not. Caveat: a header is only trustworthy while the ALB cannot be reached directly - otherwise anyone can set it themselves and evade the rate limit. Restrict the ALB security group to the proxy's ranges before relying on it.",
      "AllowedPattern": "^$|^[a-z0-9-]+$",
      "ConstraintDescription": "must be lowercase (e.g. cf-connecting-ip) or empty."
    },
    "WafRateLimitRequests": {
      "Type": "Number",
      "Default": 2000,
      "MinValue": 100,
      "MaxValue": 2000000000,
      "Description": "Requests per 5 minutes from a single IP before the rate-based rule applies. WAF enforces a minimum of 100. Set RateLimitAction to off to disable the rule instead."
    },
    "DnsFirewallAlarmAction": {
      "Type": "String",
      "Default": "dashboard",
      "AllowedValues": [
        "off",
        "dashboard",
        "alert"
      ],
      "Description": "Surge in DNS Firewall events on the catch-all rule, i.e. an unusual volume of names the whitelist does not cover. A volume alarm, not a novelty detector - a single new domain never moves it; use the DnsFireWallLogsSummary query for that. off = not created. dashboard = exists, state and history only, nothing is sent. alert = also notifies the cluster AlertTopic."
    },
    "DnsFirewallAlarmThreshold": {
      "Type": "Number",
      "Default": 100,
      "MinValue": 1,
      "Description": "DNS Firewall ALERT events per 5 minutes before DnsFirewallAlarmAction fires."
    },
    "DnsFirewallBlockAlarmAction": {
      "Type": "String",
      "Default": "alert",
      "AllowedValues": [
        "off",
        "dashboard",
        "alert"
      ],
      "Description": "Alarm on queries the catch-all rule refused. Created only while DnsFirewallCatchAllAction is BLOCK, so it ships inert. Defaults to alert rather than dashboard because under a walled-garden catch-all a block is never routine: either something was stopped that should have been, or the whitelist is incomplete. off = not created. dashboard = exists, state and history only, nothing is sent. alert = also notifies the cluster AlertTopic."
    },
    "DnsFirewallBlockAlarmThreshold": {
      "Type": "Number",
      "Default": 0,
      "MinValue": 0,
      "Description": "Blocked queries per 5 minutes before the block alarm fires. Default 0, so any block at all notifies - that is what distinguishes it from DnsFirewallAlarmThreshold, which answers 'is an unusual volume being resolved' and sits far above normal traffic. This one answers 'did anything get refused', where the first occurrence is the interesting one. Raise it only if a known, accepted block turns out to repeat."
    },
    "VpcFlowLogsAlarmAction": {
      "Type": "String",
      "Default": "dashboard",
      "AllowedValues": [
        "off",
        "dashboard",
        "alert"
      ],
      "Description": "Surge in REJECTed VPC flows. Only meaningful once egress is restricted: while everything is permitted, rejections are background noise rather than signal. off = not created. dashboard = exists, state and history only, nothing is sent. alert = also notifies the cluster AlertTopic."
    },
    "VpcFlowLogsAlarmThreshold": {
      "Type": "Number",
      "Default": 500,
      "MinValue": 1,
      "Description": "Rejected VPC connections per 5 minutes before VpcFlowLogsAlarmAction fires."
    },
    "RdsErrorAlarmAction": {
      "Type": "String",
      "Default": "dashboard",
      "AllowedValues": [
        "off",
        "dashboard",
        "alert"
      ],
      "Description": "Any [ERROR] line in the Aurora error log. Threshold 0 by default, which makes it the noisiest of the RDS alarms and is the point of it. off = not created. dashboard = exists, state and history only, nothing is sent. alert = also notifies the cluster AlertTopic."
    },
    "RdsErrorAlarmThreshold": {
      "Type": "Number",
      "Default": 0,
      "MinValue": 0,
      "Description": "Aurora error-log lines per 5 minutes before RdsErrorAlarmAction fires. The default 0 means every single [ERROR] line raises the alarm, which is the point of it - raising this silently swallows database errors, so change it only with a reason."
    },
    "RdsSlowQueryAlarmAction": {
      "Type": "String",
      "Default": "dashboard",
      "AllowedValues": [
        "off",
        "dashboard",
        "alert"
      ],
      "Description": "Slow-query log lines above RdsLongQueryTime. off = not created. dashboard = exists, state and history only, nothing is sent. alert = also notifies the cluster AlertTopic."
    },
    "RdsSlowQueryAlarmThreshold": {
      "Type": "Number",
      "Default": 5,
      "MinValue": 1,
      "Description": "Slow-query log lines per 5 minutes before RdsSlowQueryAlarmAction fires. Raise this temporarily when long_query_time is set to 0 for a full query trace, or the alarm is red immediately."
    },
    "RdsLongQueryTime": {
      "Type": "Number",
      "Default": 2,
      "MinValue": 0,
      "MaxValue": 60,
      "Description": "Seconds a query must exceed to be written to the slow query log. Without this parameter MySQL's default of 10 applies."
    },
    "RdsConnectionsAlarmAction": {
      "Type": "String",
      "Default": "dashboard",
      "AllowedValues": [
        "off",
        "dashboard",
        "alert"
      ],
      "Description": "Open database connections against the instance limit. The only alarm that sees connection exhaustion coming, and the failure it catches is cluster-wide rather than per service. off = not created. dashboard = exists, state and history only, nothing is sent. alert = also notifies the cluster AlertTopic."
    },
    "RdsConnectionsAlarmThreshold": {
      "Type": "Number",
      "Default": 60,
      "MinValue": 1,
      "Description": "Open database connections (Maximum over 5 minutes) before RdsConnectionsAlarmAction fires. The ceiling is max_connections from Rdsinstance1ParameterGroup: log is base 2 in an RDS parameter formula, so log2(DBInstanceClassMemory/805306368)*60 lands at roughly 138-145 on db.t3.medium."
    },
    "CommonRuleSetAlarmAction": {
      "Type": "String",
      "Default": "dashboard",
      "AllowedValues": [
        "off",
        "dashboard",
        "alert"
      ],
      "Description": "Surge alarm for AWSManagedRulesCommonRuleSet - by far the highest-volume group, dominated by NoUserAgent_HEADER, so a low threshold here sits permanently red. The alarm follows the rule's own mode: CountedRequests while CommonRuleSetAction is count, BlockedRequests once it is block - promotion changes whether matches die, not how many there are, so one threshold serves both. off = not created. dashboard = exists, state and history only, nothing is sent. alert = also notifies the cluster AlertTopic."
    },
    "CommonRuleSetAlarmThreshold": {
      "Type": "Number",
      "Default": 300,
      "MinValue": 1,
      "Description": "Matches per 5 minutes before CommonRuleSetAlarmAction fires."
    },
    "KnownBadInputsAlarmAction": {
      "Type": "String",
      "Default": "dashboard",
      "AllowedValues": [
        "off",
        "dashboard",
        "alert"
      ],
      "Description": "Surge alarm for AWSManagedRulesKnownBadInputsRuleSet. Near-silent on legitimate traffic, so a sustained rise is the most interesting of the five. The alarm follows the rule's own mode: CountedRequests while KnownBadInputsAction is count, BlockedRequests once it is block - promotion changes whether matches die, not how many there are, so one threshold serves both. off = not created. dashboard = exists, state and history only, nothing is sent. alert = also notifies the cluster AlertTopic."
    },
    "KnownBadInputsAlarmThreshold": {
      "Type": "Number",
      "Default": 50,
      "MinValue": 1,
      "Description": "Matches per 5 minutes before KnownBadInputsAlarmAction fires. Starting point derived from the measured count-mode volume; re-read the metric after a week and adjust. Thresholds are per rule on purpose: measured volumes span three orders of magnitude, so no single shared number can serve all five."
    },
    "SqliRuleSetAlarmAction": {
      "Type": "String",
      "Default": "dashboard",
      "AllowedValues": [
        "off",
        "dashboard",
        "alert"
      ],
      "Description": "Surge alarm for AWSManagedRulesSQLiRuleSet - the quietest managed group, so it can carry a tight threshold. The alarm follows the rule's own mode: CountedRequests while SqliRuleSetAction is count, BlockedRequests once it is block - promotion changes whether matches die, not how many there are, so one threshold serves both. off = not created. dashboard = exists, state and history only, nothing is sent. alert = also notifies the cluster AlertTopic."
    },
    "SqliRuleSetAlarmThreshold": {
      "Type": "Number",
      "Default": 20,
      "MinValue": 1,
      "Description": "Matches per 5 minutes before SqliRuleSetAlarmAction fires. Starting point derived from the measured count-mode volume; re-read the metric after a week and adjust. Thresholds are per rule on purpose: measured volumes span three orders of magnitude, so no single shared number can serve all five."
    },
    "WordPressRulesAlarmAction": {
      "Type": "String",
      "Default": "dashboard",
      "AllowedValues": [
        "off",
        "dashboard",
        "alert"
      ],
      "Description": "Surge alarm for AWSManagedRulesWordPressRuleSet. The alarm follows the rule's own mode: CountedRequests while WordPressRulesAction is count, BlockedRequests once it is block - promotion changes whether matches die, not how many there are, so one threshold serves both. off = not created. dashboard = exists, state and history only, nothing is sent. alert = also notifies the cluster AlertTopic."
    },
    "WordPressRulesAlarmThreshold": {
      "Type": "Number",
      "Default": 20,
      "MinValue": 1,
      "Description": "Matches per 5 minutes before WordPressRulesAlarmAction fires. Starting point derived from the measured count-mode volume; re-read the metric after a week and adjust. Thresholds are per rule on purpose: measured volumes span three orders of magnitude, so no single shared number can serve all five."
    },
    "RateLimitAlarmAction": {
      "Type": "String",
      "Default": "dashboard",
      "AllowedValues": [
        "off",
        "dashboard",
        "alert"
      ],
      "Description": "Surge alarm for the rate-based rules. Two alarms exist when WafClientIpHeader is set, one per rule, otherwise one; both share this threshold. The alarm follows the rule's own mode: CountedRequests while RateLimitAction is count, BlockedRequests once it is block - promotion changes whether matches die, not how many there are, so one threshold serves both. off = not created. dashboard = exists, state and history only, nothing is sent. alert = also notifies the cluster AlertTopic."
    },
    "RateLimitAlarmThreshold": {
      "Type": "Number",
      "Default": 10,
      "MinValue": 1,
      "Description": "Matches per 5 minutes before RateLimitAlarmAction fires. Starting point derived from the measured count-mode volume; re-read the metric after a week and adjust. Thresholds are per rule on purpose: measured volumes span three orders of magnitude, so no single shared number can serve all five."
    }
  },
  "Rules": {
    "WafRateLimitNeedsClientIpHeader": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "RateLimitAction"
          },
          "block"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "WafClientIpHeader"
                  },
                  ""
                ]
              }
            ]
          },
          "AssertDescription": "WafClientIpHeader must be set (e.g. cf-connecting-ip) before RateLimitAction can be set to block. Some sites are proxied through Cloudflare; without the header every proxied request aggregates onto Cloudflare's own addresses, so enforcing the rate limit would block Cloudflare and take out every site behind it."
        }
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.1.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "InstanceTenancy": "default",
        "Tags": [
