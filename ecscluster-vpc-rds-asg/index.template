    "Loadbalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Metadata": {
        "Note": "IpAddressType ipv4 deliberately: the VPC has no IPv6 CIDR and neither subnet has Ipv6CidrBlock, so dualstack needs IPv6 in the VPC and both subnets first. The only IPv6 setting in the repository.\n\nAn external monitor reporting an IPv6 problem is not measuring this balancer - it has no IPv6 address, so what answered was whatever sits in front, in practice the CDN."
      },
      "Properties": {
        "LoadBalancerAttributes": [
          {
            "Key": "deletion_protection.enabled",
            "Value": "true"
