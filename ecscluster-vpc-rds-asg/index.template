        "Namespace": "AWS/WAFV2",
        "MetricName": "BlockedRequests",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": {
          "Ref": "WafBlockedRequestAlarmThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "WebACL",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-waf"
