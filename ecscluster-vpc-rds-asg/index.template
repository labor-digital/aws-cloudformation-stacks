    "Httpdefaultlistener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "DefaultActions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "404",
              "ContentType": "text/plain",
              "MessageBody": "Not found"
            }
          }
        ],
        "LoadBalancerArn": {
          "Ref": "Loadbalancer"
        },
        "Port": 80,
        "Protocol": "HTTP"
      },
      "DependsOn": [
        "Loadbalancer"
      ],
      "Metadata": {
        "Note": "Default action is a fixed 404, not a forward into the empty Deftarget. Forwarding produced a balancer-generated 503 per request matching no host rule - about 10,700 a day, 97 to 99 percent from scanners, all counted in HTTPCode_ELB_5XX_Count, so the elb-5xx alarm measured scanner volume rather than service health.\n\n404 counts as 4xx, so the alarm sees the roughly 240 genuine events a day instead."
      }
    },
    "Httpsdefaultlistener": {
