    "DnsFirewallWhitelistDomainList": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-whitelist"
        },
        "Domains": {
          "Ref": "DnsFirewallWhitelistDomains"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-dns-whitelist"
            }
          },
          {
            "Key": "security-owner",
            "Value": "network-sec"
          }
        ]
      }
    },
    "DnsFirewallCatchAllDomainList": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-catch-all"
        },
        "Domains": [
          "*"
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-dns-catch-all"
            }
          },
          {
            "Key": "security-owner",
            "Value": "network-sec"
          }
        ]
      }
    },
    "DnsFirewallRuleGroup": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-egress-control"
        },
        "FirewallRules": [
          {
            "Priority": 100,
            "FirewallDomainListId": {
              "Ref": "DnsFirewallWhitelistDomainList"
            },
            "Action": "ALLOW",
            "FirewallDomainRedirectionAction": {
              "Ref": "DnsFirewallRedirectionAction"
            }
          },
          {
            "Fn::If": [
              "DnsFirewallAllowsMxQueries",
              {
                "Priority": 150,
                "FirewallDomainListId": {
                  "Ref": "DnsFirewallCatchAllDomainList"
                },
                "Qtype": "MX",
                "Action": "ALLOW",
                "FirewallDomainRedirectionAction": {
                  "Ref": "DnsFirewallRedirectionAction"
                }
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Priority": 200,
            "FirewallDomainListId": {
              "Ref": "DnsFirewallCatchAllDomainList"
            },
            "Action": {
              "Ref": "DnsFirewallCatchAllAction"
            },
            "BlockResponse": {
              "Fn::If": [
                "DnsFirewallCatchAllBlocks",
                {
                  "Ref": "DnsFirewallBlockResponse"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-egress-control"
            }
          },
          {
            "Key": "security-owner",
            "Value": "network-sec"
          }
        ]
      },
      "Metadata": {
        "Note": "Priority 100 allows the whitelist, 150 optionally allows MX for any domain, 200 is the catch-all.\n\nFirst match wins - an ALLOW at 150 ends evaluation, so what it covers never reaches 200 and is never logged as ALERT either."
      }
    },
    "DnsFirewallRuleGroupAssociation": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroupAssociation",
      "Properties": {
        "FirewallRuleGroupId": {
          "Ref": "DnsFirewallRuleGroup"
        },
        "VpcId": {
          "Ref": "Vpc"
        },
        "Priority": 200,
        "MutationProtection": "DISABLED",
        "Name": {
          "Fn::Sub": "${AWS::StackName}-vpc-association"
