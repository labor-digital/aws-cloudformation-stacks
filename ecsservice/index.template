    },
    "HighMemoryAlarmNotifies": {
      "Fn::Equals": [ { "Ref": "ServiceHighMemoryAlarmAction" }, "alert" ]
    },
    "EnableLowCpuAlarm": {
      "Fn::Not": [ { "Fn::Equals": [ { "Ref": "ServiceLowCpuAlarmAction" }, "off" ] } ]
    },
    "LowCpuAlarmNotifies": {
      "Fn::Equals": [ { "Ref": "ServiceLowCpuAlarmAction" }, "alert" ]
    },
    "EnableLowMemoryAlarm": {
      "Fn::Not": [ { "Fn::Equals": [ { "Ref": "ServiceLowMemoryAlarmAction" }, "off" ] } ]
    },
    "LowMemoryAlarmNotifies": {
      "Fn::Equals": [ { "Ref": "ServiceLowMemoryAlarmAction" }, "alert" ]
    },
    "EnableHttp5xxTargetAlarm": {
      "Fn::Not": [ { "Fn::Equals": [ { "Ref": "ServiceHttp5xxTargetAlarmAction" }, "off" ] } ]
    },
    "Http5xxTargetAlarmNotifies": {
      "Fn::Equals": [ { "Ref": "ServiceHttp5xxTargetAlarmAction" }, "alert" ]
    },
    "EnableHttp4xxAnomaly": {
      "Fn::Not": [ { "Fn::Equals": [ { "Ref": "ServiceHttp4xxAnomalyAlarmAction" }, "off" ] } ]
    },
    "Http4xxAnomalyAlarmNotifies": {
      "Fn::Equals": [ { "Ref": "ServiceHttp4xxAnomalyAlarmAction" }, "alert" ]
    },
    "EnableImageRegressionGuard": {
      "Fn::Equals" : [ { "Ref" : "EnableImageRegressionAlarm" }, "true" ]
    }
  },
  "Resources" : {
    "ServiceRole" : {
      "Type" : "AWS::IAM::Role",
      "Properties" : {
        "AssumeRolePolicyDocument" : {
          "Version" : "2012-10-17",
          "Statement" : [ {
            "Effect" : "Allow",
            "Principal" : {
              "Service" : [ "ecs.amazonaws.com" ]
            },
            "Action" : [ "sts:AssumeRole" ]
          } ]
        },
        "ManagedPolicyArns" : [ "arn:aws:iam::aws:policy/service-role/AmazonEC2ContainerServiceRole" ],
        "Path" : "/",
        "RoleName" : {
          "Fn::Join" : [ "-", [
            { "Ref" : "AWS::StackName" },
            "ServiceRole" ]
          ]
        }
      }
    },
    "LogGroup" : {
      "Type" : "AWS::Logs::LogGroup",
      "Properties" : {
        "LogGroupName" : {
          "Fn::Join" : [ "-", [
            { "Ref" : "AWS::StackName" },
            "LogGroup" ]
          ]
        },
        "RetentionInDays" : 14
      }
    },
    "ImageResolverRole" : {
      "Type" : "AWS::IAM::Role",
      "Properties" : {
        "AssumeRolePolicyDocument" : {
          "Version" : "2012-10-17",
          "Statement" : [ {
            "Effect" : "Allow",
            "Principal" : { "Service" : "lambda.amazonaws.com" },
            "Action" : "sts:AssumeRole"
          } ]
        },
        "ManagedPolicyArns" : [ "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole" ],
        "Policies" : [ {
          "PolicyName" : { "Fn::Join" : [ "-", [ { "Ref" : "AWS::StackName" }, "ImageResolverPolicy" ] ] },
          "PolicyDocument" : {
            "Version" : "2012-10-17",
            "Statement" : [
              {
                "Effect" : "Allow",
                "Action" : [ "ecs:DescribeTaskDefinition", "ecs:DescribeServices" ],
                "Resource" : "*"
              }
            ]
          }
        } ],
        "Path" : "/",
        "RoleName" : { "Fn::Join" : [ "-", [ { "Ref" : "AWS::StackName" }, "ImageResolverRole" ] ] }
      }
    },
    "ImageResolverLogGroup" : {
      "Type" : "AWS::Logs::LogGroup",
      "Properties" : {
        "LogGroupName" : { "Fn::Join" : [ "", [ "/aws/lambda/", { "Ref" : "AWS::StackName" }, "-ImageResolver" ] ] },
        "RetentionInDays" : 14
      }
    },
    "ImageResolverFunction" : {
      "Type" : "AWS::Lambda::Function",
      "Metadata" : {
        "Note" : "Resolves the Docker image to use in the TaskDefinition. On Create it returns InitialDockerImage directly. On Update it calls ecs:DescribeServices to get the ARN of the task definition the service is actively running, then reads the image from that revision - ensuring CF always uses the currently deployed image rather than the stale value in InitialDockerImage. SkipImageResolver=true bypasses the ECS lookup and uses InitialDockerImage directly, for cases where a specific image must be forced."
      },
      "Properties" : {
        "FunctionName" : { "Fn::Join" : [ "-", [ { "Ref" : "AWS::StackName" }, "ImageResolver" ] ] },
        "Runtime" : "python3.12",
        "Handler" : "index.handler",
        "Role" : { "Fn::GetAtt" : [ "ImageResolverRole", "Arn" ] },
        "Timeout" : 30,
        "MemorySize" : 256,
        "Code" : {
          "ZipFile" : "import json\nimport urllib.request\nimport boto3\n\ndef handler(event, context):\n    physical_id = event.get('PhysicalResourceId') or event['StackId']\n    status = 'FAILED'\n    data = {}\n    try:\n        props = event['ResourceProperties']\n        old = event.get('OldResourceProperties') or {}\n        request_type = event['RequestType']\n        initial = props['InitialDockerImage']\n        if request_type == 'Delete':\n            status = 'SUCCESS'\n        elif request_type == 'Create':\n            status = 'SUCCESS'\n            data = {'Value': initial}\n            print('ImageResolver: create -> ' + initial)\n        elif props.get('SkipImageResolver', 'false').lower() == 'true':\n            status = 'SUCCESS'\n            data = {'Value': initial}\n            print('ImageResolver: SkipImageResolver=true -> ' + initial)\n        elif initial != old.get('InitialDockerImage'):\n            # InitialDockerImage wurde in diesem Update bewusst geaendert - Vorgabe respektieren.\n            # Der Stale-Rollback-Schutz greift genau dann, wenn der Parameter UNveraendert bleibt,\n            # und das war der Fall, der die Regression im August ausgeloest hat.\n            status = 'SUCCESS'\n            data = {'Value': initial}\n            print('ImageResolver: InitialDockerImage changed by operator -> ' + initial)\n        else:\n            ecs = boto3.client('ecs')\n            svc = ecs.describe_services(cluster=props['EcsCluster'], services=[props['EcsService']])\n            if not svc['services']:\n                raise ValueError(\"ECS service '\" + props['EcsService'] + \"' not found in cluster '\" + props['EcsCluster'] + \"'\")\n            task_def_arn = svc['services'][0].get('taskDefinition')\n            if not task_def_arn:\n                raise ValueError(\"No active task definition on service '\" + props['EcsService'] + \"'\")\n            td = ecs.describe_task_definition(taskDefinition=task_def_arn)\n            running = td['taskDefinition']['containerDefinitions'][0]['image']\n            status = 'SUCCESS'\n            data = {'Value': running}\n            print('ImageResolver: read from running service -> ' + running)\n    except Exception as e:\n        print('ImageResolver error: ' + str(e))\n        data = {'Error': str(e)}\n    finally:\n        try:\n            respond(event, status, data, physical_id)\n        except Exception:\n            pass\n\ndef respond(event, status, data, physical_id):\n    body = json.dumps({'Status': status, 'Reason': 'See CloudWatch logs', 'PhysicalResourceId': physical_id, 'StackId': event['StackId'], 'RequestId': event['RequestId'], 'LogicalResourceId': event['LogicalResourceId'], 'Data': data})\n    req = urllib.request.Request(event['ResponseURL'], data=body.encode('utf-8'), method='PUT', headers={'Content-Type': ''})\n    urllib.request.urlopen(req)\n"
        }
      }
    },
    "ImageResolver" : {
      "Type" : "Custom::ImageResolver",
      "Metadata" : {
        "Note" : "All parameters that should trigger the Lambda on change must be listed as Properties - ProjectToken included, even though it is NoEcho. Tested 2026-09-07 on lab-dev-ema-s: CloudFormation accepts NoEcho parameters here, passes the value to the Lambda in plaintext, and a rotation does invoke the resource because old and new values are both visible. It buys no new visibility - a change set touching this resource reports the value as **** in both BeforeContext and AfterContext, so only the Lambda event sees it, and that is reachable only by someone who can already read the token from the task definition. Added in 1.6.0 to close the 'token rotated alone' regression case. REMOVE IT AGAIN when DOPPLER_TOKEN moves to Secrets: the template enforces that by itself as long as the migration also drops the ProjectToken parameter, since the Ref would stop resolving. See TASKS.md and noecho-probe.txt."
      },
      "Properties" : {
        "ServiceToken" : { "Fn::GetAtt" : [ "ImageResolverFunction", "Arn" ] },
        "ProjectToken" : { "Ref" : "ProjectToken" },
        "EcsCluster" : { "Fn::ImportValue" : { "Fn::Sub" : "${ClusterStackName}-Ecscluster" } },
        "EcsService" : { "Fn::Join" : [ "-", [ { "Ref" : "AWS::StackName" }, "Service" ] ] },
        "InitialDockerImage" : { "Ref" : "InitialDockerImage" },
        "SkipImageResolver" : { "Ref" : "SkipImageResolver" },
        "ClusterStackName" : { "Ref" : "ClusterStackName" },
        "ListenerRuleHost" : { "Ref" : "ListenerRuleHost" },
        "ListenerRulePath" : { "Ref" : "ListenerRulePath" },
        "ListenerRulePriority" : { "Ref" : "ListenerRulePriority" },
        "TaskMemory" : { "Ref" : "TaskMemory" },
        "ServiceDesiredCount" : { "Ref" : "ServiceDesiredCount" },
        "ServiceMaxCapacity" : { "Ref" : "ServiceMaxCapacity" },
        "ECSHealthCheckGracePeriod" : { "Ref" : "ECSHealthCheckGracePeriod" },
        "ServiceTrafficPort" : { "Ref" : "ServiceTrafficPort" },
        "ServiceTrafficProtocol" : { "Ref" : "ServiceTrafficProtocol" },
        "ECSHealthCheckPath" : { "Ref" : "ECSHealthCheckPath" },
        "VolumeMountPath" : { "Ref" : "VolumeMountPath" },
        "ContainerCommand" : { "Ref" : "ContainerCommand" },
        "ProjectNameShort" : { "Ref" : "ProjectNameShort" },
        "ProjectEnv" : { "Ref" : "ProjectEnv" }
      }
    },
    "ImageRegressionGuardRole" : {
      "Type" : "AWS::IAM::Role",
      "Condition" : "EnableImageRegressionGuard",
      "Properties" : {
        "AssumeRolePolicyDocument" : {
          "Version" : "2012-10-17",
          "Statement" : [ {
            "Effect" : "Allow",
            "Principal" : { "Service" : "lambda.amazonaws.com" },
            "Action" : "sts:AssumeRole"
          } ]
        },
        "ManagedPolicyArns" : [ "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole" ],
        "Policies" : [ {
          "PolicyName" : { "Fn::Join" : [ "-", [ { "Ref" : "AWS::StackName" }, "ImageRegressionGuardPolicy" ] ] },
          "PolicyDocument" : {
            "Version" : "2012-10-17",
            "Statement" : [
              {
                "Effect" : "Allow",
                "Action" : [ "ecs:DescribeServices", "ecs:DescribeTaskDefinition", "ecr:DescribeImages" ],
                "Resource" : "*"
              },
              {
                "Effect" : "Allow",
                "Action" : "sns:Publish",
