        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": {
          "Ref": "ServiceHttp5xxTargetThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "TargetGroup",
            "Value": {
              "Fn::GetAtt": [ "Target", "TargetGroupFullName" ]
            }
          },
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::Select": [ 1, {
                "Fn::Split": [ "loadbalancer/", { "Fn::ImportValue": { "Fn::Sub": "${ClusterStackName}-LoadbalancerArn" } } ]
              } ]
            }
          }
        ],
        "TreatMissingData": "notBreaching"
      }
    },
    "BaselineHttp4xxTarget": {
      "Type": "AWS::CloudWatch::AnomalyDetector",
      "Condition": "EnableHttp4xxAnomaly",
      "Metadata": {
        "Note": "Declared explicitly rather than left to implicit creation by the alarm, so CloudFormation owns the model and deletes it with the stack, and so Configuration.ExcludedTimeRanges can be added later to keep a known incident or a load test out of the training window. Stat must match the alarm's MetricStat (Sum)."
      },
      "Properties": {
        "Namespace": "AWS/ApplicationELB",
        "MetricName": "HTTPCode_Target_4XX_Count",
        "Stat": "Sum",
        "Dimensions": [
          {
            "Name": "TargetGroup",
            "Value": {
              "Fn::GetAtt": [ "Target", "TargetGroupFullName" ]
            }
          },
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::Select": [ 1, {
                "Fn::Split": [ "loadbalancer/", { "Fn::ImportValue": { "Fn::Sub": "${ClusterStackName}-LoadbalancerArn" } } ]
              } ]
            }
          }
        ]
      }
    },
    "AlarmHttp4xxTarget": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "EnableHttp4xxAnomaly",
      "DependsOn": [ "BaselineHttp4xxTarget" ],
      "Metadata": {
        "Note": "Deviation from this service's own 4xx baseline - a scan wave, a bot hammering login, or a deployment that broke every asset path. Cannot distinguish which 4xx code or which URL, so it is a tripwire, not a diagnosis: follow up in the ALB access logs. Only the upper band is alarmed; a drop in 4xx is not interesting. No warm-up period: HTTPCode_Target_4XX_Count is published continuously and retained for 15 months, so a new detector trains on that history immediately. ServiceHttp4xxAnomalyAlarmAction still defaults to dashboard, because the alarm RATE is what is unknown - on a low-traffic service the band stays loud. Visible from day one, promoted to alert once its real trip frequency is known. Note that scanners hitting the load balancer without a matching listener rule land in the cluster-level HTTPCode_ELB_4XX_Count instead and are not covered here."
      },
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-AlarmHttp4xxTargetAnomaly"
        },
        "ActionsEnabled": { "Fn::If": [ "Http4xxAnomalyAlarmNotifies", true, false ] },
        "AlarmDescription": "Unusual volume of HTTP 4xx responses from the container, measured against a CloudWatch anomaly detection band. Investigate in the ALB access logs.",
        "AlarmActions": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${ClusterStackName}-AlertTopicArn"
            }
          }
        ],
        "ComparisonOperator": "GreaterThanUpperThreshold",
        "EvaluationPeriods": 2,
        "DatapointsToAlarm": 2,
        "ThresholdMetricId": "ad1",
        "Metrics": [
          {
            "Id": "m1",
            "ReturnData": true,
            "MetricStat": {
              "Metric": {
                "Namespace": "AWS/ApplicationELB",
                "MetricName": "HTTPCode_Target_4XX_Count",
                "Dimensions": [
                  {
                    "Name": "TargetGroup",
                    "Value": {
                      "Fn::GetAtt": [ "Target", "TargetGroupFullName" ]
                    }
                  },
                  {
                    "Name": "LoadBalancer",
                    "Value": {
                      "Fn::Select": [ 1, {
                        "Fn::Split": [ "loadbalancer/", { "Fn::ImportValue": { "Fn::Sub": "${ClusterStackName}-LoadbalancerArn" } } ]
                      } ]
                    }
                  }
                ]
              },
              "Period": 300,
              "Stat": "Sum"
            }
          },
          {
            "Id": "ad1",
            "Expression": {
              "Fn::Sub": "ANOMALY_DETECTION_BAND(m1, ${ServiceHttp4xxAnomalyBand})"
            },
            "Label": "HTTPCode_Target_4XX_Count (expected)"
          }
        ],
        "TreatMissingData": "notBreaching"
      }
    },
