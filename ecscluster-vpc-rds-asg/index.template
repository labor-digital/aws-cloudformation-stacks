    "ClusterDashboard": {
      "Type": "AWS::CloudWatch::Dashboard",
      "Properties": {
        "DashboardName": {
          "Fn::Sub": "${AWS::StackName}-Overview"
        },
        "DashboardBody": {
          "Fn::Sub": "{\"start\":\"-PT3H\",\"widgets\":[{\"type\":\"metric\",\"x\":0,\"y\":0,\"width\":12,\"height\":6,\"properties\":{\"title\":\"ECS CPU by Service\",\"view\":\"timeSeries\",\"stacked\":false,\"metrics\":[[{\"expression\":\"SEARCH('{AWS/ECS,ClusterName,ServiceName} ClusterName=\\\"${AWS::StackName}-Ecscluster\\\" MetricName=\\\"CPUUtilization\\\"','Average',300)\",\"label\":\"${!LABEL}\",\"id\":\"cpu\"}]],\"period\":300,\"stat\":\"Average\",\"region\":\"${AWS::Region}\",\"yAxis\":{\"left\":{\"min\":0,\"max\":100}}}},{\"type\":\"metric\",\"x\":12,\"y\":0,\"width\":12,\"height\":6,\"properties\":{\"title\":\"ECS Memory by Service\",\"view\":\"timeSeries\",\"stacked\":false,\"metrics\":[[{\"expression\":\"SEARCH('{AWS/ECS,ClusterName,ServiceName} ClusterName=\\\"${AWS::StackName}-Ecscluster\\\" MetricName=\\\"MemoryUtilization\\\"','Average',300)\",\"label\":\"${!LABEL}\",\"id\":\"mem\"}]],\"period\":300,\"stat\":\"Average\",\"region\":\"${AWS::Region}\",\"yAxis\":{\"left\":{\"min\":0,\"max\":100}}}},{\"type\":\"metric\",\"x\":0,\"y\":6,\"width\":12,\"height\":6,\"properties\":{\"title\":\"RDS CPU & Connections\",\"view\":\"timeSeries\",\"stacked\":false,\"metrics\":[[\"AWS/RDS\",\"CPUUtilization\",\"DBClusterIdentifier\",\"${Rdscl}\",{\"stat\":\"Average\",\"label\":\"CPU %\"}],[\"AWS/RDS\",\"DatabaseConnections\",\"DBClusterIdentifier\",\"${Rdscl}\",{\"stat\":\"Average\",\"label\":\"Connections\",\"yAxis\":\"right\"}]],\"period\":300,\"region\":\"${AWS::Region}\",\"yAxis\":{\"left\":{\"min\":0,\"max\":100,\"label\":\"CPU %\"},\"right\":{\"min\":0,\"label\":\"Connections\"}},\"annotations\":{\"horizontal\":[{\"label\":\"rds-connections alarm\",\"value\":60,\"yAxis\":\"right\"}]}}},{\"type\":\"metric\",\"x\":12,\"y\":6,\"width\":12,\"height\":6,\"properties\":{\"title\":\"VPC Rejected Connections\",\"view\":\"timeSeries\",\"stacked\":false,\"metrics\":[[\"${AWS::StackName}/VpcFlowLogs\",\"RejectedConnections\",{\"stat\":\"Sum\",\"label\":\"Rejected/5min\"}]],\"period\":300,\"region\":\"${AWS::Region}\",\"annotations\":{\"horizontal\":[{\"label\":\"Alarm threshold\",\"value\":500}]}}},{\"type\":\"alarm\",\"x\":0,\"y\":12,\"width\":24,\"height\":7,\"properties\":{\"title\":\"Cluster alarms - red = firing, grey = not created (action set to off)\",\"alarms\":[\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-AlarmWafCommonRuleSet\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-AlarmWafKnownBadInputs\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-AlarmWafSQLi\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-AlarmWafWordPress\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-AlarmWafRateLimitSourceIp\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-AlarmWafRateLimitForwardedIp\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-dns-firewall-alert-surge\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-dns-firewall-blocked\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-vpc-rejected-surge\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-rds-error\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-rds-slow-queries\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-rds-connections\",\"arn:aws:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-elb-5xx\"],\"sortBy\":\"stateUpdatedTimestamp\",\"states\":[\"ALARM\",\"INSUFFICIENT_DATA\",\"OK\"]}},{\"type\":\"log\",\"x\":0,\"y\":19,\"width\":8,\"height\":7,\"properties\":{\"title\":\"DNS Firewall - what the whitelist does not cover (14d)\",\"region\":\"${AWS::Region}\",\"view\":\"table\",\"query\":\"SOURCE '${AWS::StackName}-DnsFirewallLogs' | filter firewall_rule_action in [\\\"ALERT\\\",\\\"BLOCK\\\"] | filter query_type not in [\\\"PTR\\\"] | stats count(*) as requests by query_name, firewall_rule_action | sort requests desc | limit 20\"}},{\"type\":\"log\",\"x\":8,\"y\":19,\"width\":8,\"height\":7,\"properties\":{\"title\":\"Rejected outbound connections - signal once egress is restricted\",\"region\":\"${AWS::Region}\",\"view\":\"table\",\"query\":\"SOURCE '${AWS::StackName}-VpcFlowLogs' | stats count(*) as flows by dstAddr, dstPort, srcAddr | sort flows desc | limit 20\"}},{\"type\":\"log\",\"x\":16,\"y\":19,\"width\":8,\"height\":7,\"properties\":{\"title\":\"Slow queries (long_query_time)\",\"region\":\"${AWS::Region}\",\"view\":\"table\",\"query\":\"SOURCE '/aws/rds/cluster/${Rdscl}/slowquery' | parse @message /Query_time: (?<qt>[0-9.]+)/ | filter ispresent(qt) | sort qt desc | limit 20\"}}]}"
        }
      },
      "Metadata": {
        "Note": "The alarm widget lists alarms by constructed ARN, not by Ref: most are conditional on their *AlarmAction parameter, and a conditional Ref means an Fn::If inside this JSON string body. An alarm set to off shows as unavailable.\n\ndashboard as an alarm action sets ActionsEnabled false - it does not place the alarm here."
      }
    },
    "WafSecretPathPatterns": {
      "Type": "AWS::WAFv2::RegexPatternSet",
      "Condition": "SecretPathsActionEnabled",
      "Metadata": {
        "Note": "Six expressions, the only WebACL content we write ourselves. Expression 0 matches any dot-prefixed segment, hence the NotStatement STARTS_WITH /.well-known/ - the WAF dialect has no lookaheads. Matches UriPath after URL_DECODE and LOWERCASE. Quota ten per set, ten sets per region.\n\nconfig.json and config.yaml are deliberately absent: single-page apps fetch them at runtime. SEPARATOR RULE: between keyword and extension only dot or underscore, never a hyphen. Measurements in TASKS.md."
      },
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-secret-paths"
        },
        "Scope": "REGIONAL",
        "Description": {
          "Fn::Sub": "Paths that only credential scanners ask for - ${AWS::StackName}"
        },
        "RegularExpressionList": [
          "(^|/)\\.[a-z0-9_-]+",
          "\\.(pem|key|p12|pfx|jks|keystore|tf|tfstate|tfvars|sql|bak|old|orig|swp|dist|save)($|[.~])",
          "(^|/)(secret|secrets|secretkey|credential|credentials|creds|passwd|apikey|apikeys|api_key|api_keys)([._][a-z0-9]+)*\\.[a-z0-9]+$",
          "(^|/)(wp-config|appsettings|database|amplifyconfiguration|awsconfiguration|amplify-meta|serverless|pulumi|configmap)[a-z0-9._-]*\\.(php|ya?ml|json|py|ini|toml)$",
          "(^|/)config/[a-z0-9._/-]*\\.(php|ya?ml|py|ini|toml|env)$",
          "(^|/)(server-status|server-info|_netrc|id_rsa|id_dsa|id_ecdsa|id_ed25519)"
        ]
      }
    },
    "WafSqliExcludedPaths": {
      "Type": "AWS::WAFv2::RegexPatternSet",
      "Condition": "SqliHasPathExclusions",
      "Metadata": {
        "Note": "Scope-down NotStatement on the SQLi group, priority 40. Added for a WordPress Solr search whose query shape is indistinguishable from an auth-bypass attempt - the plugin offers no way to phrase it differently.\n\nLOWERCASE only, WITHOUT the URL_DECODE that SecretPaths uses - an exception wants the narrowest reading. Anchor every pattern with ^, an unanchored one matches anywhere in the path. Open: /solr/../x matches ^/solr/ and is exempted, whether the balancer normalises that is untested."
      },
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-sqli-excluded-paths"
        },
        "Scope": "REGIONAL",
        "RegularExpressionList": {
