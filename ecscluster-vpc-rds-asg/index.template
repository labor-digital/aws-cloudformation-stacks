    "RdsSlowQueryAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "RdsSlowQueryAlarmEnabled",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-rds-slow-queries"
