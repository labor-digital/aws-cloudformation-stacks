          ],
          "BlockDeviceMappings": [
            {
              "DeviceName": "/dev/xvda",
              "Ebs": {
                "VolumeSize": 30,
                "VolumeType": "gp3",
                "DeleteOnTermination": true
              }
            }
          ],
          "EbsOptimized": false,
          "IamInstanceProfile": {
            "Name": {
              "Ref": "InstanceroleProfile"
            }
          },
          "ImageId": "{{resolve:ssm:/aws/service/ecs/optimized-ami/amazon-linux-2023/recommended/image_id}}",
          "InstanceType": {
            "Ref": "EC2InstanceType"
          },
          "Monitoring": {
            "Enabled": true
          },
          "KeyName": {
            "Ref": "KeypairName"
          },
          "UserData": {
            "Fn::Base64": {
              "Fn::Join": [
                "",
                [
                  "#!/bin/bash\n",
                  "echo ECS_CLUSTER=",
                  {
                    "Ref": "Ecscluster"
                  },
                  " >> /etc/ecs/ecs.config\n",
                  "dnf install -y dnf-automatic\n",
                  "sed -i 's/^upgrade_type = .*/upgrade_type = security/' /etc/dnf/automatic.conf\n",
                  "sed -i 's/^apply_updates = .*/apply_updates = yes/' /etc/dnf/automatic.conf\n",
                  "systemctl enable --now dnf-automatic.timer\n"
                ]
              ]
            }
          }
        }
      },
      "DependsOn": [
        "InstanceroleProfile",
        "SgVpcMysqlAccess",
        "SgVpcLoadbalancerports",
        "SgVpcEfsAccess",
        "Ecscluster"
      ]
