  },
  "Parameters" : {
    "ClusterStackName" : {
      "Description" : "Name of the cloudformation stack of the cluster, where this service should run.",
      "Type" : "String",
      "MinLength" : 1
    },
    "ListenerRuleHost" : {
      "Description" : "Hostname for the ListenerRule.",
      "Type" : "String",
      "MinLength" : 1
    },
    "ListenerRulePath" : {
      "Description" : "PathPattern for the ListenerRule. Normally you should use * here.",
      "Type" : "String",
      "Default" : "*",
      "MinLength" : 1
    },
    "ListenerRulePriority" : {
      "Description" : "The Priority for the ListenerRule",
      "Type" : "Number",
      "MinValue" : 1
    },
    "InitialDockerImage" : {
      "Description" : "The Docker image for the container. Always required on first stack creation. On updates it is used when you change it - setting a new value here deploys exactly that image. Leave it untouched and the image the service is actually running is kept instead, which is what stops a template-only update from rolling the service back to a months-old value. SkipImageResolver=true forces this value regardless.",
      "Type" : "String",
      "MinLength" : 1
    },
    "SkipImageResolver" : {
      "Description" : "When true, InitialDockerImage is used directly. When false, the image is read from the currently running ECS task definition on stack updates, which prevents a template-only update from rolling the service back to a stale image - UNLESS you change InitialDockerImage in the same update, in which case your value wins. So: set it deliberately to deploy a specific image, leave it untouched and the running image is preserved. Default true, which is right for stack creation and while iterating on a first deployment that is not yet healthy; set false once the service runs.",
      "Type" : "String",
      "Default" : "true",
      "AllowedValues" : [ "true", "false" ]
    },
    "TaskMemory" : {
      "Type" : "Number",
      "Description" : "Memory soft limit for one task, in MiB. The allowed values are the even fractions of a t3.small's schedulable memory - full, three quarters, half, a quarter - so tasks pack onto an instance without leaving a remainder too small to place. Pick the smallest value the application tolerates: ECS places tasks by this reservation, so a larger one reduces how many fit on the cluster.",
      "Default" : 478,
      "AllowedValues" : [478, 956, 1434, 1913]
    },
    "ServiceDesiredCount" : {
      "Type" : "Number",
      "Description" : "The desired task count of this service. This number is also taken for the min count of Task-Instances (for Autoscaling). [0-4]",
      "MinValue" : 0,
      "MaxValue" : 4
    },
    "ServiceMaxCapacity" : {
      "Type" : "Number",
      "Description" : "The max count of Task-Instances (for Autoscaling). [1-10]",
      "MinValue" : 1,
      "MaxValue" : 10
    },
    "ECSHealthCheckGracePeriod" : {
      "Description" : "The number in seconds ECS waits for the container to initialize before it kills the instance because of \"poor health\".",
      "Default": "0",
      "Type" : "Number"
    },
    "ServiceTrafficPort": {
      "Description" : "Port on which the docker container is serving content. This one is also used for the health check.",
      "Default" : "443",
      "Type" : "Number",
      "AllowedValues" : ["80", "443", "3000", "8000", "8001", "8080", "8443", "8983"]
    },
    "ServiceTrafficProtocol": {
      "Description" : "Protocol on which the docker container is serving content. This one is also used for the health check.",
      "Default" : "HTTPS",
      "Type" : "String",
      "AllowedValues" : ["HTTP", "HTTPS"]
    },
    "ECSHealthCheckPath": {
      "Description" : "Path to use for health check.",
      "Default" : "/test.php",
      "Type" : "String"
    },
    "VolumeMountPath": {
      "Description" : "Path in the container, where the EFS-Volume should be mounted",
      "Default" : "/var/www/html_data",
      "Type" : "String"
    },
    "ProjectNameShort": {
      "Description" : "Project name in our shorthand version with underscores (e.g. kun_pro_app). This one is used to identify the doppler project to fetch secrets from.",
      "Type" : "String",
      "AllowedPattern" : "[a-z]{3}_[a-z]{3}_[a-z]{3}"
    },
    "ProjectEnv": {
      "Description" : "The environment in which this project should run. This one is also used to determine the correct doppler config to fetch secrets from. But it may be used in the code as well. So, unless you really know what you're doing, keep the default 'prd' - or 'stg' for staging environments.",
      "Default" : "prd",
      "Type" : "String"
    },
    "ProjectToken": {
      "Description" : "Doppler token used to fetch secrets. Use service tokens only - they carry read access alone. Never a personal or any other token. Rotating this on its own is safe from 1.6.0 on: the parameter is a property of the image resolver, so a rotation re-triggers it and the running image is kept. Up to 1.5.0 a standalone rotation silently reverted the container image to whatever InitialDockerImage still held, which could be months old - on those versions rotate together with a fresh InitialDockerImage set to the currently-running image. The ImageRegressionGuard reports a revert either way.",
      "AllowedPattern" : "dp\\.st\\.[a-zA-Z_]*\\.[a-zA-Z0-9]{43}",
      "NoEcho" : "true",
      "Type" : "String"
    },
    "ContainerCommand": {
      "Type": "String",
      "Default": "",
      "Description": "Command to run in the container as a comma-separated list, e.g., python,app.py,--env,prod. Leave empty to use the image default."
    },
    "ServiceScaleUpCpuThreshold": {
      "Type": "Number",
      "Description": "CPU utilization (percent) above which the service scales up by one task.",
      "Default": 65,
      "MinValue": 10,
      "MaxValue": 100
    },
    "ServiceScaleDownCpuThreshold": {
      "Type": "Number",
      "Description": "CPU utilization (percent) below which the service scales down by one task - only acts while more tasks than ServiceDesiredCount are running. Must be lower than ServiceScaleUpCpuThreshold.",
      "Default": 15,
      "MinValue": 1,
      "MaxValue": 90
    },
    "ServiceHighCpuThreshold": {
      "Type": "Number",
      "Description": "CPU utilization threshold (percent) for AlarmHighCpu, which fires when the service average stays above this value for 5 minutes. Whether the alarm exists and whether it notifies is set by ServiceHighCpuAlarmAction, not by this value. Note the relationship to autoscaling: ServiceScaleUpCpuThreshold reads the same metric, so a value well below it makes this an early warning that fires before scaling engages, which is the intent on a fleet whose baseline is under one percent.",
      "Default": 20,
      "MinValue": 0,
      "MaxValue": 100
    },
    "ServiceHighMemoryThreshold": {
      "Type": "Number",
      "Description": "Memory utilization threshold (percent) for AlarmHighMemory, which fires when the service average stays above this value for 5 minutes. Whether the alarm exists and whether it notifies is set by ServiceHighMemoryAlarmAction, not by this value.",
      "Default": 80,
      "MinValue": 0,
      "MaxValue": 100
    },
    "ServiceLowCpuThreshold": {
      "Type": "Number",
      "Description": "CPU utilization threshold (percent) for AlarmLowCpu, which fires when the service average stays BELOW this value - a way to notice a service that has stopped receiving traffic. Whether the alarm exists is set by ServiceLowCpuAlarmAction, which defaults to off. Leaving this at 0 while switching the alarm on creates an alarm that can never fire, since CPU is never below zero: pick a real value first.",
      "Default": 0,
      "MinValue": 0,
      "MaxValue": 50
    },
    "ServiceLowMemoryThreshold": {
      "Type": "Number",
      "Description": "Memory utilization threshold (percent) for AlarmLowMemory, which fires when the service average stays BELOW this value. Whether the alarm exists is set by ServiceLowMemoryAlarmAction, which defaults to off. As with ServiceLowCpuThreshold, a value of 0 makes the alarm unable to fire rather than disabled.",
      "Default": 0,
      "MinValue": 0,
      "MaxValue": 70
    },
    "ServiceHttp5xxTargetThreshold": {
      "Type": "Number",
      "Description": "Number of HTTP 5xx responses returned by the container per 5 minutes that triggers an alarm. These are errors the application itself produced (PHP fatal, TYPO3 exception, failed DB connection) and are visible in the log group. Whether the alarm exists and whether it notifies is set by ServiceHttp5xxTargetAlarmAction, not by this value - so 0 here means 'alarm on any 5xx', which is a legitimate setting and no longer a way to switch the alarm off.",
      "Default": 5,
      "MinValue": 0,
      "MaxValue": 10000
    },
    "ServiceHighCpuAlarmAction": {
      "Type": "String",
      "Description": "Notification level for AlarmHighCpu (average service CPU above ServiceHighCpuThreshold for 5 minutes). off = the alarm is not created at all. dashboard = the alarm exists and its state is visible in the console and on dashboards, but ActionsEnabled is false so nothing reaches the alert topic. alert = the alarm also notifies the cluster AlertTopic. Defaults to dashboard: measured across 15 Paris services, this alarm has never fired, so it is worth having and not worth mailing until that changes.",
      "Default": "dashboard",
      "AllowedValues": [ "off", "dashboard", "alert" ]
    },
    "ServiceHighMemoryAlarmAction": {
      "Type": "String",
      "Description": "Notification level for AlarmHighMemory (average service memory above ServiceHighMemoryThreshold for 5 minutes). off = the alarm is not created at all. dashboard = the alarm exists and its state is visible in the console and on dashboards, but ActionsEnabled is false so nothing reaches the alert topic. alert = the alarm also notifies the cluster AlertTopic. Defaults to dashboard: it fires occasionally (three times across 15 Paris services), so calibrate per service before promoting it.",
      "Default": "dashboard",
      "AllowedValues": [ "off", "dashboard", "alert" ]
    },
    "ServiceLowCpuAlarmAction": {
      "Type": "String",
      "Description": "Notification level for AlarmLowCpu (average service CPU BELOW ServiceLowCpuThreshold), a way to notice a service that has stopped receiving traffic. off = the alarm is not created at all. dashboard = the alarm exists with ActionsEnabled false (state and history only). alert = it also notifies the cluster AlertTopic. Defaults to off, and deliberately so: ServiceLowCpuThreshold defaults to 0, and an alarm asking whether CPU is below zero can never fire. Set a real threshold first, otherwise the alarm only looks like coverage.",
      "Default": "off",
      "AllowedValues": [ "off", "dashboard", "alert" ]
    },
    "ServiceLowMemoryAlarmAction": {
      "Type": "String",
      "Description": "Notification level for AlarmLowMemory (average service memory BELOW ServiceLowMemoryThreshold). off = the alarm is not created at all. dashboard = the alarm exists with ActionsEnabled false (state and history only). alert = it also notifies the cluster AlertTopic. Defaults to off for the same reason as ServiceLowCpuAlarmAction: with the threshold at its default of 0 the alarm cannot fire, so creating it would be misleading rather than useful.",
      "Default": "off",
      "AllowedValues": [ "off", "dashboard", "alert" ]
    },
    "ServiceHttp5xxTargetAlarmAction": {
      "Type": "String",
      "Description": "Notification level for AlarmHttp5xxTarget (HTTP 5xx responses from this service's target group above ServiceHttp5xxTargetThreshold within 5 minutes). off = the alarm is not created at all. dashboard = the alarm exists with ActionsEnabled false (state and history only). alert = it also notifies the cluster AlertTopic. This is the only service alarm that has found anything in practice, so promoting it to alert is usually the first thing worth doing once its threshold fits the service.",
      "Default": "dashboard",
      "AllowedValues": [ "off", "dashboard", "alert" ]
    },
    "ServiceHttp4xxAnomalyAlarmAction": {
      "Type": "String",
      "Description": "Notification level for AlarmHttp4xxTarget, which flags unusual volumes of HTTP 4xx responses (scans, brute force, or a deployment that broke asset paths) using a CloudWatch anomaly detection band instead of a fixed threshold. off = the alarm is not created at all. dashboard = the alarm exists with ActionsEnabled false (state and history only). alert = it also notifies the cluster AlertTopic. Defaults to dashboard rather than off, but not as a training period: HTTPCode_Target_4XX_Count is published continuously and retained for 15 months, so a new detector trains on that history at once and the band is meaningful from the start on a service that has traffic. The reason for dashboard is that the resulting alarm rate is unknown, and on low-traffic services such a band stays loud. Let it run visibly for a while, then promote it to alert once you have seen how often it actually trips. Anomaly alarms cost about three times a standard alarm.",
      "Default": "dashboard",
      "AllowedValues": [ "off", "dashboard", "alert" ]
    },
    "ServiceHttp4xxAnomalyBand": {
      "Type": "Number",
      "Description": "Width of the anomaly detection band for HTTP 4xx, in standard deviations. Higher is more conservative (fewer alarms). Only used when ServiceHttp4xxAnomalyAlarmAction is not off.",
      "Default": 3,
      "MinValue": 1,
      "MaxValue": 8
    },
    "EnableImageRegressionAlarm": {
      "Type": "String",
      "Description": "Alert when a deployment rolls out a container image that is OLDER than the one it replaces - a stale CloudFormation image revert (a template change that rewrites the task definition without waking the resolver, or a failed update rolling back) or an accidental redeploy of an old build. The token-rotation case that used to be the textbook example is gone from 1.6.0 on, since ProjectToken became a resolver property. On every deployment the guard compares the ECR push time of the incoming image against the outgoing one and publishes to the cluster AlertTopic if it went backwards; deploying the same or a newer image is silent. Region and account are taken from the image reference, so repositories in another region than the cluster are handled. Images outside ECR (e.g. a Docker Hub tag) carry no push time and are skipped - such services get no regression check at all. Detective, not preventive: it fires as the rollout starts, so it pairs with the deployment circuit breaker. Defaults to true; set to false to disable.",
      "Default": "true",
      "AllowedValues": [
        "true",
        "false"
      ]
    }
  },
  "Conditions": {
    "HasContainerCommand": {
      "Fn::Not": [
        { "Fn::Equals": [ { "Ref": "ContainerCommand" }, "" ] }
      ]
    },
    "EnableHighCpuAlarm": {
      "Fn::Not": [ { "Fn::Equals": [ { "Ref": "ServiceHighCpuAlarmAction" }, "off" ] } ]
    },
    "HighCpuAlarmNotifies": {
      "Fn::Equals": [ { "Ref": "ServiceHighCpuAlarmAction" }, "alert" ]
    },
    "EnableHighMemoryAlarm": {
