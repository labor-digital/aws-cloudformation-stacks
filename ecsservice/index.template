      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-AlarmHighMemory"
        },
        "AlarmDescription": "Service memory utilization exceeds threshold — possible memory leak or insufficient allocation.",
        "MetricName": "MemoryUtilization",
        "Namespace": "AWS/ECS",
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": {"Ref": "ServiceHighMemoryThreshold"},
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "ServiceName",
            "Value": {"Fn::GetAtt": ["Service", "Name"]}
          },
          {
            "Name": "ClusterName",
            "Value": {
              "Fn::ImportValue": {
                "Fn::Sub": "${ClusterStackName}-Ecscluster"
              }
            }
          }
        ],
        "TreatMissingData": "notBreaching"
      }
    },
    "ServiceLowCpuAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "EnableLowCpuAlarm",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-AlarmLowCpu"
        },
        "AlarmDescription": "Service CPU utilization is chronically low — possible overprovisioning or underutilization.",
        "MetricName": "CPUUtilization",
        "Namespace": "AWS/ECS",
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": {"Ref": "ServiceLowCpuThreshold"},
        "ComparisonOperator": "LessThanThreshold",
        "Dimensions": [
          {
            "Name": "ServiceName",
            "Value": {"Fn::GetAtt": ["Service", "Name"]}
          },
          {
            "Name": "ClusterName",
            "Value": {
              "Fn::ImportValue": {
                "Fn::Sub": "${ClusterStackName}-Ecscluster"
              }
            }
          }
        ],
        "TreatMissingData": "notBreaching"
      }
    },
    "ServiceLowMemoryAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "EnableLowMemoryAlarm",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-AlarmLowMemory"
        },
        "AlarmDescription": "Service memory utilization is chronically low — possible overprovisioning or consolidation candidate.",
        "MetricName": "MemoryUtilization",
        "Namespace": "AWS/ECS",
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": {"Ref": "ServiceLowMemoryThreshold"},
        "ComparisonOperator": "LessThanThreshold",
        "Dimensions": [
          {
            "Name": "ServiceName",
            "Value": {"Fn::GetAtt": ["Service", "Name"]}
          },
          {
            "Name": "ClusterName",
            "Value": {
              "Fn::ImportValue": {
                "Fn::Sub": "${ClusterStackName}-Ecscluster"
              }
            }
          }
        ],
        "TreatMissingData": "notBreaching"
      }
    }
