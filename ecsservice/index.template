    "ImageResolverFunction" : {
      "Type" : "AWS::Lambda::Function",
      "Metadata" : {
        "Note" : "Resolves the Docker image to use in the TaskDefinition. On Create it returns InitialDockerImage directly. On Update it calls ecs:DescribeServices to get the ARN of the task definition the service is actively running, then reads the image from that revision - ensuring CF always uses the currently deployed image rather than the stale value in InitialDockerImage. SkipImageResolver=true bypasses the ECS lookup and uses InitialDockerImage directly, for cases where a specific image must be forced."
      },
      "Properties" : {
        "FunctionName" : { "Fn::Join" : [ "-", [ { "Ref" : "AWS::StackName" }, "ImageResolver" ] ] },
        "Runtime" : "python3.12",
        "Handler" : "index.handler",
        "Role" : { "Fn::GetAtt" : [ "ImageResolverRole", "Arn" ] },
        "Timeout" : 30,
        "MemorySize" : 256,
        "Code" : {
          "ZipFile" : "import json\nimport urllib.request\nimport boto3\n\ndef handler(event, context):\n    physical_id = event.get('PhysicalResourceId') or event['StackId']\n    status = 'FAILED'\n    data = {}\n    try:\n        props = event['ResourceProperties']\n        old = event.get('OldResourceProperties') or {}\n        request_type = event['RequestType']\n        initial = props['InitialDockerImage']\n        if request_type == 'Delete':\n            status = 'SUCCESS'\n        elif request_type == 'Create':\n            status = 'SUCCESS'\n            data = {'Value': initial}\n            print('ImageResolver: create -> ' + initial)\n        elif props.get('SkipImageResolver', 'false').lower() == 'true':\n            status = 'SUCCESS'\n            data = {'Value': initial}\n            print('ImageResolver: SkipImageResolver=true -> ' + initial)\n        elif initial != old.get('InitialDockerImage'):\n            # InitialDockerImage wurde in diesem Update bewusst geaendert - Vorgabe respektieren.\n            # Der Stale-Rollback-Schutz greift genau dann, wenn der Parameter UNveraendert bleibt,\n            # und das war der Fall, der die Regression im August ausgeloest hat.\n            status = 'SUCCESS'\n            data = {'Value': initial}\n            print('ImageResolver: InitialDockerImage changed by operator -> ' + initial)\n        else:\n            ecs = boto3.client('ecs')\n            svc = ecs.describe_services(cluster=props['EcsCluster'], services=[props['EcsService']])\n            if not svc['services']:\n                raise ValueError(\"ECS service '\" + props['EcsService'] + \"' not found in cluster '\" + props['EcsCluster'] + \"'\")\n            task_def_arn = svc['services'][0].get('taskDefinition')\n            if not task_def_arn:\n                raise ValueError(\"No active task definition on service '\" + props['EcsService'] + \"'\")\n            td = ecs.describe_task_definition(taskDefinition=task_def_arn)\n            running = td['taskDefinition']['containerDefinitions'][0]['image']\n            status = 'SUCCESS'\n            data = {'Value': running}\n            print('ImageResolver: read from running service -> ' + running)\n    except Exception as e:\n        print('ImageResolver error: ' + str(e))\n        data = {'Error': str(e)}\n    finally:\n        try:\n            respond(event, status, data, physical_id)\n        except Exception:\n            pass\n\ndef respond(event, status, data, physical_id):\n    body = json.dumps({'Status': status, 'Reason': 'See CloudWatch logs', 'PhysicalResourceId': physical_id, 'StackId': event['StackId'], 'RequestId': event['RequestId'], 'LogicalResourceId': event['LogicalResourceId'], 'Data': data})\n    req = urllib.request.Request(event['ResponseURL'], data=body.encode('utf-8'), method='PUT', headers={'Content-Type': ''})\n    urllib.request.urlopen(req)\n"
        }
      }
    },
