    "CommonRuleSetSurgeAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "CommonRuleSetAlarmEnabled",
      "Metadata": {
        "Note": "Per-rule WAF surge alarm. MetricName follows the rule's own mode through CommonRuleSetActionCounts: CountedRequests while the rule only counts, BlockedRequests once it enforces - so the alarm is meaningful during the counting weeks and after promotion, with a single threshold. Dimensioned on this one Rule, so the notification names the rule that fired; that is what tells an attack apart from a rule misfiring, which a Rule=ALL alarm cannot do."
      },
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-AlarmWafCommonRuleSet"
        },
        "AlarmDescription": "Surge in WAF matches for rule AWSManagedRulesCommonRuleSet on the ALB WebACL. Watches CountedRequests while the rule counts and BlockedRequests once it blocks.",
        "ActionsEnabled": {
          "Fn::If": [
            "CommonRuleSetAlarmAlerts",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "Namespace": "AWS/WAFV2",
        "MetricName": {
          "Fn::If": [
            "CommonRuleSetActionCounts",
            "CountedRequests",
            "BlockedRequests"
          ]
        },
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": {
          "Ref": "CommonRuleSetAlarmThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "WebACL",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-waf"
            }
          },
          {
            "Name": "Region",
            "Value": {
              "Ref": "AWS::Region"
            }
          },
          {
            "Name": "Rule",
            "Value": "AWSManagedRulesCommonRuleSet"
          }
        ],
        "TreatMissingData": "notBreaching"
      }
    },
