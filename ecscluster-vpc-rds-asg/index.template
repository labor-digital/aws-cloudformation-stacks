        "Note": "Statistic Maximum, not Sum: DatabaseConnections is a gauge, so summing a period gives a meaningless multiple.\n\nDimensioned on the writer instance, where max_connections applies. Namespace AWS/RDS, unlike the RdsError and RdsSlowQuery alarms, which read metric filters over exported logs."
      }
    },
    "ElbHttp5xxAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "ElbHttp5xxAlarmEnabled",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-elb-5xx"
        },
        "ActionsEnabled": {
          "Fn::If": [
            "ElbHttp5xxAlarmAlerts",
            true,
            false
          ]
        },
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ],
        "AlarmDescription": {
          "Fn::Sub": "More than ${ElbHttp5xxAlarmThreshold} load-balancer-generated 5xx in 5 minutes: 503 no healthy target, 502 malformed or aborted response, 504 target timeout. This is what a visitor sees when a service stops answering, and it is invisible to the per-service target-5xx alarms. Cluster-wide - correlate with HTTPCode_Target_5XX_Count and UnHealthyHostCount per target group to find the service."
        },
        "Namespace": "AWS/ApplicationELB",
        "MetricName": "HTTPCode_ELB_5XX_Count",
        "Dimensions": [
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::Select": [
                1,
                {
                  "Fn::Split": [
                    "loadbalancer/",
                    {
                      "Ref": "Loadbalancer"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": {
          "Ref": "ElbHttp5xxAlarmThreshold"
        },
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      },
      "Metadata": {
        "Note": "HTTPCode_ELB_5XX_Count carries LoadBalancer and AvailabilityZone dimensions only - no TargetGroup - so this cannot live in ecsservice next to AlarmHttp5xxTarget.\n\nCounts 502, 503 and 504 the balancer produced itself; a 5xx from the container is HTTPCode_Target_5XX_Count."
      }
    },
    "RdsSlowQuerySummaryQuery": {
