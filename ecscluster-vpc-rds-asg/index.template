          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-dns-whitelist"
            }
          },
          {
            "Key": "security-owner",
            "Value": "network-sec"
          }
        ]
      }
    },
    "DnsFirewallCatchAllDomainList": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-catch-all"
        },
        "Domains": [
          "*"
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-dns-catch-all"
            }
          },
          {
            "Key": "security-owner",
            "Value": "network-sec"
          }
        ]
      }
    },
    "DnsFirewallRuleGroup": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-egress-control"
        },
        "FirewallRules": [
          {
            "Priority": 100,
            "FirewallDomainListId": {
              "Ref": "DnsFirewallWhitelistDomainList"
            },
            "Action": "ALLOW"
          },
          {
            "Priority": 200,
            "FirewallDomainListId": {
              "Ref": "DnsFirewallCatchAllDomainList"
            },
            "Action": "ALERT"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-egress-control"
            }
          },
          {
            "Key": "security-owner",
            "Value": "network-sec"
          }
        ]
      }
    },
    "DnsFirewallRuleGroupAssociation": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroupAssociation",
      "Properties": {
        "FirewallRuleGroupId": {
          "Ref": "DnsFirewallRuleGroup"
        },
        "VpcId": {
          "Ref": "Vpc"
        },
        "Priority": 200,
        "MutationProtection": "DISABLED",
        "Name": {
          "Fn::Sub": "${AWS::StackName}-vpc-association"
        },
        "Tags": [
          {
            "Key": "security-owner",
            "Value": "network-sec"
          }
        ]
      }
    },
    "DnsQueryLoggingConfig": {
      "Type": "AWS::Route53Resolver::ResolverQueryLoggingConfig",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-dns-query-logging"
        },
        "DestinationArn": {
          "Fn::GetAtt": ["DnsQueryLogGroup", "Arn"]
        }
      }
    },
    "DnsQueryLoggingConfigAssociation": {
      "Type": "AWS::Route53Resolver::ResolverQueryLoggingConfigAssociation",
      "Properties": {
        "ResolverQueryLogConfigId": {
          "Ref": "DnsQueryLoggingConfig"
        },
        "ResourceId": {
          "Ref": "Vpc"
        }
      }
    },
    "DnsFirewallAlertMetricFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "DnsQueryLogGroup"
        },
        "FilterPattern": "{ $.firewall_rule_action = \"ALERT\" }",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "${AWS::StackName}/DnsFirewall"
            },
            "MetricName": "AlertedQueries",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "DnsFirewallWhitelistCandidatesQuery": {
      "Type": "AWS::Logs::QueryDefinition",
      "DependsOn": "DnsQueryLogGroup",
      "Properties": {
        "Name": "DnsFireWallLogsSummary",
        "QueryString": {
          "Fn::Sub": "SOURCE logGroups(logGroupName: \"${AWS::StackName}-DnsFirewallLogs\") START=-1209600s END=0s\n| fields query_name, query_type, srcaddr\n| filter firewall_rule_action = \"ALERT\"\n| filter query_type not in [\"PTR\"]\n| stats count(*) as requests by query_name, query_type\n| sort requests desc\n| limit 500"
        }
      }
    },
    "DnsFirewallAlertAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-dns-firewall-alert-surge"
        },
        "AlarmDescription": "Unusual spike in DNS Firewall ALERT events - review DnsFirewallLogs for unexpected external service access",
        "Namespace": {
          "Fn::Sub": "${AWS::StackName}/DnsFirewall"
        },
        "MetricName": "AlertedQueries",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 100,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "VpcFlowLogsRejectedMetricFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "VpcFlowLogGroup"
        },
        "FilterPattern": "[version, account_id, interface_id, srcaddr, dstaddr, srcport, dstport, protocol, packets, bytes, start, end, action=REJECT, log_status]",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "${AWS::StackName}/VpcFlowLogs"
            },
            "MetricName": "RejectedConnections",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "VpcFlowLogsRejectedAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-vpc-rejected-surge"
        },
        "AlarmDescription": "Unusual spike in rejected VPC connections - potential port scan or misconfigured service. Review VpcFlowLogsRejectedTraffic Logs Insights query.",
        "Namespace": {
          "Fn::Sub": "${AWS::StackName}/VpcFlowLogs"
        },
        "MetricName": "RejectedConnections",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 500,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "VpcFlowLogsRejectedTrafficQuery": {
      "Type": "AWS::Logs::QueryDefinition",
      "DependsOn": "VpcFlowLogGroup",
      "Properties": {
        "Name": "VpcFlowLogsRejectedTraffic",
        "QueryString": {
          "Fn::Sub": "SOURCE logGroups(logGroupName: \"${VpcFlowLogGroup}\") START=-3600s END=0s\n| fields @timestamp, @message\n| parse @message \"* * * * * * * * * * * * * *\" as version, account, eni, srcaddr, dstaddr, srcport, dstport, protocol, packets, bytes, startTime, endTime, action, status\n| filter action = \"REJECT\"\n| stats count(*) as rejects by srcaddr, dstport\n| sort rejects desc\n| limit 50"
        }
      }
    },
    "RdsErrorMetricFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "RdsErrorLogGroup"
        },
        "FilterPattern": "\"[ERROR]\"",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "${AWS::StackName}/RDS"
            },
            "MetricName": "ErrorCount",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "RdsErrorAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-rds-error"
        },
        "AlarmDescription": "RDS Aurora error log contains [ERROR] entries. Review RdsErrorLogSummary Logs Insights query for details.",
        "Namespace": {
          "Fn::Sub": "${AWS::StackName}/RDS"
        },
        "MetricName": "ErrorCount",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "RdsErrorLogSummaryQuery": {
      "Type": "AWS::Logs::QueryDefinition",
      "DependsOn": "RdsErrorLogGroup",
      "Properties": {
        "Name": "RdsErrorLogSummary",
        "QueryString": {
          "Fn::Sub": "SOURCE logGroups(logGroupName: \"${RdsErrorLogGroup}\") START=-86400s END=0s\n| fields @timestamp, @message\n| filter @message like /\\[ERROR\\]|\\[Warning\\]/\n| sort @timestamp desc\n| limit 100"
        }
      }
    },
    "RdsSlowQueryMetricFilter": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "RdsSlowQueryLogGroup"
        },
        "FilterPattern": "\"# Query_time\"",
        "MetricTransformations": [
          {
            "MetricNamespace": {
              "Fn::Sub": "${AWS::StackName}/RDS"
            },
            "MetricName": "SlowQueryCount",
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "RdsSlowQueryAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "${AWS::StackName}-rds-slow-queries"
        },
        "AlarmDescription": "More than 5 slow queries (>10s) in 5 minutes. Review RdsSlowQuerySummary Logs Insights query.",
        "Namespace": {
          "Fn::Sub": "${AWS::StackName}/RDS"
        },
        "MetricName": "SlowQueryCount",
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 5,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "RdsSlowQuerySummaryQuery": {
      "Type": "AWS::Logs::QueryDefinition",
      "DependsOn": "RdsSlowQueryLogGroup",
      "Properties": {
        "Name": "RdsSlowQuerySummary",
        "QueryString": {
          "Fn::Sub": "SOURCE logGroups(logGroupName: \"${RdsSlowQueryLogGroup}\") START=-86400s END=0s\n| fields @timestamp, @message\n| filter @message like /# Query_time/\n| parse @message \"# Query_time: * Lock_time: * Rows_sent: * Rows_examined: *\" as query_time, lock_time, rows_sent, rows_examined\n| sort query_time desc\n| limit 50"
        }
      }
    },
    "ClusterDashboard": {
      "Type": "AWS::CloudWatch::Dashboard",
      "Properties": {
        "DashboardName": {
          "Fn::Sub": "${AWS::StackName}-Overview"
        },
        "DashboardBody": {
          "Fn::Sub": "{\"start\":\"-PT3H\",\"widgets\":[{\"type\":\"metric\",\"x\":0,\"y\":0,\"width\":12,\"height\":6,\"properties\":{\"title\":\"ECS CPU by Service\",\"view\":\"timeSeries\",\"stacked\":false,\"metrics\":[[{\"expression\":\"SEARCH('{AWS/ECS,ClusterName,ServiceName} ClusterName=\\\"${AWS::StackName}-Ecscluster\\\" MetricName=\\\"CPUUtilization\\\"','Average',300)\",\"label\":\"${!LABEL}\",\"id\":\"cpu\"}]],\"period\":300,\"stat\":\"Average\",\"region\":\"${AWS::Region}\",\"yAxis\":{\"left\":{\"min\":0,\"max\":100}}}},{\"type\":\"metric\",\"x\":12,\"y\":0,\"width\":12,\"height\":6,\"properties\":{\"title\":\"ECS Memory by Service\",\"view\":\"timeSeries\",\"stacked\":false,\"metrics\":[[{\"expression\":\"SEARCH('{AWS/ECS,ClusterName,ServiceName} ClusterName=\\\"${AWS::StackName}-Ecscluster\\\" MetricName=\\\"MemoryUtilization\\\"','Average',300)\",\"label\":\"${!LABEL}\",\"id\":\"mem\"}]],\"period\":300,\"stat\":\"Average\",\"region\":\"${AWS::Region}\",\"yAxis\":{\"left\":{\"min\":0,\"max\":100}}}},{\"type\":\"metric\",\"x\":0,\"y\":6,\"width\":12,\"height\":6,\"properties\":{\"title\":\"RDS CPU & Connections\",\"view\":\"timeSeries\",\"stacked\":false,\"metrics\":[[\"AWS/RDS\",\"CPUUtilization\",\"DBClusterIdentifier\",\"${Rdscl}\",{\"stat\":\"Average\",\"label\":\"CPU %\"}],[\"AWS/RDS\",\"DatabaseConnections\",\"DBClusterIdentifier\",\"${Rdscl}\",{\"stat\":\"Average\",\"label\":\"Connections\",\"yAxis\":\"right\"}]],\"period\":300,\"region\":\"${AWS::Region}\",\"yAxis\":{\"left\":{\"min\":0,\"max\":100,\"label\":\"CPU %\"},\"right\":{\"min\":0,\"label\":\"Connections\"}}}},{\"type\":\"metric\",\"x\":12,\"y\":6,\"width\":12,\"height\":6,\"properties\":{\"title\":\"VPC Rejected Connections\",\"view\":\"timeSeries\",\"stacked\":false,\"metrics\":[[\"${AWS::StackName}/VpcFlowLogs\",\"RejectedConnections\",{\"stat\":\"Sum\",\"label\":\"Rejected/5min\"}]],\"period\":300,\"region\":\"${AWS::Region}\",\"annotations\":{\"horizontal\":[{\"label\":\"Alarm threshold\",\"value\":500}]}}}]}"
        }
      }
    }
  },
