        "Namespace": "AWS/ECS",
        "Statistic": "Average",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": {"Ref": "ServiceHighCpuThreshold"},
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "ServiceName",
            "Value": {"Fn::GetAtt": ["Service", "Name"]}
          },
          {
            "Name": "ClusterName",
            "Value": {
              "Fn::ImportValue": {
                "Fn::Sub": "${ClusterStackName}-Ecscluster"
              }
            }
          }
        ],
        "TreatMissingData": "notBreaching"
      }
