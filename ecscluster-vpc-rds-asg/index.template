            "CertificateArn": {
              "Ref": "HttpsdefaultlistenerCertificate"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "Deftarget"
            }
          }
        ],
        "LoadBalancerArn": {
          "Ref": "Loadbalancer"
        },
        "Port": 443,
        "Protocol": "HTTPS"
      },
      "DependsOn": [
        "Deftarget",
        "Loadbalancer"
      ]
    },
    "BackupRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "backup.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSBackupServiceRolePolicyForBackup"
        ],
        "Path": "/",
        "RoleName": {
          "Fn::Join": [
            "-",
            [
              {
                "Ref": "AWS::StackName"
              },
              "BackupRole"
            ]
          ]
        }
      }
    },
    "BackupVault": {
      "Type": "AWS::Backup::BackupVault",
      "Properties": {
        "BackupVaultName": {
          "Fn::Join": [
            "-",
            [
              {
                "Ref": "AWS::StackName"
              },
              "BackupVault"
            ]
          ]
        }
      }
    },
    "BackupLongTermVault": {
      "Type": "AWS::Backup::BackupVault",
      "Properties": {
        "BackupVaultName": {
          "Fn::Join": [
            "-",
            [
              {
                "Ref": "AWS::StackName"
              },
              "BackupLongTermVault"
            ]
          ]
        }
      }
    },
    "BackupPlan": {
      "Type": "AWS::Backup::BackupPlan",
      "Properties": {
        "BackupPlan": {
          "BackupPlanName": {
            "Fn::Join": [
              "-",
              [
                {
                  "Ref": "AWS::StackName"
                },
                "BackupPlan"
              ]
            ]
          },
          "BackupPlanRule": [
            {
              "Lifecycle": {
                "DeleteAfterDays": 35
              },
              "RuleName": {
                "Fn::Join": [
                  "-",
                  [
                    {
                      "Ref": "AWS::StackName"
                    },
                    "BackupPlanRule"
                  ]
                ]
              },
              "ScheduleExpression": "cron(30 0/6 ? * * *)",
              "StartWindowMinutes": 120,
              "CompletionWindowMinutes": 360,
              "TargetBackupVault": {
                "Ref": "BackupVault"
              },
              "CopyActions": {
                "Fn::If": [
                  "EnableCrossRegionCopy",
                  [
                    {
                      "DestinationBackupVaultArn": {
                        "Fn::Sub": "arn:aws:backup:${BackupCopyDestinationRegion}:${AWS::AccountId}:backup-vault:${AWS::StackName}-BackupVault-Mirror"
                      }
                    }
                  ],
                  { "Ref": "AWS::NoValue" }
                ]
              }
            },
            {
              "Lifecycle": {
                "DeleteAfterDays": 365
              },
              "RuleName": {
                "Fn::Join": [
                  "-",
                  [
                    {
                      "Ref": "AWS::StackName"
                    },
                    "BackupLongTermPlanRule"
                  ]
                ]
              },
              "ScheduleExpression": "cron(0 5 ? * 1 *)",
              "StartWindowMinutes": 120,
              "CompletionWindowMinutes": 360,
              "TargetBackupVault": {
                "Ref": "BackupLongTermVault"
              },
              "CopyActions": {
                "Fn::If": [
                  "EnableCrossRegionCopy",
                  [
                    {
                      "DestinationBackupVaultArn": {
                        "Fn::Sub": "arn:aws:backup:${BackupCopyDestinationRegion}:${AWS::AccountId}:backup-vault:${AWS::StackName}-BackupLongTermVault-Mirror"
                      }
                    }
                  ],
                  { "Ref": "AWS::NoValue" }
                ]
              }
            }
          ]
        }
      },
      "DependsOn": [
        "BackupVault"
      ]
    },
    "BackupSelectionEfs": {
      "Type": "AWS::Backup::BackupSelection",
      "Properties": {
        "BackupPlanId": {
          "Ref": "BackupPlan"
        },
        "BackupSelection": {
          "SelectionName": {
            "Fn::Join": [
              "-",
              [
                {
                  "Ref": "AWS::StackName"
                },
                "BackupSelectionEfs"
              ]
            ]
          },
          "IamRoleArn": {
            "Fn::GetAtt": [
              "BackupRole",
              "Arn"
            ]
          },
          "Resources": [
            {
              "Fn::Join": [
                "",
                [
                  "arn:aws:elasticfilesystem:",
                  {
                    "Ref": "AWS::Region"
                  },
                  ":",
                  {
                    "Ref": "AWS::AccountId"
                  },
                  ":file-system/",
                  {
                    "Ref": "Efs"
                  }
                ]
              ]
            }
          ]
        }
      },
      "DependsOn": [
        "BackupPlan",
        "BackupRole",
        "Efs"
      ]
    },
    "BackupSelectionRds": {
      "Type": "AWS::Backup::BackupSelection",
      "Properties": {
        "BackupPlanId": {
          "Ref": "BackupPlan"
        },
        "BackupSelection": {
          "SelectionName": {
            "Fn::Join": [
              "-",
              [
                {
                  "Ref": "AWS::StackName"
                },
                "BackupSelectionRds"
              ]
            ]
          },
          "IamRoleArn": {
            "Fn::GetAtt": [
              "BackupRole",
              "Arn"
            ]
          },
          "Resources": [
            {
              "Fn::Join": [
                "",
                [
                  "arn:aws:rds:",
                  {
                    "Ref": "AWS::Region"
                  },
                  ":",
                  {
                    "Ref": "AWS::AccountId"
                  },
                  ":cluster:",
                  {
                    "Ref": "Rdscl"
                  }
                ]
              ]
            }
          ]
        }
      },
      "DependsOn": [
        "BackupPlan",
        "BackupRole",
        "Rdscl"
      ]
    }
  },
  "Outputs": {
    "Ecscluster": {
      "Value": {
        "Ref" : "Ecscluster"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-Ecscluster"
        }
      }
    },
    "ListenerArnHttps": {
      "Value": {
        "Ref" : "Httpsdefaultlistener"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-ListenerArnHttps"
        }
      }
    },
    "ListenerArnHttp": {
      "Value": {
        "Ref" : "Httpdefaultlistener"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-ListenerArnHttp"
        }
      }
    },
    "Vpc": {
      "Value": {
        "Ref" : "Vpc"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-Vpc"
        }
      }
    },
    "Efs": {
      "Value": {
        "Ref": "Efs"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-Efs"
        }
      }
    }
  },
  "Conditions": {
    "EnableCrossRegionCopy": {
      "Fn::Not": [
        { "Fn::Equals": [ { "Ref": "BackupCopyDestinationRegion" }, "" ] }
      ]
    }
  }
}
