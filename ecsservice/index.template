{
  "Metadata" : {
    "AWS::CloudFormation::Interface" : {
      "ParameterGroups" : [
        {
          "Label" : { "default" : "Cluster" },
          "Parameters" : [ "ClusterStackName" ]
        },
        {
          "Label" : { "default" : "Docker Image" },
          "Parameters" : [ "InitialDockerImage", "SkipImageResolver" ]
        },
        {
          "Label" : { "default" : "Load Balancer" },
          "Parameters" : [ "ListenerRuleHost", "ListenerRulePath", "ListenerRulePriority" ]
        },
        {
          "Label" : { "default" : "Service" },
          "Parameters" : [ "TaskMemory", "ServiceDesiredCount", "ServiceMaxCapacity", "ECSHealthCheckGracePeriod", "ServiceTrafficPort", "ServiceTrafficProtocol", "ECSHealthCheckPath", "VolumeMountPath", "ContainerCommand" ]
        },
        {
          "Label" : { "default" : "Doppler" },
          "Parameters" : [ "ProjectNameShort", "ProjectEnv", "ProjectToken" ]
        },
        {
          "Label" : { "default" : "Monitoring & Alerts" },
          "Parameters" : [ "ServiceScaleUpCpuThreshold", "ServiceScaleDownCpuThreshold", "ServiceHighCpuThreshold", "ServiceHighMemoryThreshold", "ServiceLowCpuThreshold", "ServiceLowMemoryThreshold" ]
        }
      ]
    }
  },
  "Parameters" : {
    "ClusterStackName" : {
      "Description" : "Name of the cloudformation stack of the cluster, where this service should run.",
      "Type" : "String",
      "MinLength" : 1
    },
    "ListenerRuleHost" : {
      "Description" : "Hostname for the ListenerRule.",
      "Type" : "String",
      "MinLength" : 1
    },
    "ListenerRulePath" : {
      "Description" : "PathPattern for the ListenerRule. Normally you should use * here.",
      "Type" : "String",
      "Default" : "*",
      "MinLength" : 1
    },
    "ListenerRulePriority" : {
      "Description" : "The Priority for the ListenerRule",
      "Type" : "Number",
      "MinValue" : 1
    },
    "InitialDockerImage" : {
      "Description" : "The Docker image for the container. Always required on first stack creation. On updates, only used when SkipImageResolver is true - otherwise the image is read from the currently running ECS service.",
      "Type" : "String",
      "MinLength" : 1
    },
    "SkipImageResolver" : {
      "Description" : "When true (default), InitialDockerImage is used directly. When false, the image is read from the currently running ECS task definition on stack updates, preventing stale image rollbacks. Best practice: keep true for stack creation (and while iterating on a failing first deployment), then set to false once the service runs successfully.",
      "Type" : "String",
      "Default" : "true",
      "AllowedValues" : [ "true", "false" ]
    },
    "TaskMemory" : {
      "Type" : "Number",
      "Description" : "The Memory soft limit for one Task-Instance. If your cluster is running on t3.small ec2 instances you should consider the values 485, 970 and 1940 [485-1940]",
      "Default" : 478,
      "AllowedValues" : [478, 956, 1434, 1913]
    },
    "ServiceDesiredCount" : {
      "Type" : "Number",
      "Description" : "The desired task count of this service. This number is also taken for the min count of Task-Instances (for Autoscaling). [0-4]",
      "MinValue" : 0,
      "MaxValue" : 4
    },
    "ServiceMaxCapacity" : {
      "Type" : "Number",
      "Description" : "The max count of Task-Instances (for Autoscaling). [1-10]",
      "MinValue" : 1,
      "MaxValue" : 10
    },
    "ECSHealthCheckGracePeriod" : {
      "Description" : "The number in seconds ECS waits for the container to initialize before it kills the instance because of \"poor health\".",
      "Default": "0",
      "Type" : "Number"
    },
    "ServiceTrafficPort": {
      "Description" : "Port on which the docker container is serving content. This one is also used for the health check.",
      "Default" : "443",
      "Type" : "Number",
      "AllowedValues" : ["80", "443", "3000", "8000", "8001", "8080", "8443", "8983"]
    },
    "ServiceTrafficProtocol": {
      "Description" : "Protocol on which the docker container is serving content. This one is also used for the health check.",
      "Default" : "HTTPS",
      "Type" : "String",
      "AllowedValues" : ["HTTP", "HTTPS"]
    },
    "ECSHealthCheckPath": {
      "Description" : "Path to use for health check.",
      "Default" : "/test.php",
      "Type" : "String"
    },
    "VolumeMountPath": {
      "Description" : "Path in the container, where the EFS-Volume should be mounted",
      "Default" : "/var/www/html_data",
      "Type" : "String"
    },
    "ProjectNameShort": {
      "Description" : "Project name in our shorthand version with underscores (e.g. kun_pro_app). This one is used to identify the doppler project to fetch secrets from.",
      "Type" : "String",
      "AllowedPattern" : "[a-z]{3}_[a-z]{3}_[a-z]{3}"
    },
    "ProjectEnv": {
      "Description" : "The environment in which this project should run. This one is also used to determine the correct doppler config to fetch secrets from. But it may be used in the code as well. So, unless you really know what you're doing, keep the default 'prd' - or 'stg' for staging environments.",
      "Default" : "prd",
      "Type" : "String"
    },
    "ProjectToken": {
      "Description" : "This token is used to fetch secrets from doppler. Make sure to only use service tokens, which have only read access. No personal or other tokens.",
      "AllowedPattern" : "dp\\.st\\.[a-zA-Z_]*\\.[a-zA-Z0-9]{43}",
      "NoEcho" : "true",
      "Type" : "String"
    },
    "ContainerCommand": {
      "Type": "String",
      "Default": "",
      "Description": "Command to run in the container as a comma-separated list, e.g., python,app.py,--env,prod. Leave empty to use the image default."
    },
    "ServiceScaleUpCpuThreshold": {
      "Type": "Number",
      "Description": "CPU utilization (percent) above which the service scales up by one task.",
      "Default": 65,
      "MinValue": 10,
      "MaxValue": 100
    },
    "ServiceScaleDownCpuThreshold": {
      "Type": "Number",
      "Description": "CPU utilization (percent) below which the service scales down by one task - only acts while more tasks than ServiceDesiredCount are running. Must be lower than ServiceScaleUpCpuThreshold.",
      "Default": 15,
      "MinValue": 1,
      "MaxValue": 90
    },
    "ServiceHighCpuThreshold": {
      "Type": "Number",
      "Description": "CPU utilization threshold (percent) for high-CPU alarm. Alerts when sustained above this value. Set to 0 to disable.",
      "Default": 20,
      "MinValue": 0,
      "MaxValue": 100
    },
    "ServiceHighMemoryThreshold": {
      "Type": "Number",
      "Description": "Memory utilization threshold (percent) for high-memory alarm. Alerts when sustained above this value. Set to 0 to disable.",
      "Default": 80,
      "MinValue": 0,
      "MaxValue": 100
    },
    "ServiceLowCpuThreshold": {
      "Type": "Number",
      "Description": "CPU utilization threshold (percent) for low-CPU alarm. Alerts when sustained below this value. Set to 0 to disable (default).",
      "Default": 0,
      "MinValue": 0,
      "MaxValue": 50
    },
    "ServiceLowMemoryThreshold": {
      "Type": "Number",
      "Description": "Memory utilization threshold (percent) for low-memory alarm. Alerts when sustained below this value. Set to 0 to disable (default).",
      "Default": 0,
      "MinValue": 0,
      "MaxValue": 70
    }
  },
  "Conditions": {
    "HasContainerCommand": {
      "Fn::Not": [
        { "Fn::Equals": [ { "Ref": "ContainerCommand" }, "" ] }
      ]
    },
    "EnableHighCpuAlarm": {
      "Fn::Not": [
        { "Fn::Equals": [ { "Ref": "ServiceHighCpuThreshold" }, 0 ] }
      ]
    },
    "EnableHighMemoryAlarm": {
      "Fn::Not": [
        { "Fn::Equals": [ { "Ref": "ServiceHighMemoryThreshold" }, 0 ] }
      ]
    },
    "EnableLowCpuAlarm": {
      "Fn::Not": [
        { "Fn::Equals": [ { "Ref": "ServiceLowCpuThreshold" }, 0 ] }
      ]
    },
    "EnableLowMemoryAlarm": {
      "Fn::Not": [
        { "Fn::Equals": [ { "Ref": "ServiceLowMemoryThreshold" }, 0 ] }
      ]
    }
  },
  "Resources" : {
    "ServiceRole" : {
      "Type" : "AWS::IAM::Role",
      "Properties" : {
        "AssumeRolePolicyDocument" : {
          "Version" : "2012-10-17",
          "Statement" : [ {
            "Effect" : "Allow",
            "Principal" : {
              "Service" : [ "ecs.amazonaws.com" ]
            },
            "Action" : [ "sts:AssumeRole" ]
          } ]
        },
        "ManagedPolicyArns" : [ "arn:aws:iam::aws:policy/service-role/AmazonEC2ContainerServiceRole" ],
        "Path" : "/",
        "RoleName" : {
          "Fn::Join" : [ "-", [
            { "Ref" : "AWS::StackName" },
            "ServiceRole" ]
          ]
        }
      }
    },
    "LogGroup" : {
      "Type" : "AWS::Logs::LogGroup",
      "Properties" : {
        "LogGroupName" : {
          "Fn::Join" : [ "-", [
            { "Ref" : "AWS::StackName" },
            "LogGroup" ]
          ]
        },
        "RetentionInDays" : 14
      }
    },
    "ImageResolverRole" : {
      "Type" : "AWS::IAM::Role",
      "Properties" : {
        "AssumeRolePolicyDocument" : {
          "Version" : "2012-10-17",
          "Statement" : [ {
            "Effect" : "Allow",
            "Principal" : { "Service" : "lambda.amazonaws.com" },
            "Action" : "sts:AssumeRole"
          } ]
        },
        "ManagedPolicyArns" : [ "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole" ],
        "Policies" : [ {
          "PolicyName" : { "Fn::Join" : [ "-", [ { "Ref" : "AWS::StackName" }, "ImageResolverPolicy" ] ] },
          "PolicyDocument" : {
            "Version" : "2012-10-17",
            "Statement" : [
              {
                "Effect" : "Allow",
                "Action" : [ "ecs:DescribeTaskDefinition", "ecs:DescribeServices" ],
                "Resource" : "*"
              }
            ]
          }
        } ],
        "Path" : "/",
        "RoleName" : { "Fn::Join" : [ "-", [ { "Ref" : "AWS::StackName" }, "ImageResolverRole" ] ] }
      }
    },
    "ImageResolverLogGroup" : {
      "Type" : "AWS::Logs::LogGroup",
      "Properties" : {
        "LogGroupName" : { "Fn::Join" : [ "", [ "/aws/lambda/", { "Ref" : "AWS::StackName" }, "-ImageResolver" ] ] },
        "RetentionInDays" : 14
      }
    },
    "ImageResolverFunction" : {
      "Type" : "AWS::Lambda::Function",
      "Metadata" : {
        "Note" : "Resolves the Docker image to use in the TaskDefinition. On Create it returns InitialDockerImage directly. On Update it calls ecs:DescribeServices to get the ARN of the task definition the service is actively running, then reads the image from that revision — ensuring CF always uses the currently deployed image rather than the stale value in InitialDockerImage. SkipImageResolver=true bypasses the ECS lookup and uses InitialDockerImage directly, for cases where a specific image must be forced."
      },
      "Properties" : {
        "FunctionName" : { "Fn::Join" : [ "-", [ { "Ref" : "AWS::StackName" }, "ImageResolver" ] ] },
        "Runtime" : "python3.12",
        "Handler" : "index.handler",
        "Role" : { "Fn::GetAtt" : [ "ImageResolverRole", "Arn" ] },
        "Timeout" : 30,
        "Code" : {
          "ZipFile" : "import json\nimport urllib.request\nimport boto3\n\ndef handler(event, context):\n    physical_id = event.get('PhysicalResourceId') or event['StackId']\n    status = 'FAILED'\n    data = {}\n    try:\n        props = event['ResourceProperties']\n        request_type = event['RequestType']\n        if request_type == 'Delete':\n            status = 'SUCCESS'\n        elif request_type == 'Create' or props.get('SkipImageResolver', 'false').lower() == 'true':\n            status = 'SUCCESS'\n            data = {'Value': props['InitialDockerImage']}\n        else:\n            ecs = boto3.client('ecs')\n            svc = ecs.describe_services(cluster=props['EcsCluster'], services=[props['EcsService']])\n            if not svc['services']:\n                raise ValueError(f\"ECS service '{props['EcsService']}' not found in cluster '{props['EcsCluster']}'\")\n            task_def_arn = svc['services'][0].get('taskDefinition')\n            if not task_def_arn:\n                raise ValueError(f\"No active task definition on service '{props['EcsService']}'\")\n            td = ecs.describe_task_definition(taskDefinition=task_def_arn)\n            status = 'SUCCESS'\n            data = {'Value': td['taskDefinition']['containerDefinitions'][0]['image']}\n    except Exception as e:\n        print(f'ImageResolver error: {e}')\n        data = {'Error': str(e)}\n    finally:\n        try:\n            respond(event, status, data, physical_id)\n        except Exception:\n            pass\n\ndef respond(event, status, data, physical_id):\n    body = json.dumps({'Status': status, 'Reason': 'See CloudWatch logs', 'PhysicalResourceId': physical_id, 'StackId': event['StackId'], 'RequestId': event['RequestId'], 'LogicalResourceId': event['LogicalResourceId'], 'Data': data})\n    req = urllib.request.Request(event['ResponseURL'], data=body.encode('utf-8'), method='PUT', headers={'Content-Type': ''})\n    urllib.request.urlopen(req)\n"
        }
      }
    },
    "ImageResolver" : {
      "Type" : "Custom::ImageResolver",
      "Metadata" : {
        "Note" : "All parameters that should trigger the Lambda on change must be listed as Properties. NoEcho parameters (e.g. ProjectToken) must never be added here — CloudFormation rejects passing NoEcho values to custom resources."
      },
      "Properties" : {
        "ServiceToken" : { "Fn::GetAtt" : [ "ImageResolverFunction", "Arn" ] },
        "EcsCluster" : { "Fn::ImportValue" : { "Fn::Sub" : "${ClusterStackName}-Ecscluster" } },
        "EcsService" : { "Fn::Join" : [ "-", [ { "Ref" : "AWS::StackName" }, "Service" ] ] },
        "InitialDockerImage" : { "Ref" : "InitialDockerImage" },
        "SkipImageResolver" : { "Ref" : "SkipImageResolver" },
        "ClusterStackName" : { "Ref" : "ClusterStackName" },
        "ListenerRuleHost" : { "Ref" : "ListenerRuleHost" },
        "ListenerRulePath" : { "Ref" : "ListenerRulePath" },
        "ListenerRulePriority" : { "Ref" : "ListenerRulePriority" },
        "TaskMemory" : { "Ref" : "TaskMemory" },
        "ServiceDesiredCount" : { "Ref" : "ServiceDesiredCount" },
        "ServiceMaxCapacity" : { "Ref" : "ServiceMaxCapacity" },
        "ECSHealthCheckGracePeriod" : { "Ref" : "ECSHealthCheckGracePeriod" },
        "ServiceTrafficPort" : { "Ref" : "ServiceTrafficPort" },
        "ServiceTrafficProtocol" : { "Ref" : "ServiceTrafficProtocol" },
        "ECSHealthCheckPath" : { "Ref" : "ECSHealthCheckPath" },
        "VolumeMountPath" : { "Ref" : "VolumeMountPath" },
        "ContainerCommand" : { "Ref" : "ContainerCommand" },
        "ProjectNameShort" : { "Ref" : "ProjectNameShort" },
        "ProjectEnv" : { "Ref" : "ProjectEnv" }
      }
    },
    "TaskRole" : {
      "Type" : "AWS::IAM::Role",
      "Properties" : {
        "AssumeRolePolicyDocument" : {
          "Version" : "2012-10-17",
          "Statement" : [ {
            "Effect" : "Allow",
            "Principal" : {
              "Service" : [ "ecs-tasks.amazonaws.com" ]
            },
            "Action" : [ "sts:AssumeRole" ]
          } ]
        },
        "Policies" : [ {
          "PolicyDocument" : {
            "Version" : "2012-10-17",
            "Statement" : [
              {
                "Effect" : "Allow",
                "Action" : [
                  "logs:ListTagsLogGroup",
                  "logs:CreateLogStream",
                  "logs:DescribeLogGroups",
                  "logs:DescribeLogStreams",
                  "logs:GetLogEvents",
                  "logs:PutLogEvents"
                ],
                "Resource" : [
                  {
                    "Fn::Join" : [ ":", [
                      "arn:aws:logs",
                      { "Ref" : "AWS::Region" },
                      { "Ref" : "AWS::AccountId" },
                      "log-group",
                      { "Fn::Join" : [ "-", [ { "Ref" : "AWS::StackName" }, "LogGroup" ] ] }
                    ] ]
                  },
                  {
                    "Fn::Join" : [ ":", [
                      "arn:aws:logs",
                      { "Ref" : "AWS::Region" },
                      { "Ref" : "AWS::AccountId" },
                      "log-group",
                      { "Fn::Join" : [ "-", [ { "Ref" : "AWS::StackName" }, "LogGroup" ] ] },
                      "log-stream",
                      "*"
                    ] ]
                  }
                ]
              },
              {
                "Effect": "Allow",
                "Action": [
                  "ecr:GetAuthorizationToken",
                  "ecr:BatchCheckLayerAvailability",
                  "ecr:GetDownloadUrlForLayer",
                  "ecr:BatchGetImage"
                ],
                "Resource": "*"
              }
            ]
          },
          "PolicyName" : {
            "Fn::Join" : [ "-", [
              { "Ref" : "AWS::StackName" },
              "TaskRole" ]
            ]
          }
        } ],
        "Path" : "/",
        "RoleName" : {
          "Fn::Join" : [ "-", [
            { "Ref" : "AWS::StackName" }, "TaskRole" ]
          ]
        }
      }
    },
    "Task" : {
      "Type" : "AWS::ECS::TaskDefinition",
      "Properties" : {
        "Volumes" : [ {
          "EFSVolumeConfiguration" : {
            "FilesystemId" : { "Fn::ImportValue" : { "Fn::Sub" : "${ClusterStackName}-Efs" } },
            "RootDirectory" : {
              "Fn::Join" : [ "", [
                "/",
                { "Ref" : "AWS::StackName"} ]
              ]
            },
            "TransitEncryption" : "ENABLED"
          },
          "Name" : "data"
        } ],
        "Family" : {
          "Fn::Join" : [ "-", [
            { "Ref" : "AWS::StackName" },
            "Task" ]
          ]
        },
        "NetworkMode" : "bridge",
        "ExecutionRoleArn" : { "Fn::GetAtt" : [ "TaskRole", "Arn" ] },
        "TaskRoleArn" : { "Fn::GetAtt" : [ "TaskRole", "Arn" ] },
        "ContainerDefinitions" : [ {
          "Command": {
            "Fn::If": [
              "HasContainerCommand",
              { "Fn::Split": [ ",", { "Ref": "ContainerCommand" } ] },
              { "Ref": "AWS::NoValue" }
            ]
          },
          "Environment" : [ {
            "Name" : "PROJECT_ENV",
            "Value" : { "Ref" : "ProjectEnv" }
          }, {
            "Name" : "PROJECT_ENV_HOSTER",
            "Value" : "aws"
          }, {
            "Name" : "DOPPLER_PROJECT",
            "Value" : { "Ref" : "ProjectNameShort" }
          }, {
            "Name" : "DOPPLER_CONFIG",
            "Value" : { "Ref" : "ProjectEnv" }
          }, {
            "Name" : "DOPPLER_TOKEN",
            "Value" : { "Ref" : "ProjectToken" }
          } ],
          "Essential" : true,
          "Image" : { "Fn::GetAtt" : [ "ImageResolver", "Value" ] },
          "MemoryReservation" : { "Ref" : "TaskMemory" },
          "MountPoints" : [ {
            "ReadOnly" : "false",
            "ContainerPath" : { "Ref" : "VolumeMountPath" },
            "SourceVolume" : "data"
          } ],
          "Name" : {
            "Fn::Join" : [ "-", [
              { "Ref" : "AWS::StackName" },
              "Container" ] ]
          },
          "PortMappings" : [ {
            "HostPort" : 0,
            "Protocol" : "tcp",
            "ContainerPort" : { "Ref" : "ServiceTrafficPort" }
          } ],
          "LogConfiguration" : {
            "LogDriver" : "awslogs",
            "Options" : {
              "awslogs-group": {
                "Fn::Join" : [ "-", [
                  { "Ref" : "AWS::StackName" },
                  "LogGroup" ]
                ]
              },
              "awslogs-region": { "Ref" : "AWS::Region" },
              "awslogs-stream-prefix": "ECSDockerTask"
            }
          }
        } ]
      },
      "DependsOn" : [ "TaskRole" ]
    },
    "Target" : {
      "Type" : "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties" : {
        "HealthCheckIntervalSeconds" : 45,
        "HealthCheckPath" : { "Ref" : "ECSHealthCheckPath" },
        "HealthCheckPort" : "traffic-port",
        "HealthCheckProtocol" : { "Ref" : "ServiceTrafficProtocol" },
        "HealthCheckTimeoutSeconds" : 15,
        "HealthyThresholdCount" : 2,
        "Matcher" : {
          "HttpCode" : "200"
        },
        "Name" : {
          "Fn::Join" : [ "-", [
            { "Ref" : "AWS::StackName" },
            "Target" ]
          ]
        },
        "Port" : { "Ref" : "ServiceTrafficPort" },
        "Protocol" : { "Ref" : "ServiceTrafficProtocol" },
        "Tags" : [ {
          "Key" : "Name",
          "Value" : {
            "Fn::Join" : [ "-", [
              { "Ref" : "AWS::StackName" },
              "Target" ] ]
          }
        } ],
        "TargetGroupAttributes" : [ {
          "Key" : "deregistration_delay.timeout_seconds",
          "Value" : "120"
        }, {
          "Key" : "stickiness.enabled",
          "Value" : "false"
        } ],
        "TargetType" : "instance",
        "UnhealthyThresholdCount" : 4,
        "VpcId" : { "Fn::ImportValue" : { "Fn::Sub" : "${ClusterStackName}-Vpc" } }
      }
    },
    "LoadbalancerRuleHttp" : {
      "Type" : "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties" : {
        "Actions" : [ {
          "RedirectConfig" : {
            "Host" : "#{host}",
            "Path" : "/#{path}",
            "Port" : "443",
            "Protocol" : "HTTPS",
            "Query" : "#{query}",
            "StatusCode" : "HTTP_301"
          },
          "Type" : "redirect"
        } ],
        "Conditions" : [ {
          "Field" : "host-header",
          "Values" : [ { "Ref" : "ListenerRuleHost" } ]
        }, {
          "Field" : "path-pattern",
          "Values" : [ { "Ref" : "ListenerRulePath" } ]
        } ],
        "ListenerArn" : { "Fn::ImportValue" : { "Fn::Sub" : "${ClusterStackName}-ListenerArnHttp" } },
        "Priority" : { "Ref" : "ListenerRulePriority" }
      }
    },
    "LoadbalancerRule" : {
      "Type" : "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties" : {
        "Actions" : [ {
          "TargetGroupArn" : { "Ref" : "Target" },
          "Type" : "forward"
        } ],
        "Conditions" : [ {
          "Field" : "host-header",
          "Values" : [ { "Ref" : "ListenerRuleHost" } ]
        }, {
          "Field" : "path-pattern",
          "Values" : [ { "Ref" : "ListenerRulePath" } ]
        } ],
        "ListenerArn" : { "Fn::ImportValue" : { "Fn::Sub" : "${ClusterStackName}-ListenerArnHttps" } },
        "Priority" : { "Ref" : "ListenerRulePriority" }
      },
      "DependsOn" : [ "Target" ]
    },
    "Service" : {
      "Type" : "AWS::ECS::Service",
      "Properties" : {
        "Cluster" : { "Fn::ImportValue" : { "Fn::Sub" : "${ClusterStackName}-Ecscluster" } },
        "DeploymentConfiguration" : {
          "MaximumPercent" : 200,
          "MinimumHealthyPercent" : 50,
          "DeploymentCircuitBreaker" : {
            "Enable" : true,
            "Rollback" : true
          }
        },
        "DesiredCount" : { "Ref" : "ServiceDesiredCount" },
        "LoadBalancers" : [ {
          "ContainerName" : {
            "Fn::Join" : [ "-", [
              { "Ref" : "AWS::StackName" },
              "Container" ]
            ]
          },
          "ContainerPort" : { "Ref" : "ServiceTrafficPort" },
          "TargetGroupArn" : { "Ref" : "Target"  }
        } ],
        "HealthCheckGracePeriodSeconds": { "Ref": "ECSHealthCheckGracePeriod" },
        "Role" : { "Fn::GetAtt" : [ "ServiceRole", "Arn" ] },
        "PlacementStrategies" : [ {
          "Type" : "spread",
          "Field" : "attribute:ecs.availability-zone"
        }, {
          "Type" : "binpack",
          "Field" : "memory"
        } ],
        "ServiceName" : {
          "Fn::Join" : [ "-", [
            { "Ref" : "AWS::StackName" },
            "Service" ]
          ]
        },
        "TaskDefinition" : { "Ref" : "Task" }
      },
      "DependsOn" : [ "ServiceRole", "Task", "Target" ]
    },
    "AutoscaleRole" : {
      "Type" : "AWS::IAM::Role",
      "Properties" : {
        "AssumeRolePolicyDocument" : {
          "Version" : "2012-10-17",
          "Statement" : [ {
            "Effect" : "Allow",
            "Principal" : {
              "Service" : [ "application-autoscaling.amazonaws.com" ]
            },
            "Action" : [ "sts:AssumeRole" ]
          } ]
        },
        "ManagedPolicyArns" : [ "arn:aws:iam::aws:policy/service-role/AmazonEC2ContainerServiceAutoscaleRole" ],
        "Path" : "/",
        "RoleName" : {
          "Fn::Join" : [ "-", [
            { "Ref" : "AWS::StackName" },
            "AutoscaleRole" ]
          ]
        }
      }
    },
    "Autoscaletarget" : {
      "Type" : "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties" : {
        "MaxCapacity" : { "Ref" : "ServiceMaxCapacity" },
        "MinCapacity" : { "Ref" : "ServiceDesiredCount" },
        "ResourceId" : {
          "Fn::Join" : [ "/", [
            "service",
            { "Fn::ImportValue" : { "Fn::Sub" : "${ClusterStackName}-Ecscluster" } },
            { "Fn::GetAtt" : [ "Service", "Name" ] }]
          ]
        },
        "RoleARN" : {
          "Fn::GetAtt" : [ "AutoscaleRole", "Arn" ]
        },
        "ScalableDimension" : "ecs:service:DesiredCount",
        "ServiceNamespace" : "ecs"
      },
      "DependsOn" : [ "AutoscaleRole" ]
    },
    "AutoscaleScaleUp" : {
      "Type" : "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties" : {
        "PolicyName" : {
          "Fn::Join" : [ "-", [
            { "Ref" : "AWS::StackName" },
            "AutoscaleScaleUp" ]
          ]
        },
        "PolicyType" : "StepScaling",
        "ScalingTargetId" : { "Ref" : "Autoscaletarget" },
        "StepScalingPolicyConfiguration" : {
          "AdjustmentType" : "ChangeInCapacity",
          "Cooldown" : 300,
          "MetricAggregationType" : "Average",
          "StepAdjustments" : [ {
            "MetricIntervalLowerBound" : 0,
            "ScalingAdjustment" : 1
          } ]
        }
      },
      "DependsOn" : [ "Autoscaletarget" ]
    },
    "AlarmAutoscaleScaleUp" : {
      "Type" : "AWS::CloudWatch::Alarm",
      "Properties" : {
        "AlarmActions" : [ { "Ref" : "AutoscaleScaleUp" } ],
        "AlarmName" : {
          "Fn::Join" : [ "-", [
            { "Ref" : "AWS::StackName" },
            "AlarmAutoscaleScaleUp" ]
          ]
        },
        "ComparisonOperator" : "GreaterThanThreshold",
        "Dimensions" : [ {
          "Name" : "ClusterName",
          "Value" : { "Fn::ImportValue" : { "Fn::Sub" : "${ClusterStackName}-Ecscluster" } }
        }, {
          "Name" : "ServiceName",
          "Value" : {
            "Fn::GetAtt" : [ "Service", "Name" ]
          }
        } ],
        "EvaluationPeriods" : "3",
        "MetricName" : "CPUUtilization",
        "Namespace" : "AWS/ECS",
        "Period" : 60,
        "Statistic" : "Average",
        "Threshold" : { "Ref" : "ServiceScaleUpCpuThreshold" }
      },
      "DependsOn" : [ "AutoscaleScaleUp", "Service" ]
    },
    "AutoscaleScaleDown" : {
      "Type" : "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties" : {
        "PolicyName" : {
          "Fn::Join" : [ "-", [
            { "Ref" : "AWS::StackName" },
            "AutoscaleScaleDown" ]
          ]
        },
        "PolicyType" : "StepScaling",
        "ScalingTargetId" : { "Ref" : "Autoscaletarget" },
        "StepScalingPolicyConfiguration" : {
          "AdjustmentType" : "ChangeInCapacity",
          "Cooldown" : 300,
          "MetricAggregationType" : "Average",
          "StepAdjustments" : [ {
            "MetricIntervalLowerBound" : 0,
            "ScalingAdjustment" : -1
          } ]
        }
      },
      "DependsOn" : [ "Autoscaletarget" ]
    },
    "AlarmAutoscaleScaleDown" : {
      "Type" : "AWS::CloudWatch::Alarm",
      "Properties" : {
        "AlarmActions" : [ { "Ref" : "AutoscaleScaleDown" } ],
        "AlarmName" : {
          "Fn::Join" : [ "-", [
            { "Ref" : "AWS::StackName" },
            "AlarmAutoscaleScaleDown" ]
          ]
        },
        "AlarmDescription" : "Scale-in trigger: fires only while MORE tasks than ServiceDesiredCount are running AND CPU is below 15%. OK during normal operation; stays in alarm only while scale-in is pending — if it stays red for long, scale-in is stuck.",
        "ComparisonOperator" : "GreaterThanThreshold",
        "Threshold" : 0,
        "EvaluationPeriods" : 5,
        "TreatMissingData" : "notBreaching",
        "Metrics" : [
          {
            "Id" : "scalein",
            "Label" : "ScaleInNeeded",
            "Expression" : { "Fn::Sub" : "IF(cpu < ${ServiceScaleDownCpuThreshold} AND tasks > ${ServiceDesiredCount}, 1, 0)" },
            "ReturnData" : true
          },
          {
            "Id" : "cpu",
            "ReturnData" : false,
            "MetricStat" : {
              "Metric" : {
                "Namespace" : "AWS/ECS",
                "MetricName" : "CPUUtilization",
                "Dimensions" : [ {
                  "Name" : "ClusterName",
                  "Value" : { "Fn::ImportValue" : { "Fn::Sub" : "${ClusterStackName}-Ecscluster" } }
                }, {
                  "Name" : "ServiceName",
                  "Value" : { "Fn::GetAtt" : [ "Service", "Name" ] }
                } ]
              },
              "Period" : 60,
              "Stat" : "Average"
            }
          },
          {
            "Id" : "tasks",
            "ReturnData" : false,
            "MetricStat" : {
              "Metric" : {
                "Namespace" : "AWS/ApplicationELB",
                "MetricName" : "HealthyHostCount",
                "Dimensions" : [ {
                  "Name" : "TargetGroup",
                  "Value" : { "Fn::GetAtt" : [ "Target", "TargetGroupFullName" ] }
                }, {
                  "Name" : "LoadBalancer",
                  "Value" : {
                    "Fn::Select" : [ 1, {
                      "Fn::Split" : [ "loadbalancer/", { "Fn::ImportValue" : { "Fn::Sub" : "${ClusterStackName}-LoadbalancerArn" } } ]
                    } ]
                  }
                } ]
              },
              "Period" : 60,
              "Stat" : "Average"
            }
          }
        ]
      },
      "DependsOn" : [ "AutoscaleScaleDown", "Service" ]
    },
    "ServiceHighCpuAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "EnableHighCpuAlarm",
