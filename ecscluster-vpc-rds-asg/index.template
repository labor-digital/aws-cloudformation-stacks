    "Rdsinstance1ParameterGroup": {
      "Type": "AWS::RDS::DBParameterGroup",
      "Properties": {
        "Description": "Aurora 8.0 Instance Parameter Group with increased connection limit",
        "Family": "aurora-mysql8.0",
        "Parameters": {
          "max_connections": "{log(DBInstanceClassMemory/805306368)*60}",
          "sort_buffer_size": 1048576
        }
      }
    },
    "RdsclParameterGroup": {
      "Type": "AWS::RDS::DBClusterParameterGroup",
      "Properties": {
        "Description": "Aurora 8.0 Cluster Parameter Group with secure connection required",
        "Family": "aurora-mysql8.0",
        "Parameters": {
          "require_secure_transport": "ON"
        }
      }
    },
    "Rdscl": {
      "Type": "AWS::RDS::DBCluster",
      "Properties": {
        "AvailabilityZones": [
          {
            "Fn::Select": [
              "0",
              {
                "Fn::GetAZs": {
                  "Ref": "AWS::Region"
                }
              }
            ]
          },
          {
            "Fn::Select": [
              "1",
              {
                "Fn::GetAZs": {
                  "Ref": "AWS::Region"
                }
              }
            ]
          }
        ],
        "BackupRetentionPeriod": 1,
        "DBClusterParameterGroupName": {
          "Ref": "RdsclParameterGroup"
        },
        "DBSubnetGroupName": {
          "Ref": "RdsclSubnetgroup"
        },
        "Engine": "aurora-mysql",
        "EngineVersion": "8.0.mysql_aurora.3.08.2",
        "MasterUsername": {
          "Ref": "RdsMasterUsername"
        },
        "MasterUserPassword": {
          "Ref": "RdsMasterPassword"
        },
