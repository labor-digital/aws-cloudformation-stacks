        },
        "Description": "Source ranges permitted to reach admin paths."
      }
    },
    "WafWebAcl": {
      "Type": "AWS::WAFv2::WebACL",
      "Metadata": {
        "Note": "Scope REGIONAL, so this is created in the cluster's own region and attaches directly to the ALB - unlike the CLOUDFRONT-scoped WebACL in cloudfront-alb-distribution, which only exists in us-east-1 and only inspects traffic that actually travels through CloudFront. Rule order is deliberate: IP reputation first (cheapest rejection), then generic managed groups, then application-specific rules, then rate limiting last so that legitimate-looking floods are still classified by the groups above. Every rule carries its own off/count/block parameter: a single global switch would force promoting all rules at once, which defeats the point of a counting period."
      },
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-waf"
        },
        "Scope": "REGIONAL",
        "DefaultAction": {
          "Allow": {}
        },
        "Description": {
          "Fn::Sub": "WAF for the ${AWS::StackName} ALB"
        },
        "VisibilityConfig": {
          "SampledRequestsEnabled": true,
          "CloudWatchMetricsEnabled": true,
          "MetricName": "AlbWebAcl"
        },
        "Rules": [
          {
            "Fn::If": [
              "IpReputationActionEnabled",
              {
                "Name": "AWSManagedRulesAmazonIpReputationList",
                "Priority": 10,
                "OverrideAction": {
                  "Fn::If": [
                    "IpReputationActionCounts",
                    {
                      "Count": {}
                    },
                    {
