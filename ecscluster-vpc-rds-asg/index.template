                [
                  {
                    "Ref": "AWS::StackName"
                  },
                  "Dhcpopts"
                ]
              ]
            }
          }
        ]
      }
    },
    "AssociateDhcpopts": {
      "Type": "AWS::EC2::VPCDHCPOptionsAssociation",
      "Properties": {
        "DhcpOptionsId": {
          "Ref": "Dhcpopts"
        },
        "VpcId": {
          "Ref": "Vpc"
        }
      },
      "DependsOn": [
        "Vpc",
        "Dhcpopts"
      ]
    },
    "Netacl": {
      "Type": "AWS::EC2::NetworkAcl",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Join": [
                "-",
                [
                  {
                    "Ref": "AWS::StackName"
