    "DnsFirewallWhitelistDomainList": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-whitelist"
        },
        "Domains": {
          "Ref": "DnsFirewallWhitelistDomains"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-dns-whitelist"
            }
          },
          {
            "Key": "security-owner",
            "Value": "network-sec"
          }
        ]
      }
    },
    "DnsFirewallCatchAllDomainList": {
      "Type": "AWS::Route53Resolver::FirewallDomainList",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-catch-all"
        },
        "Domains": [
          "*"
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-dns-catch-all"
            }
          },
          {
            "Key": "security-owner",
            "Value": "network-sec"
          }
        ]
      }
    },
    "DnsFirewallRuleGroup": {
      "Type": "AWS::Route53Resolver::FirewallRuleGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-egress-control"
        },
        "FirewallRules": [
          {
            "Priority": 100,
            "FirewallDomainListId": {
              "Ref": "DnsFirewallWhitelistDomainList"
            },
            "Action": "ALLOW",
            "FirewallDomainRedirectionAction": {
              "Ref": "DnsFirewallRedirectionAction"
            }
          },
          {
            "Priority": 200,
            "FirewallDomainListId": {
              "Ref": "DnsFirewallCatchAllDomainList"
            },
            "Action": {
              "Ref": "DnsFirewallCatchAllAction"
            },
            "BlockResponse": {
              "Fn::If": [
                "DnsFirewallCatchAllBlocks",
                {
                  "Ref": "DnsFirewallBlockResponse"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-egress-control"
            }
          },
          {
            "Key": "security-owner",
            "Value": "network-sec"
          }
        ]
      },
      "Metadata": {
        "Note": "Rule 100 allows the whitelist, rule 200 catches everything else. The redirection setting on rule 100 is the part that is easy to miss: with the AWS default the whole CNAME chain is inspected, so a whitelisted name whose chain leaves the list still triggers rule 200 - logged under the original query name, which points the investigation at the wrong place. Under a BLOCK catch-all that is not noise but an outage: every allowed domain served through a CDN stops resolving."
      }
    },
