    "SgVpcEfsAccess": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupName": {
          "Fn::Join": [
            "-",
            [
              {
                "Ref": "AWS::StackName"
              },
              "SgVpcEfsAccess"
            ]
          ]
        },
        "GroupDescription": "Securitygroup to access the EFS",
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Join": [
                "-",
                [
                  {
                    "Ref": "AWS::StackName"
                  },
                  "SgVpcEfsAccess"
                ]
              ]
            }
          }
        ],
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": {
          "Fn::If": [
            "EgressRestricted",
            [
              {
                "IpProtocol": "-1",
                "CidrIp": "127.0.0.1/32",
                "Description": "EgressPolicy=restricted - reaches nothing; the policy lives in SgEgress. An empty list would restore the AWS default allow-all, so 'no egress' has to be a rule that goes nowhere."
              }
            ],
            [
              {
                "IpProtocol": "-1",
                "CidrIp": "0.0.0.0/0",
                "Description": "EgressPolicy=open - identical to the AWS default this group carried implicitly before"
              }
            ]
          ]
        }
      },
      "DependsOn": [
        "Vpc"
      ],
      "Metadata": {
        "Note": "Egress is neutralised here only under EgressPolicy=restricted; the policy then lives in SgEgress. Under open this group keeps an explicit allow-all, which is exactly what the absent property gave it before - stated as a rule rather than left implicit so the switch is deterministic in both directions. ORDER MATTERS: see the EgressPolicy description before flipping."
      }
    },
    "SgEgress": {
      "Type": "AWS::EC2::SecurityGroup",
      "Metadata": {
        "Note": "The single place the outbound policy of the EC2 instances is expressed. Its own group because rule sets are ADDITIVE across every group on an instance: SgVpcMysqlAccess, SgVpcLoadbalancerports and SgVpcEfsAccess all sit on the launch template, so restricting one while the others permit everything achieves nothing. Those three carry a placeholder rule to 127.0.0.1/32 under restricted - an empty SecurityGroupEgress list makes CloudFormation recreate the default allow-all, so 'no egress' has to be a rule that reaches nowhere. Not applied to the ALB, RDS or EFS groups: the ALB needs egress to its targets, the other two initiate nothing outbound."
      },
