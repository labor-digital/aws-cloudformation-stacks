    "EnableHttp4xxAnomalyAlarm": {
      "Type": "String",
      "Description": "Alarm on unusual volumes of HTTP 4xx responses from the container (scans, brute force, or a deployment that broke asset paths), using a CloudWatch anomaly detection band instead of a fixed threshold. Defaults to false: the band needs about two weeks of traffic to be meaningful and is noisy on low-traffic services, so enable it per service once a baseline exists.",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    },
    "ServiceHttp4xxAnomalyBand": {
      "Type": "Number",
      "Description": "Width of the anomaly detection band for HTTP 4xx, in standard deviations. Higher is more conservative (fewer alarms). Only used when EnableHttp4xxAnomalyAlarm is true.",
      "Default": 3,
      "MinValue": 1,
      "MaxValue": 8
    },
    "EnableImageRegressionAlarm": {
      "Type": "String",
      "Description": "Alert when a deployment rolls out a container image that is OLDER than the one it replaces - a stale CloudFormation image revert (e.g. a token-only parameter update that did not re-trigger the image resolver) or an accidental redeploy of an old build. On every deployment the guard compares the ECR push time of the incoming image against the outgoing one and publishes to the cluster AlertTopic if it went backwards; deploying the same or a newer image is silent. Region and account are taken from the image reference, so repositories in another region than the cluster are handled. Images outside ECR (e.g. a Docker Hub tag) carry no push time and are skipped - such services get no regression check at all. Detective, not preventive: it fires as the rollout starts, so it pairs with the deployment circuit breaker. Defaults to true; set to false to disable.",
      "Default": "true",
      "AllowedValues": [
        "true",
        "false"
      ]
    }
  },
