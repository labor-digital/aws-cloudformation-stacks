{
  "Parameters": {
    "KeypairName": {
      "Description": "Name of an EC2 KeyPair to enable SSH access to the instance. Add using EC2 -> Keypairs",
      "Type": "AWS::EC2::KeyPair::KeyName",
      "ConstraintDescription": "must be the name of an existing EC2 KeyPair."
    },
    "LogsBucketName": {
      "Description": "Name of the shared ALB access logs S3 bucket (alb-logs-bucket stack). Leave empty to disable access logging.",
      "Type": "String",
      "Default": ""
    },
    "RdsMasterUsername": {
      "Description": "MasterUsername which is applied to RDS cluster/instances.",
      "Type": "String",
      "MinLength": "4"
    },
    "RdsMasterPassword": {
      "Description": "MasterPassword which is applied to RDS cluster/instances.",
      "Type": "String",
      "MinLength": "32",
      "NoEcho": true
    },
    "HttpsdefaultlistenerCertificate": {
      "Description": "The certificate-arn which is used for the default listener of the loadbalancer. Add using Certificate Manage (4096-bit keys are not supported!)",
      "Type": "String",
      "MinLength": "1"
    },
    "AscalegroupMinSize": {
      "Type": "Number",
      "Description": "The min count of EC2-Instances (for Autoscaling). Set to 0 to let ECS Managed Scaling handle capacity — instances will only start when ECS tasks are deployed.",
      "Default": "0",
      "MinValue": "0",
      "MaxValue": "10"
    },
    "AscalegroupMaxSize": {
      "Type": "Number",
      "Description": "The max count of EC2-Instances (for Autoscaling).",
      "Default": "3",
      "MinValue": "1",
      "MaxValue": "30"
    },
    "AscalegroupDesSize": {
      "Type": "Number",
      "Description": "The desired count of EC2-Instances (for Autoscaling). Set to 0 initially — ECS Managed Scaling will scale up automatically when tasks are deployed.",
      "Default": "0",
      "MinValue": "0",
      "MaxValue": "15"
    },
    "EC2InstanceType": {
      "Description": "Instance type which you want to use for the EC2 machines in the cluster.",
      "Default": "t3.small",
      "Type": "String",
      "AllowedValues": [
        "t3.small",
        "t3.micro"
      ]
    },
    "RdsInstanceType": {
      "Description": "Instance type which you want to use for the RDS DB.",
      "Default": "db.t3.medium",
      "Type": "String",
      "AllowedValues": [
        "db.t3.medium"
      ]
    },
    "BackupCopyDestinationRegion": {
      "Type": "String",
      "Default": "eu-north-1",
      "Description": "Destination region for backup copy (leave empty to disable copy)"
    },
    "DnsFirewallWhitelistDomains": {
      "Type": "CommaDelimitedList",
      "Description": "Comma-separated list of domains to allow through the DNS Firewall (e.g. *.eu-west-3.amazonaws.com,*.ec2.internal,api.doppler.com). Note: wildcards (*) only match a single subdomain level — *.example.com matches foo.example.com but NOT foo.bar.example.com. List must not be empty and must not contain trailing commas.",
      "Default": "*.in-addr.arpa"
    },
    "EnableEgressAnalysis": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": ["true", "false"],
      "Description": "Enable ACCEPT-mode VPC Flow Logs for egress port baseline analysis. Temporary — disable after 7-14 days once sufficient data is collected for Security Group hardening (LII26-95)."
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.1.0.0/16",
        "EnableDnsSupport": true,
