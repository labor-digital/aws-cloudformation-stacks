{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "GuardDuty detector and incident-response infrastructure for zero-trust egress monitoring (LII26-96). ONE STACK PER REGION, NOT PER CLUSTER - and deliberately not part of the cluster template. GuardDuty allows exactly one detector per account and region, so a second cluster in the same region could not be created at all, and deleting any one cluster stack would switch off threat detection for every other cluster in that region. eu-central-1 already holds two clusters (labc-eu-c1 and labcluster-eu-c1-cl), so this is a live constraint, not a hypothetical one.",
  "Parameters": {
    "ClusterName": {
      "Type": "String",
      "Description": "Cluster name for tagging and reference (e.g. labc-eu-w3). Used to identify this detector's purpose; does not constrain deployment.",
      "MinLength": "4",
      "MaxLength": "32"
    },
    "ClusterStackName": {
      "Type": "String",
      "Description": "CloudFormation stack name of the ecscluster-vpc-rds-asg cluster (e.g. labc-eu-w3-cl). Used to import the VPC ID for the Quarantine Security Group.",
      "MinLength": "4"
    },
    "FindingPublishingFrequency": {
      "Type": "String",
      "Default": "FIFTEEN_MINUTES",
      "AllowedValues": [
        "FIFTEEN_MINUTES",
        "ONE_HOUR",
        "SIX_HOURS"
      ],
      "Description": "How often GuardDuty publishes findings. FIFTEEN_MINUTES = real-time alerts; SIX_HOURS = lower cost, suitable for batch incident response."
    }
  },
  "Resources": {
    "GuardDutyDetector": {
      "Type": "AWS::GuardDuty::Detector",
      "Metadata": {
        "Note": "The one-detector-per-account-per-region limit is why this resource cannot live in ecscluster-vpc-rds-asg: creating the second cluster in a region would fail, and deleting either cluster would disable detection for the other. Before deploying, check with 'aws guardduty list-detectors' - if one already exists, creation fails. S3Logs, Kubernetes audit logs and EBS malware protection are all disabled; CLOUD_TRAIL, DNS_LOGS and FLOW_LOGS are on by default and must be verified after deployment. Enabling EBS_MALWARE_PROTECTION and evaluating RUNTIME_MONITORING are open items in TASKS.md."
      },
      "Properties": {
        "Enable": true,
        "FindingPublishingFrequency": {
          "Ref": "FindingPublishingFrequency"
        },
        "DataSources": {
          "S3Logs": {
            "Enable": false
          },
          "Kubernetes": {
            "AuditLogs": {
              "Enable": false
            }
          },
          "MalwareProtection": {
            "ScanEc2InstanceWithFindings": {
              "EbsVolumes": false
            }
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${ClusterName}-GuardDutyDetector"
            }
          },
          {
            "Key": "Cluster",
            "Value": {
              "Ref": "ClusterName"
            }
          },
          {
            "Key": "Purpose",
            "Value": "LII26-96 Zero-Trust Egress Monitoring"
          }
        ]
      }
    },
    "QuarantineSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupName": {
          "Fn::Sub": "${ClusterName}-Quarantine"
        },
        "GroupDescription": "Quarantine security group: zero egress rules. Attached to compromised instances by GuardDuty incident response (Phase 3 Step D).",
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${ClusterStackName}-Vpc"
          }
        },
        "SecurityGroupEgress": [],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${ClusterName}-Quarantine"
            }
          },
          {
            "Key": "Purpose",
            "Value": "GuardDuty incident response / instance isolation"
          }
        ]
      }
    },
    "GuardDutyIncidentResponseRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "GuardDutyIncidentResponse",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeInstances",
                    "ec2:DescribeNetworkInterfaces",
                    "ec2:ModifyInstanceAttribute"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "guardduty:GetFindings",
                    "guardduty:GetFindingsStatistics"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ],
        "RoleName": {
          "Fn::Sub": "${ClusterName}-GuardDutyIncidentResponseRole"
        }
      }
    }
  },
  "Outputs": {
    "TemplateVersion": {
      "Description": "Version of the guardduty template this stack was last updated with. Bump on every template change (see README).",
      "Value": "1.0.0"
    },
    "DetectorId": {
      "Value": {
        "Ref": "GuardDutyDetector"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-DetectorId"
        }
      },
      "Description": "GuardDuty Detector ID for EventBridge rules and programmatic access"
    },
    "DetectorArn": {
      "Value": {
        "Fn::Sub": "arn:aws:guardduty:${AWS::Region}:${AWS::AccountId}:detector/${GuardDutyDetector}"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-DetectorArn"
        }
      },
      "Description": "GuardDuty Detector ARN"
    },
    "QuarantineSgId": {
      "Value": {
        "Ref": "QuarantineSg"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-QuarantineSgId"
        }
      },
      "Description": "Quarantine Security Group ID for Phase 3 Step D incident response"
    },
    "IncidentResponseRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "GuardDutyIncidentResponseRole",
          "Arn"
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-IncidentResponseRoleArn"
        }
      },
      "Description": "IAM role ARN for GuardDuty incident response Lambda (Phase 3 Step D)"
    }
  }
}
